FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/Hosts/Agro360.Api/Agro360.Api.csproj
RUN dotnet publish src/Hosts/Agro360.Api/Agro360.Api.csproj -c Release --no-restore -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble AS final
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system agro360 \
    && adduser --system --ingroup agro360 agro360
COPY --from=build /app/publish .
USER agro360
EXPOSE 8080
ENTRYPOINT ["dotnet", "Agro360.Api.dll"]
