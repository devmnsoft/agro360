{
  "Jwt": {
    "Issuer": "MNSOFT.Agro360",
    "Audience": "MNSOFT.Agro360.Clients",
    "SigningKey": "development-only-change-this-key-32-bytes-minimum",
    "AccessTokenMinutes": 20,
    "RefreshTokenDays": 14
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=123456;Pooling=true;Maximum Pool Size=50;Minimum Pool Size=0;Timeout=30;Command Timeout=60;Search Path=Agro360;Application Name=Agro360.api"
  },
  "Bootstrap": {
    "Enabled": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Storage": {
    "RootPath": "App_Data/documents",
    "MaxFileSizeBytes": 26214400
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8080",
      "https://localhost:7080",
      "http://127.0.0.1:8080",
      "https://127.0.0.1:7080"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Npgsql": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*"
}
