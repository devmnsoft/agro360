{
  "Jwt": {
    "Issuer": "MNSOFT.Agro360",
    "Audience": "MNSOFT.Agro360.Clients",
    "AccessTokenMinutes": 20,
    "RefreshTokenDays": 14
  },
  "Bootstrap": {
    "Enabled": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Storage": {
    "RootPath": "App_Data/documents",
    "MaxFileSizeBytes": 26214400
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8080",
      "https://localhost:7080",
      "http://127.0.0.1:8080",
      "https://127.0.0.1:7080"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Npgsql": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*"
}
