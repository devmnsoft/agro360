@page "/after-sales"
@model Agro360.Web.Pages.AfterSales.IndexModel
@{ ViewData["Title"] = "Pós-venda"; }
@section Styles { <link rel="stylesheet" href="~/css/after-sales.css" asp-append-version="true" /> }
<main class="after-sales" id="after-sales-app">
 <header class="case-heading"><div><span class="eyebrow">Atendimento após a entrega</span><h1>Pós-venda <span>operacional</span></h1><p>Trate ocorrências até a execução real da devolução, qualidade, reposição ou decisão comercial.</p></div><button class="primary-button" id="new-occurrence" type="button">Abrir ocorrência</button></header>
 <details class="screen-help contextual-help" open><summary>Como usar</summary><div><p><strong>Finalidade:</strong> concentrar o caso e tornar explícito o que ocorreu, o que falta e quem pode agir.</p><p><strong>Pré-requisitos:</strong> pedido e expedição existentes, usuário ativo, módulo contratado e permissão de pós-venda; item e lote são exigidos somente quando o caso envolve produto.</p><p><strong>Passos:</strong> localize o caso → confira origem e quantidades → registre evidências → proponha a solução → execute recebimento, inspeção, destinação ou ajuste no fluxo correspondente.</p><p><strong>Resultado esperado:</strong> caso resolvido somente depois de todas as ações obrigatórias concluídas. Aprovação comercial não representa pagamento.</p></div></details>
 <form class="case-filters" id="case-filters"><label>Busca<input name="search" type="search" maxlength="120" placeholder="Número, cliente ou descrição" /></label><label>Status<select name="status"><option value="">Todos</option><option value="OPEN">Aberta</option><option value="ANALYSIS">Em análise</option><option value="AWAITING_INFORMATION">Aguardando informação</option><option value="SOLUTION_PROPOSED">Solução proposta</option><option value="AWAITING_EXECUTION">Aguardando execução</option><option value="RESOLVED">Resolvida</option><option value="CANCELLED">Cancelada</option></select></label><label>Tipo<select name="type"><option value="">Todos</option><option value="SHORTAGE">Falta</option><option value="WRONG_PRODUCT">Produto incorreto</option><option value="DAMAGE">Avaria</option><option value="REFUSAL">Recusa</option><option value="QUALITY">Qualidade</option><option value="DELAY">Atraso</option><option value="NOT_DELIVERED">Não entregue</option><option value="OTHER">Outra</option></select></label><label>De<input name="from" type="date" /></label><label>Até<input name="to" type="date" /></label><button class="primary-button" type="submit">Aplicar filtros</button></form>
 <section class="case-panel" id="case-content" aria-live="polite"><p class="empty-state">Carregando casos…</p></section>
 <nav class="case-pages" aria-label="Paginação"><button type="button" id="case-prev">Anterior</button><span id="case-page">Página 1</span><button type="button" id="case-next">Próxima</button></nav>
 <dialog id="case-detail" aria-labelledby="case-title"><header><div><small>Caso de pós-venda</small><h2 id="case-title">Detalhes</h2></div><button type="button" data-close aria-label="Fechar detalhes">×</button></header><div id="case-detail-content"></div><footer><button type="button" data-close>Voltar à lista</button></footer></dialog>
 <div class="operation-alert" id="case-alert" role="alert" aria-live="assertive" hidden><p></p><button type="button">Fechar</button></div>
</main>
@section Scripts { <script src="~/js/after-sales.js" asp-append-version="true"></script> }
