@page "/agriculture"
@model Agro360.Web.Pages.Agriculture.IndexModel
@{ ViewData["Title"] = "Agricultura 360"; }
<section class="page-content agriculture-360">
 <header class="page-heading"><div><span class="eyebrow" data-i18n-ag="arc.eyebrow">Operações de campo</span><h1 data-i18n-ag="arc.h1">Agricultura <span>360</span></h1><p data-i18n-ag="arc.subtitle">Planeje, libere, execute e confira ordens com recursos, materiais e custos rastreáveis.</p></div></header>
 <details class="agriculture-help"><summary data-i18n-ag="arc.helpTitle">Como usar</summary><p><strong data-i18n-ag="arc.helpPrereqLbl">Pré-requisitos:</strong> <span data-i18n-ag="arc.helpPrereqBody">propriedade, talhão, pessoas, máquinas e produtos ativos. Crie a ordem, programe os recursos sem sobreposição, libere, aponte a execução e trate todo material entregue antes da conferência.</span></p><p><strong data-i18n-ag="arc.helpResultLbl">Resultado esperado:</strong> <span data-i18n-ag="arc.helpResultBody">ordem concluída com histórico, custódia de materiais zerada e composição de custo identificável. Aplicações especializadas continuam sujeitas às regras técnicas do módulo Aplicações.</span></p></details>
 <section class="panel season-tracking" aria-labelledby="season-tracking-title">
  <header class="panel-header"><div><span class="eyebrow" data-i18n-ag="arc.seasonEyebrow">Propriedade e safra</span><h2 id="season-tracking-title" data-i18n-ag="arc.seasonTitle">Acompanhamento operacional</h2><p data-i18n-ag="arc.seasonDesc">Consulte planejado, realizado e pendências na mesma data de referência.</p></div></header>
  <form id="season-context-form" class="season-context-filter"><label><span data-i18n-ag="arc.seasonLabel">Safra *</span><input id="season-context-search" autocomplete="off" data-i18n-ag-ph="arc.phSeasonName" placeholder="Busque pelo nome da safra" required /><input id="season-context-id" type="hidden" /></label><label><span data-i18n-ag="arc.referenceDate">Data de referência</span><input id="season-reference-date" type="date" /></label><button class="primary-button" data-i18n-ag="arc.trackSeason">Acompanhar safra</button><button type="button" id="clear-season-context" data-i18n-ag="arc.clearContext">Limpar contexto</button></form>
  <div id="season-context-results" class="lookup-results" hidden></div>
  <div id="season-overview" aria-live="polite" class="empty-row" data-i18n-ag="arc.seasonInitial">Selecione uma safra para visualizar dados reais. Valores sem origem permanecem indisponíveis.</div>
 </section>
 <nav class="livestock-modules" aria-label="Módulos agrícolas" data-i18n-ag-aria="arc.modulesAria" id="agriculture-tabs">
  <button data-module="field-notes"><strong data-i18n-ag="arc.mod.fieldNotes">Caderno de campo</strong><small data-i18n-ag="arc.mod.fieldNotesSub">atividades e insumos</small></button><button data-module="plans"><strong data-i18n-ag="arc.mod.plans">Planejamento</strong><small data-i18n-ag="arc.mod.plansSub">previsto × realizado</small></button><button data-module="scouting"><strong data-i18n-ag="arc.mod.scouting">Monitoramento</strong><small data-i18n-ag="arc.mod.scoutingSub">pragas e doenças</small></button><button data-module="recommendations"><strong data-i18n-ag="arc.mod.recs">Recomendações</strong><small data-i18n-ag="arc.mod.recsSub">orientação técnica</small></button><button data-module="applications"><strong data-i18n-ag="arc.mod.apps">Aplicações</strong><small data-i18n-ag="arc.mod.appsSub">estoque e custo</small></button><button data-module="irrigations"><strong data-i18n-ag="arc.mod.irrigation">Irrigação</strong><small data-i18n-ag="arc.mod.irrigationSub">lâmina e duração</small></button><button data-module="weather-records"><strong data-i18n-ag="arc.mod.weather">Clima</strong><small data-i18n-ag="arc.mod.weatherSub">risco operacional</small></button><button data-module="work-orders"><strong data-i18n-ag="arc.mod.workOrders">Ordens de serviço</strong><small data-i18n-ag="arc.mod.workOrdersSub">equipe e checklist</small></button>
 </nav>
 <section class="panel" aria-labelledby="form-title"><header class="panel-header"><div><span class="eyebrow" data-i18n-ag="arc.newRecordEyebrow">Novo registro</span><h2 id="form-title" data-i18n-ag="arc.formTitleDefault">Ordem de serviço</h2></div></header>
  <div id="form-summary" class="validation-summary" role="alert" hidden></div>
  <form id="agriculture-form" novalidate>
   <input type="hidden" name="module" value="work-orders" />
   <div class="agriculture-form-grid">
    <label><span data-i18n-ag="arc.lProperty">Propriedade </span><input class="lookup" data-lookup="properties" data-target="propertyId" autocomplete="off" required minlength="2" data-i18n-ag-ph="arc.phFarmName" placeholder="Busque pelo nome da fazenda" /><input type="hidden" name="propertyId" /></label>
    <label><span data-i18n-ag="arc.lPlot">Talhão </span><input class="lookup" data-lookup="fields" data-target="fieldId" autocomplete="off" required minlength="2" data-i18n-ag-ph="arc.phPlot" placeholder="Busque pelo nome e safra" /><input type="hidden" name="fieldId" /></label>
    <label><span data-i18n-ag="arc.lSeason">Safra </span><input class="lookup" data-lookup="crop-seasons" data-target="cropSeasonId" autocomplete="off" data-i18n-ag-ph="arc.phSeason" placeholder="Busque pela safra" /><input type="hidden" name="cropSeasonId" /></label>
    <label><span data-i18n-ag="arc.lCrop">Cultura </span><input class="lookup" data-lookup="crops" data-target="cropId" autocomplete="off" data-i18n-ag-ph="arc.phCrop" placeholder="Busque pela cultura" /><input type="hidden" name="cropId" /></label>
    <label><span data-i18n-ag="arc.lResponsible">Responsável </span><input class="lookup" data-lookup="people" data-target="responsibleId" autocomplete="off" data-i18n-ag-ph="arc.phPerson" placeholder="Busque pelo nome ou e-mail" /><input type="hidden" name="responsibleId" /></label>
    <label><span data-i18n-ag="arc.lMachine">Máquina </span><input class="lookup" data-lookup="machines" data-target="machineId" autocomplete="off" data-i18n-ag-ph="arc.phMachine" placeholder="Busque por nome ou identificação" /><input type="hidden" name="machineId" /></label>
    <label><span data-i18n-ag="arc.lName">Objetivo da ordem *</span><input name="name" required minlength="3" maxlength="160" /></label>
    <label><span data-i18n-ag="arc.lType">Tipo de operação *</span><select name="type" required><option value="" data-i18n-ag="ag.select">Selecione</option><option data-i18n-ag="arc.op.soil">Preparo de solo</option><option data-i18n-ag="arc.op.planting">Plantio</option><option data-i18n-ag="arc.op.fertilizing">Adubação</option><option data-i18n-ag="arc.op.irrigation">Irrigação</option><option data-i18n-ag="arc.op.inspection">Inspeção</option><option data-i18n-ag="arc.op.areaMaintenance">Manutenção de área</option><option data-i18n-ag="arc.op.harvest">Colheita</option><option data-i18n-ag="arc.op.internalTransport">Transporte interno</option><option data-i18n-ag="arc.op.other">Outra operação</option></select></label>
    <label><span data-i18n-ag="arc.lPlannedStart">Início previsto *</span><input name="plannedAt" type="datetime-local" required /></label><label><span data-i18n-ag="arc.lPlannedEnd">Término previsto *</span><input name="finishedAt" type="datetime-local" required /></label>
    <label><span data-i18n-ag="arc.lArea">Quantidade/área planejada *</span><input name="area" type="number" min="0.0001" step="0.0001" required /></label><label><span data-i18n-ag="arc.lUnit">Unidade *</span><select name="unit" required><option value="ha" data-i18n-ag="arc.unit.ha">hectare (ha)</option><option value="h" data-i18n-ag="arc.unit.h">hora (h)</option><option value="t" data-i18n-ag="arc.unit.t">tonelada (t)</option><option value="un" data-i18n-ag="arc.unit.un">unidade (un)</option></select></label>
    <label><span data-i18n-ag="arc.lPriority">Prioridade *</span><select name="priority" required><option>NORMAL</option><option>ALTA</option><option>URGENTE</option><option>BAIXA</option></select></label><label><span data-i18n-ag="arc.lOrigin">Origem da demanda</span><input name="origin" maxlength="120" data-i18n-ag-ph="arc.phOrigin" placeholder="Plano de safra, inspeção, solicitação…" /></label>
    <label><span data-i18n-ag="arc.lMaterial">Material previsto </span><input class="lookup" data-lookup="inventory-items" data-target="inventoryItemId" autocomplete="off" data-i18n-ag-ph="arc.phProduct" placeholder="Busque pelo produto" /><input type="hidden" name="inventoryItemId" /></label><label><span data-i18n-ag="arc.lWarehouse">Depósito </span><input class="lookup" data-lookup="warehouses" data-target="warehouseId" autocomplete="off" data-i18n-ag-ph="arc.phWarehouse" placeholder="Busque pelo depósito" /><input type="hidden" name="warehouseId" /></label>
    <label><span data-i18n-ag="arc.lMaterialQty">Quantidade do material</span><input name="quantity" type="number" min="0.000001" step="0.000001" /></label><label><span data-i18n-ag="arc.lUnitCost">Custo unitário estimado</span><input name="estimatedCost" type="number" min="0" step="0.01" /></label>
    <label><span data-i18n-ag="arc.lStatus">Status</span><select name="status" required><option value="OPEN" data-i18n-ag="arc.status.draft">Rascunho</option><option value="PLANNED" data-i18n-ag="arc.status.planned">Planejada</option><option value="AWAITING_RESOURCES" data-i18n-ag="arc.status.awaitingResources">Aguardando recursos</option></select></label>
    <label class="form-wide"><span data-i18n-ag="arc.lNotes">Observações</span><textarea name="notes" maxlength="2000"></textarea></label>
   </div><button class="primary-button" type="submit"><span data-i18n-ag="arc.saveRecord">Salvar registro</span></button><p id="form-result" role="status"></p>
  </form>
 </section>
 <section class="panel"><header class="panel-header"><h2 data-i18n-ag="arc.recentTitle">Ordens e registros recentes</h2></header><div id="agriculture-list" class="empty-row">Carregando registros...</div></section>
 <section class="panel" id="field-order-detail" hidden aria-live="polite"><header class="panel-header"><h2 data-i18n-ag="arc.detailTitle">Detalhes da ordem</h2></header><div data-order-detail></div></section>
</section>
<script src="~/js/agriculture360.js" asp-append-version="true"></script>
@section Styles { <link rel="stylesheet" href="~/css/agriculture-tracking.css" asp-append-version="true" /> }
