@page
@model Agro360.Web.Pages.Commercial.IndexModel
@{ViewData["Title"]="CRM & Comercial";}
<link rel="stylesheet" href="~/css/commercial.css" asp-append-version="true" />
<section class="commercial-shell">
 <header class="commercial-hero"><div><span class="eyebrow">Comercial Agro 360</span><h1>CRM Rural & Vendas B2B</h1><p>Relacionamentos, pipeline, pedidos, contratos, entregas e receita prevista em um fluxo auditável.</p></div><button class="primary" id="create-commercial" type="button">+ Novo cliente</button></header>
 <details class="screen-guide"><summary>Como usar esta tela</summary><div><p><strong>Para que serve:</strong> acompanhar clientes e o ciclo comercial real do tenant.</p><p><strong>Quando usar:</strong> da prospecção ao pedido e acompanhamento financeiro.</p><p><strong>Campos principais:</strong> cliente, produto, quantidade, preço, condição de pagamento, data prevista, status, responsável, representante e comissão.</p><p><strong>Ações:</strong> filtre e consulte registros ou cadastre um cliente. Bloqueios, aprovações e cancelamentos são validados pela API e auditados.</p><p><strong>Próximo passo:</strong> registre uma oportunidade, avance o pipeline e gere o pedido após a negociação.</p></div></details>
 <div class="metric-grid" id="commercial-metrics" aria-live="polite"><article><small>Clientes ativos</small><strong>—</strong></article><article><small>Pipeline</small><strong>—</strong></article><article><small>Receita prevista</small><strong>—</strong></article><article><small>Comissões previstas</small><strong>—</strong></article></div>
 <nav class="commercial-tabs" aria-label="Áreas comerciais">
 @foreach(var tab in new[]{("dashboard","Dashboard Comercial"),("customers","Clientes / Compradores"),("prospects","Prospects"),("contacts","Contatos"),("representatives","Representantes"),("opportunities","Pipeline Comercial"),("activities","Atividades"),("price-tables","Tabelas de preço"),("orders","Pedidos de Venda"),("contracts","Contratos de Venda"),("commissions","Comissões"),("splits","Split interno"),("targets","Metas")}){<button type="button" data-resource="@tab.Item1">@tab.Item2</button>}
 </nav>
 <section class="commercial-panel"><div class="panel-toolbar"><label class="search-field">Buscar<input id="commercial-search" type="search" maxlength="120" placeholder="Nome, número ou responsável" /></label><label>Status<select id="commercial-status"><option value="">Todos</option><option>ACTIVE</option><option>DRAFT</option><option>APPROVED</option><option>BLOCKED</option><option>CANCELLED</option></select></label></div><div id="commercial-content" class="commercial-content"><p class="empty-state">Carregando dados reais…</p></div><div class="pagination"><button id="previous-page" type="button">Anterior</button><span id="page-label">Página 1</span><button id="next-page" type="button">Próxima</button></div></section>
</section>
<div id="commercial-toast" class="commercial-toast" role="status" aria-live="polite" hidden></div>
<dialog id="commercial-dialog"><form id="commercial-form"><header><h2>Novo cliente</h2><button value="cancel" formmethod="dialog" aria-label="Fechar">×</button></header><input type="hidden" name="type" value="CUSTOMER" /><label>Nome / razão social<input name="name" required minlength="2" maxlength="180" /></label><label>Segmento<select name="segmentId" required data-lookup="segments"><option value="">Selecione…</option></select></label><label>Representante responsável <span class="help" title="Vendedor ativo responsável pela carteira.">?</span><select name="representativeId" data-lookup="representatives"><option value="">Sem responsável</option></select></label><div class="form-row"><label>CPF/CNPJ <span class="help" title="Informe somente dígitos; os verificadores são validados no servidor.">?</span><input name="taxDocument" inputmode="numeric" pattern="[0-9]{11}|[0-9]{14}" /></label><label>E-mail<input name="email" type="email" maxlength="254" /></label></div><label>Telefone<input name="phone" type="tel" minlength="8" maxlength="40" /></label><label>Observações<textarea name="notes" maxlength="2000"></textarea></label><p class="form-error" role="alert"></p><footer><button type="button" data-close>Cancelar</button><button class="primary" type="submit">Salvar cliente</button></footer></form></dialog>
<script src="~/js/commercial.js" asp-append-version="true"></script>
