@page
@model Agro360.Web.Pages.Commercial.IndexModel
@{ViewData["Title"]="CRM & Comercial";}
<link rel="stylesheet" href="~/css/commercial.css" asp-append-version="true" />
<section class="commercial-shell">
 <header class="commercial-hero"><div><span class="eyebrow">Sprint 22 · operação comercial</span><h1>CRM Agro & Vendas B2B</h1><p>Relacionamentos, funil, pedidos, contratos e distribuição de receitas em um fluxo auditável.</p></div><button class="primary" id="create-commercial" type="button">+ Novo registro</button></header>
 <div class="metric-grid" id="commercial-metrics" aria-live="polite"><article><small>Clientes ativos</small><strong>—</strong></article><article><small>Pipeline</small><strong>—</strong></article><article><small>Receita prevista</small><strong>—</strong></article><article><small>Comissões previstas</small><strong>—</strong></article></div>
 <nav class="commercial-tabs" aria-label="Áreas comerciais">
 @foreach(var tab in new[]{("dashboard","Dashboard"),("customers","Clientes"),("prospects","Prospects"),("contacts","Contatos"),("representatives","Representantes"),("opportunities","Funil"),("activities","Atividades"),("price-tables","Tabelas de preço"),("orders","Pedidos"),("contracts","Contratos"),("commissions","Comissões"),("splits","Split interno"),("targets","Metas")}){<button type="button" data-resource="@tab.Item1">@tab.Item2</button>}
 </nav>
 <section class="commercial-panel"><div class="panel-toolbar"><label class="search-field">Buscar<input id="commercial-search" type="search" maxlength="120" placeholder="Nome, número ou responsável" /></label><label>Status<select id="commercial-status"><option value="">Todos</option><option>ACTIVE</option><option>DRAFT</option><option>APPROVED</option><option>BLOCKED</option><option>CANCELLED</option></select></label></div><div id="commercial-content" class="commercial-content"><p class="empty-state">Carregando dados reais…</p></div><div class="pagination"><button id="previous-page" type="button">Anterior</button><span id="page-label">Página 1</span><button id="next-page" type="button">Próxima</button></div></section>
</section>
<dialog id="commercial-dialog"><form id="commercial-form"><header><h2>Novo cliente</h2><button value="cancel" formmethod="dialog" aria-label="Fechar">×</button></header><input type="hidden" name="type" value="CUSTOMER" /><label>Nome / razão social<input name="name" required minlength="2" maxlength="180" /></label><label>Segmento<select name="segmentId" required data-lookup="segments"><option value="">Selecione…</option></select></label><label>Representante responsável<select name="representativeId" data-lookup="representatives"><option value="">Sem responsável</option></select></label><div class="form-row"><label>CPF/CNPJ<input name="taxDocument" inputmode="numeric" pattern="[0-9]{11,14}" /></label><label>E-mail<input name="email" type="email" maxlength="254" /></label></div><label>Telefone<input name="phone" type="tel" minlength="8" maxlength="40" /></label><label>Observações<textarea name="notes" maxlength="2000"></textarea></label><p class="form-error" role="alert"></p><footer><button type="button" data-close>Cancelar</button><button class="primary" type="submit">Salvar cliente</button></footer></form></dialog>
<script src="~/js/commercial.js" asp-append-version="true"></script>
