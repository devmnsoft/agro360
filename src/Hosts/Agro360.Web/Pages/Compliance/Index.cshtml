@page "/compliance"
@model Agro360.Web.Pages.Compliance.IndexModel
@{ViewData["Title"]="Qualidade e Compliance";}
<link rel="stylesheet" href="~/css/compliance.css" asp-append-version="true" />
<section class="compliance-page">
 <header><div><span class="eyebrow">Central operacional</span><h1>Qualidade &amp; Compliance</h1><p>Identifique problemas, controle o impacto, execute ações e verifique a eficácia sem perder a rastreabilidade.</p></div><button class="primary-button" id="compliance-new" type="button">Novo registro</button></header>
 <details class="compliance-help"><summary>Como usar</summary><div><strong>Pré-requisitos:</strong> unidade autorizada, origem existente e responsável ativo. <strong>Etapas:</strong> registre o problema, avalie a contenção, analise a causa, conclua as ações e faça a verificação. <strong>Resultado esperado:</strong> decisão auditável; encerrar o caso não libera restrições operacionais automaticamente.</div></details>
 <nav class="compliance-tabs" aria-label="Áreas de compliance"><button class="active" data-view="dashboard">Visão geral</button><button data-view="documents">Documentos</button><button data-view="product-rules">Regras por produto</button><button data-view="certifications">Certificações</button><button data-view="audits">Auditorias</button><button data-view="non-conformities">Não conformidades</button><button data-view="pending-verifications">Verificações pendentes</button><button data-view="indicators">ESG</button><button data-view="carbon">Carbono</button><button data-view="export-dossiers">Exportação</button></nav>
 <div class="compliance-toolbar" aria-label="Filtros da central"><label>Pesquisar <input id="compliance-filter" type="search" autocomplete="off" placeholder="Título, produto, lote ou responsável" /></label><label>Período inicial <input id="quality-from" type="date" /></label><label>Período final <input id="quality-to" type="date" /></label><label>Status <select id="quality-status"><option value="">Todos</option><option value="OPEN">Aberta</option><option value="ANALYSIS">Em análise</option><option value="IN_TREATMENT">Em tratamento</option><option value="AWAITING_VERIFICATION">Aguardando verificação</option><option value="CLOSED">Encerrada</option><option value="CANCELLED">Cancelada</option></select></label><label>Severidade <select id="quality-severity"><option value="">Todas</option><option value="LOW">Baixa</option><option value="MEDIUM">Média</option><option value="HIGH">Alta</option><option value="CRITICAL">Crítica</option></select></label><button id="compliance-refresh" type="button">Atualizar</button></div>
 <div id="compliance-status" role="status">Carregando dados…</div><main id="compliance-content" aria-live="polite"></main>
</section>
<dialog id="compliance-dialog"><form id="compliance-form"><h2 id="compliance-form-title">Novo registro</h2><div id="compliance-fields"></div><p class="form-message" role="alert"></p><footer><button type="button" data-close>Cancelar</button><button class="primary-button" type="submit">Salvar</button></footer></form></dialog>
<dialog id="quality-detail-dialog" class="quality-detail"><div><button type="button" class="dialog-close" data-detail-close aria-label="Fechar detalhes">×</button><div id="quality-detail-content"></div></div></dialog>
@section Scripts{<script src="~/js/compliance.js" asp-append-version="true" defer></script>}
