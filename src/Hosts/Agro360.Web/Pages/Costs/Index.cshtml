@page
@model Agro360.Web.Pages.Costs.IndexModel
@{ ViewData["Title"]="Custos da Safra"; }
@section Head { <link rel="stylesheet" href="~/css/costs.css" asp-append-version="true" /> }
<main class="costs-shell">
 <header class="costs-hero"><div><span class="eyebrow" data-i18n-ag="cs.eyebrow">Financeiro e Resultados</span><h1 data-i18n-ag="cs.title">Custos da Safra</h1><p data-i18n-ag="cs.subtitle">Reconheça a origem, resolva pendências e confira a apropriação sem confundir custo, compromisso e pagamento.</p></div><button class="primary-button" id="cost-refresh" data-i18n-ag="cs.refresh">Atualizar</button></header>
 <details class="cost-help" open><summary data-i18n-ag="cs.helpTitle">Como usar</summary><div><p><strong data-i18n-ag="cs.help.purposeLbl">Para que serve:</strong><span data-i18n-ag="cs.help.purpose"> apurar custos gerenciais rastreáveis por safra.</span></p><p><strong data-i18n-ag="cs.help.dataLbl">Dados necessários:</strong><span data-i18n-ag="cs.help.data"> lançamento reconhecido, propriedade, safra e uma base real de distribuição.</span></p><p><strong data-i18n-ag="cs.help.seqLbl">Sequência:</strong><span data-i18n-ag="cs.help.seq"> filtre, abra uma pendência, escolha o método, confira a prévia e confirme.</span></p><p><strong data-i18n-ag="cs.help.effectLbl">Efeito:</strong><span data-i18n-ag="cs.help.effect"> confirmar reduz o saldo apropriável em transação auditada. A prévia não altera dados.</span></p><p><strong data-i18n-ag="cs.help.fixLbl">Correção:</strong><span data-i18n-ag="cs.help.fix"> uma confirmação não é editada; estorne com motivo e faça nova apropriação.</span></p></div></details>
 <nav class="cost-tabs" aria-label="Jornada de custos" data-i18n-ag-aria="cs.tabsAria"><button data-view="overview" class="active" data-i18n-ag="cs.tab.overview">Visão geral</button><button data-view="entries" data-i18n-ag="cs.tab.entries">Lançamentos</button><button data-view="manual" data-i18n-ag="cs.tab.manual">Novo lançamento</button><button data-view="pending" data-i18n-ag="cs.tab.pending">Pendências</button><button data-view="allocate" data-i18n-ag="cs.tab.allocate">Apropriar / Ratear</button><button data-view="history" data-i18n-ag="cs.tab.history">Histórico</button><button data-view="closing" data-i18n-ag="cs.tab.closing">Conferência</button></nav>
 <section class="cost-filters"><label><span data-i18n-ag="cs.filterSeason">Safra</span><select id="cost-season"><option value="" data-i18n-ag="cs.all">Todas</option></select></label><label><span data-i18n-ag="cs.filterProperty">Propriedade</span><select id="cost-farm"><option value="" data-i18n-ag="cs.all">Todas</option></select></label><label><span data-i18n-ag="cs.from">De</span><input type="date" id="cost-from"></label><label><span data-i18n-ag="cs.to">Até</span><input type="date" id="cost-to"></label><label><span data-i18n-ag="cs.search">Busca</span><input type="search" id="cost-search" data-i18n-ag-ph="cs.phSearch" placeholder="Documento, origem ou descrição"></label><button id="cost-export" data-i18n-ag="cs.exportCsv">Exportar CSV</button></section>
 <section id="cost-overview" class="cost-view"><div class="cost-cards" id="cost-cards"></div><div class="cost-grid"><article><h2 data-i18n-ag="cs.byCategory">Por categoria</h2><div id="cost-categories"></div></article><article><h2 data-i18n-ag="cs.byCompetence">Evolução por competência</h2><div id="cost-evolution"></div></article></div><p class="managerial-note" data-i18n-ag="cs.managerialNote">Apuração gerencial, não demonstração contábil oficial. Previsto, comprometido, reconhecido, pago e apropriado são apresentados separadamente.</p></section>
 <section id="cost-entries" class="cost-view" hidden><header><h2 data-i18n-ag="cs.entriesTitle">Lançamentos e origens</h2><p data-i18n-ag="cs.entriesDesc">O saldo é o custo reconhecido menos o apropriado; pagamento não altera esta fórmula.</p></header><div id="cost-table"></div><footer class="pager"><button id="cost-prev" data-i18n-ag="cs.previous">Anterior</button><span id="cost-page" data-i18n-ag="cs.pageOne">Página 1</span><button id="cost-next" data-i18n-ag="cs.next">Próxima</button></footer></section>
 <section id="cost-manual" class="cost-view" hidden><header><h2 data-i18n-ag="cs.manualTitle">Novo custo reconhecido manualmente</h2><p data-i18n-ag="cs.manualDesc"><strong>Como usar:</strong> identifique a despesa e sua origem, confira os valores e registre. O lançamento cria saldo para apropriação; não cria conta paga.</p></header><form id="manual-cost-form" class="manual-cost-form"><fieldset><legend data-i18n-ag="cs.identification">Identificação</legend><label><span data-i18n-ag="cs.descriptionLabel">Descrição *</span><input id="manual-description" maxlength="240" required><small data-i18n-ag="cs.descHint">Explique o custo em linguagem operacional.</small></label><label><span data-i18n-ag="cs.categoryLabel">Categoria *</span><select id="manual-category" required><option value="" data-i18n-ag="ag.select">Selecione</option><option>INSUMOS</option><option>MAO_DE_OBRA</option><option>MAQUINAS</option><option>SERVICOS</option><option>OUTROS</option></select></label><label><span data-i18n-ag="cs.propertyLabel">Propriedade / unidade *</span><select id="manual-farm" required><option value="" data-i18n-ag="cs.phByName">Selecione pelo nome</option></select></label><label><span data-i18n-ag="cs.originDocument">Origem ou documento</span><input id="manual-document" maxlength="1000" data-i18n-ag-ph="cs.phOriginDoc" placeholder="Nota, ordem ou referência externa"><small data-i18n-ag="cs.originDocHint">Não repita documentos já importados por integrações.</small></label></fieldset><fieldset><legend data-i18n-ag="cs.values">Valores</legend><label><span data-i18n-ag="cs.competence">Competência *</span><input id="manual-competence" type="date" required></label><label><span data-i18n-ag="cs.amountLabel">Valor reconhecido (BRL) *</span><input id="manual-amount" type="number" min="0.0001" step="0.0001" required></label><label><span data-i18n-ag="cs.currency">Moeda</span><input value="BRL" readonly aria-readonly="true"></label></fieldset><fieldset><legend data-i18n-ag="cs.reviewLegend">Revisão</legend><label><span data-i18n-ag="cs.justification">Justificativa *</span><textarea id="manual-reason" maxlength="1000" required></textarea><small data-i18n-ag="cs.justificationHint">Obrigatória para auditoria. Ajustes e estornos usam operações próprias.</small></label><p class="managerial-note" data-i18n-ag="cs.manualEffect">Efeito: será criado um custo reconhecido, aberto e integralmente pendente. Nenhum pagamento será registrado.</p><button class="primary-button" type="submit" data-i18n-ag="cs.registerManual">Registrar custo reconhecido</button><p id="manual-error" class="field-error" role="alert"></p></fieldset></form></section>
 <section id="cost-allocate" class="cost-view" hidden>
  <ol class="steps"><li class="active" data-i18n-ag="cs.step1">1. Lançamento e saldo</li><li data-i18n-ag="cs.step2">2. Método</li><li data-i18n-ag="cs.step3">3. Destinos</li><li data-i18n-ag="cs.step4">4. Conferir</li><li data-i18n-ag="cs.step5">5. Confirmar</li></ol>
  <div class="allocation-layout"><form id="allocation-form"><label><span data-i18n-ag="cs.pendingEntry">Lançamento pendente</span><select id="allocation-entry" required><option value="" data-i18n-ag="cs.phByOrigin">Selecione pela origem</option></select><small data-i18n-ag="cs.entryHint">Exibe documento e saldo, nunca um ID técnico.</small></label><div class="balance-summary" id="allocation-balance" data-i18n-ag="cs.pickEntry">Selecione um lançamento.</div><label><span data-i18n-ag="cs.amountToAllocate">Valor a distribuir (BRL)</span><input id="allocation-amount" type="number" min="0.0001" step="0.0001" required></label><label><span data-i18n-ag="cs.method">Método</span><select id="allocation-method" required><option value="" data-i18n-ag="cs.phMethodExplicit">Escolha explicitamente</option><option value="DIRECT" data-i18n-ag="cs.method.direct">Apropriação direta</option><option value="PERCENTAGE" data-i18n-ag="cs.method.percentage">Percentuais informados</option><option value="AREA" data-i18n-ag="cs.method.area">Área elegível (ha)</option><option value="PRODUCTION" data-i18n-ag="cs.method.production">Quantidade produzida</option><option value="HOURS" data-i18n-ag="cs.method.hours">Horas registradas</option><option value="EQUAL" data-i18n-ag="cs.method.equal">Divisão igualitária</option></select></label><fieldset><legend data-i18n-ag="cs.destinationsLegend">Destinos elegíveis</legend><div id="allocation-destinations"></div></fieldset><label><span data-i18n-ag="cs.allocationReason">Justificativa</span><textarea id="allocation-justification" maxlength="1000" data-i18n-ag-ph="cs.phJustification" placeholder="Obrigatória para explicar a classificação"></textarea></label><div class="form-actions"><button type="submit" class="primary-button" data-i18n-ag="cs.calculatePreview">Calcular prévia</button><button type="button" id="allocation-confirm" disabled data-i18n-ag="cs.confirmAllocation">Confirmar apropriação</button></div><p id="allocation-error" class="field-error" role="alert"></p></form><aside class="allocation-preview" id="allocation-preview"><h2 data-i18n-ag="cs.financialSummary">Resumo financeiro</h2><p data-i18n-ag="cs.previewHint">A prévia mostrará bases, percentuais, valores e ajustes de arredondamento.</p></aside></div>
 </section>
 <section id="cost-history" class="cost-view" hidden><h2 data-i18n-ag="cs.historyTitle">Histórico de apropriações e estornos</h2><div id="cost-history-table"></div></section>
 <section id="cost-closing" class="cost-view" hidden><h2 data-i18n-ag="cs.closingTitle">Conferência gerencial da safra</h2><p data-i18n-ag="cs.closingDesc">Escolha uma safra e uma data de corte. Custos posteriores exigem nova apuração ou reabertura autorizada; pagamento pendente não bloqueia o fechamento operacional.</p><label><span data-i18n-ag="cs.cutoffLabel">Data de corte</span><input type="date" id="closing-cutoff"></label><button id="closing-review" data-i18n-ag="cs.closeCheck">Conferir</button><div id="closing-result"></div></section>
 <div id="cost-status" role="status" aria-live="polite"></div>
</main>
@section Scripts { <script src="~/js/costs.js" asp-append-version="true" defer></script> }
