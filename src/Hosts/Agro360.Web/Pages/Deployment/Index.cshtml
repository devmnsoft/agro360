@page
@model Agro360.Web.Pages.Deployment.IndexModel
@{ ViewData["Title"]="Implantação"; }
<link rel="stylesheet" href="~/css/deployment.css" />
<main class="deployment" data-api="/api/deployment">
 <header><div><span class="eyebrow">Sprint 21</span><h1>Implantação Agro360</h1><p>Configure a operação sem informar códigos técnicos.</p></div><button type="button" id="refresh">Atualizar painel</button></header>
 <div id="message" role="status" aria-live="polite"></div>
 <section class="metrics" aria-label="Indicadores"><article><strong id="implemented">—</strong><span>implantadas</span></article><article><strong id="pending">—</strong><span>pendentes</span></article><article><strong id="average">—</strong><span>progresso médio</span></article><article><strong id="errors">—</strong><span>erros de importação</span></article></section>
 <nav class="tabs" aria-label="Etapas"><button data-panel="onboarding" class="active">Onboarding</button><button data-panel="checklist">Checklist</button><button data-panel="imports">Importar CSV</button></nav>
 <section id="onboarding" class="panel active"><h2>Nova organização</h2><form id="onboarding-form"><div class="grid"><label>Organização<input name="organizationName" required minlength="3"></label><label>Endereço amigável<input name="slug" required pattern="[a-z0-9-]{3,80}"></label><label>Segmento<select name="segment" required><option value="">Selecione</option><option value="GRAINS">Agricultura / grãos</option><option value="LIVESTOCK">Pecuária</option><option value="COOPERATIVE">Cooperativa</option><option value="AGROINDUSTRY">Agroindústria</option><option value="AMAZON">Amazônia / rastreabilidade</option><option value="LOGISTICS">Logística agro</option><option value="MIXED">Operação mista</option></select></label><label>Template<select name="templateCode" id="templates" required><option value="">Carregando…</option></select></label><label>Propriedade / unidade<input name="propertyName" required></label><label>Safra / ciclo inicial<input name="initialCycle" required></label><label>Administrador<input name="administratorName" required></label><label>E-mail administrativo<input name="administratorEmail" type="email" required></label></div><fieldset><legend>Módulos ativos</legend><label><input type="checkbox" name="modules" value="agriculture" checked> Agricultura</label><label><input type="checkbox" name="modules" value="inventory"> Estoque</label><label><input type="checkbox" name="modules" value="finance"> Financeiro</label><label><input type="checkbox" name="modules" value="traceability"> Rastreabilidade</label></fieldset><label>Centros de custo (separados por vírgula)<input name="costCenters" required value="Produção, Administrativo"></label><label>Produtos / atividades iniciais<input name="products" required placeholder="Soja, Milho"></label><div class="checks"><label><input type="checkbox" name="configureInitialStock"> Configurar estoque inicial</label><label><input type="checkbox" name="configureInitialFinance"> Configurar financeiro inicial</label></div><button type="submit">Concluir onboarding</button></form></section>
 <section id="checklist" class="panel"><h2>Checklist da organização</h2><div class="progress"><span id="progress-bar"></span></div><strong id="progress-label">0%</strong><div id="checklist-items" class="list"><p>Carregando…</p></div></section>
 <section id="imports" class="panel"><h2>Importação inicial</h2><form id="import-form"><label>Tipo<select name="type" required><option value="PRODUCERS">Produtores</option><option value="PROPERTIES">Propriedades</option><option value="FIELDS">Talhões</option><option value="PRODUCTS">Produtos / culturas</option><option value="SUPPLIERS">Fornecedores</option><option value="INPUTS">Insumos</option><option value="STOCK">Estoque inicial</option><option value="CUSTOMERS">Clientes</option><option value="LIVESTOCK">Animais / lotes</option><option value="MEMBERS">Cooperados</option></select></label><label>Arquivo CSV<input type="file" name="file" accept=".csv,text/csv" required></label><label>Coluna que contém o nome<input name="nameColumn" value="nome" required></label><button type="submit">Validar e pré-visualizar</button></form><div id="preview"></div><h3>Histórico</h3><div id="history"></div></section>
</main>
<script src="~/js/deployment.js" asp-append-version="true"></script>
