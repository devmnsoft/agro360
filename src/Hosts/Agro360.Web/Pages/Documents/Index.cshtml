@page
@model Agro360.Web.Pages.Documents.IndexModel
@{ViewData["Title"]="Documentos e Evidências";}
@section Head { <link rel="stylesheet" href="~/css/documents.css" asp-append-version="true" /> }
<section class="documents-page">
 <header><div><span class="eyebrow">Sprint 23 · rastreabilidade documental</span><h1>Documentos e Evidências</h1><p>Arquivos operacionais, validações, dossiês e certificados verificáveis em um único fluxo.</p></div><button class="primary-button" id="new-document" type="button">＋ Novo upload</button></header>
 <details class="help-accordion">
  <summary><strong>Como usar: Repositório, Rastreabilidade e Dossiês</strong></summary>
  <div class="help-body">
   <p>• <strong>Upload inicial:</strong> Envie arquivos operacionais (PDF, imagens, planilhas, laudos) com hash SHA-256 e vínculos canônicos a talhões, safras, lotes ou fornecedores.</p>
   <p>• <strong>Detalhe e Histórico:</strong> Clique em <em>Detalhes</em> em qualquer documento para consultar metadados, links de rastreabilidade e histórico completo de versões imutáveis.</p>
   <p>• <strong>Nova versão:</strong> Atualize documentos mantendo a trilha de auditoria; informe obrigatoriamente a justificativa/motivo da alteração.</p>
   <p>• <strong>Download e Arquivamento:</strong> Downloads utilizam canais protegidos e verificados por RLS; o arquivamento encerra a disponibilidade operacional sem expurgar o histórico.</p>
  </div>
 </details>
 <nav class="document-tabs" aria-label="Áreas documentais"><button class="active" data-view="dashboard">Dashboard</button><button data-view="documents">Documentos</button><button data-view="evidences">Evidências</button><button data-view="dossiers">Dossiês</button><button data-view="certificates">Certificados</button><button data-view="public">Consulta pública</button></nav>
 <section id="document-metrics" class="document-metrics" aria-live="polite"></section>
 <section class="document-toolbar">
  <input id="document-search" type="search" maxlength="120" placeholder="Buscar por nome, descrição ou tag" />
  <select id="document-type-filter" aria-label="Filtrar por tipo documental"><option value="">Todos os tipos</option></select>
  <select id="document-status" aria-label="Filtrar por status"><option value="">Todos os status</option><option>ACTIVE</option><option>ARCHIVED</option><option>PENDING</option><option>VALIDATED</option><option>REJECTED</option></select>
  <button id="export-csv" type="button">Exportar CSV</button>
 </section>
 <section id="document-content" class="document-content" aria-live="polite"><p class="empty-state">Carregando…</p></section>
 <div id="document-pagination" class="document-pagination" aria-live="polite"></div>
</section>
<dialog id="upload-dialog"><form id="upload-form"><header><h2>Novo documento</h2><button type="button" data-close aria-label="Fechar">×</button></header><label>Nome<input name="name" required minlength="2" maxlength="180" /></label><label>Tipo documental<select name="documentTypeId" required><option value="">Selecione…</option></select></label><label>Descrição<textarea name="description" maxlength="2000"></textarea></label><label>Tags<input name="tags" maxlength="300" placeholder="qualidade, safra 2026" /></label><div class="form-row"><label>Vincular a<select name="entityType"><option value="">Sem vínculo</option><option value="PROPERTY">Propriedade</option><option value="PLOT">Talhão</option><option value="SEASON">Safra</option><option value="PRODUCT">Produto</option><option value="LOT">Lote</option><option value="CUSTOMER">Cliente</option><option value="CONTRACT">Contrato</option><option value="SUPPLIER">Fornecedor</option></select></label><label>Registro<select name="entityId" disabled><option value="">Selecione o tipo primeiro</option></select></label></div><label class="file-drop">Arquivo (PDF, imagens, CSV, XML, DOCX ou XLSX; até 25 MB)<input name="file" type="file" required accept=".pdf,.png,.jpg,.jpeg,.webp,.csv,.txt,.xml,.docx,.xlsx" /><progress value="0" max="100" hidden></progress></label><p class="form-error" role="alert"></p><footer><button type="button" data-close>Cancelar</button><button class="primary-button" type="submit">Enviar documento</button></footer></form></dialog>
<dialog id="detail-dialog" class="large-dialog"><article><header><div><span class="badge" id="detail-badge">ACTIVE</span><h2 id="detail-title">Detalhes do Documento</h2></div><button type="button" data-close aria-label="Fechar">×</button></header><div class="detail-body"><div class="detail-grid"><div><small>Tipo documental</small><strong id="detail-type">—</strong></div><div><small>Versão atual</small><strong id="detail-current-version">—</strong></div><div><small>Vínculos canônicos</small><span id="detail-links">—</span></div><div><small>Tags</small><span id="detail-tags">—</span></div></div><div class="detail-description"><small>Descrição</small><p id="detail-desc">—</p></div><div class="detail-actions-bar"><button type="button" class="primary-button" id="detail-btn-new-version">＋ Nova versão</button><a id="detail-btn-download-latest" class="button" href="#">Baixar versão atual</a><button type="button" class="danger-button" id="detail-btn-archive">Arquivar</button></div><section class="version-history-section"><h3>Histórico de versões e integridade (SHA-256)</h3><div id="detail-versions-table" class="table-container"></div></section></div><footer><button type="button" data-close>Fechar</button></footer></article></dialog>
<dialog id="action-dialog"><form id="action-form"><header><h2>Ação</h2><button type="button" data-close aria-label="Fechar">×</button></header><div id="action-fields"></div><p class="form-error" role="alert"></p><footer><button type="button" data-close>Cancelar</button><button class="primary-button" type="submit">Confirmar</button></footer></form></dialog>
@section Scripts { <script src="~/js/documents.js" asp-append-version="true"></script> }
