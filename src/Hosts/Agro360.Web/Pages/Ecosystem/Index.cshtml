@page "/ecosystem"
@model Agro360.Web.Pages.Ecosystem.IndexModel
@{ViewData["Title"]="Ecossistema Agro360";}
<link rel="stylesheet" href="~/css/ecosystem.css" asp-append-version="true" />
<section class="ecosystem-shell"><header class="eco-hero"><div><span class="eyebrow">AGRO360 · ECOSSISTEMA SaaS</span><h1>Marketplace & Integrações</h1><p>Módulos, parceiros, aplicações e eventos sob governança do seu tenant.</p></div><select id="eco-culture" aria-label="Idioma"><option value="pt-BR">Português</option><option value="en-US">English</option><option value="es-ES">Español</option></select></header>
<nav class="eco-tabs" aria-label="Áreas do ecossistema"><button data-view="dashboard">Integrações / Dashboard</button><button data-view="modules">Marketplace / Catálogo</button><button data-view="requests">Marketplace / Solicitações de Ativação</button><button data-view="partners">Portal de Parceiros / Parceiros</button><button data-view="access">Portal de Parceiros / Acessos por Cliente</button><button data-view="apps">Integrações / Aplicações Externas</button><button data-view="keys">Integrações / Chaves de API</button><button data-view="webhooks">Integrações / Webhooks</button><button data-view="logs">Auditoria de Integrações</button><button data-view="docs">Central de Desenvolvedores</button><button data-view="plans">Catálogo Comercial / Planos e Recursos</button></nav>
<details class="contextual-help"><summary data-i18n="helpTitle">Como usar esta tela</summary><p data-i18n="help">Selecione uma área, revise escopos e prazos e confirme somente ações autorizadas. Toda alteração fica auditada.</p></details>
<div class="eco-toolbar"><input id="eco-search" type="search" placeholder="Buscar por nome ou status"><button class="primary-button" id="eco-new">Novo registro</button><button id="eco-refresh">Atualizar</button></div><p id="eco-feedback" role="status"></p><main id="eco-content" aria-live="polite" aria-busy="true"><div class="eco-loading">Carregando dados seguros…</div></main>
<dialog id="eco-dialog"><form id="eco-form"><button type="button" data-close aria-label="Fechar">×</button><h2>Novo registro</h2><div data-fields></div><p role="alert"></p><button class="primary-button" type="submit">Salvar</button></form></dialog></section>
@section Scripts{<script src="~/js/ecosystem.js" asp-append-version="true" defer></script>}
