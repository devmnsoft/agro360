@page
@model Agro360.Web.Pages.Export.IndexModel
@{ ViewData["Title"]="Exportação e Trading"; }
@section Head { <link rel="stylesheet" href="~/css/export-trading.css" asp-append-version="true" /> }
<div class="export-shell">
<header class="export-hero"><div><span>SPRINT 39 · COMÉRCIO INTERNACIONAL</span><h1>Exportação e Trading</h1><p>Contratos, compliance, embarques e margem internacional em uma operação auditável.</p></div><button type="button" data-open="customer">Novo cliente internacional</button></header>
<nav class="export-tabs" aria-label="Áreas de exportação">@foreach(var tab in new[]{("dashboard","Dashboard"),("customers","Clientes Internacionais"),("contracts","Contratos Internacionais"),("proformas","Proformas"),("invoice","Commercial Invoice"),("packing","Packing List"),("documents","Documentos de Exportação"),("shipments","Embarques"),("compliance","Compliance de Exportação"),("traceability","Rastreabilidade Internacional"),("costs","Custos de Exportação"),("reports","Relatórios")}){<button type="button" data-tab="@tab.Item1">@tab.Item2</button>}</nav>
<section id="export-status" role="status">Carregando dados reais do tenant…</section>
<section class="export-grid" data-panel="dashboard"><article><small>Contratos em aberto</small><strong id="contracts-open">—</strong></article><article><small>Aprovados</small><strong id="contracts-approved">—</strong></article><article><small>Aguardando documentação</small><strong id="documents-pending">—</strong></article><article><small>Embarques planejados</small><strong id="shipments-planned">—</strong></article><article><small>Embarques atrasados</small><strong id="shipments-late">—</strong></article><article><small>Valor exportado no mês</small><strong id="exported-month">—</strong></article><article><small>Custos de exportação</small><strong id="export-costs">—</strong></article></section>
<section data-panel="customers" hidden><header><h2>Clientes internacionais</h2><form data-filter="customers"><input name="search" placeholder="Buscar por nome ou contato"/><select name="status"><option value="">Todos os status</option><option>ACTIVE</option><option>APPROVED</option><option>UNDER_REVIEW</option><option>BLOCKED</option><option>REJECTED</option></select><button>Buscar</button></form></header><div class="export-table" id="customer-list"></div></section>
<section data-panel="contracts" hidden><header><h2>Contratos internacionais</h2><button type="button" data-open="contract">Novo contrato</button></header><div class="export-table" id="contract-list"></div></section>
<section data-panel="shipments" hidden><header><h2>Controle de embarque</h2><button type="button" data-open="shipment">Novo embarque</button></header><div class="export-table" id="shipment-list"></div></section>
@foreach(var panel in new[]{("proformas","Proformas"),("invoice","Commercial Invoice"),("packing","Packing List"),("documents","Documentos e certificados"),("compliance","Compliance de exportação"),("traceability","Rastreabilidade comercial internacional"),("costs","Custos e margem"),("reports","Relatórios CSV")}){<section data-panel="@panel.Item1" hidden><h2>@panel.Item2</h2><p>Consulte registros vinculados aos contratos do tenant. Nenhum dado é preenchido artificialmente.</p><div class="empty-state">Nenhum registro encontrado para os filtros atuais.</div></section>}
<dialog id="export-dialog"><form method="dialog"><button aria-label="Fechar">×</button><h2 id="dialog-title"></h2><p>Use as buscas por nome e número nos cadastros; identificadores técnicos nunca são solicitados.</p></form></dialog>
</div>
@section Scripts { <script src="~/js/export-trading.js" asp-append-version="true"></script> }
