@page "/field"
@model Agro360.Web.Pages.Field.IndexModel
@{ ViewData["Title"] = "Operação de campo"; }
<link rel="stylesheet" href="~/css/field.css" asp-append-version="true" />
<main class="field-shell">
<header class="field-header"><div><span class="eyebrow" data-i18n-ag="fl.eyebrow">Operação mobile-first</span><h1 data-i18n-ag="fl.title">Agro360 Campo</h1></div><output id="network" class="status" aria-live="polite" data-i18n-ag="fl.checkingConnection">Verificando conexão…</output></header>
<section class="field-kpis" aria-label="Resumo operacional" data-i18n-ag-aria="fl.kpisAria"><article><small data-i18n-ag="fl.kpi.localQueue">Fila local</small><strong id="pending">0</strong></article><article><small data-i18n-ag="fl.kpi.errors">Com erro</small><strong id="errors">0</strong></article><article><small data-i18n-ag="fl.kpi.pendingChecklists">Checklists pendentes</small><strong id="pending-checklists">0</strong></article><article><small data-i18n-ag="fl.kpi.completedChecklists">Concluídos</small><strong id="completed-checklists">0</strong></article><article><small data-i18n-ag="fl.kpi.criticalOpen">Críticas abertas</small><strong id="critical-occurrences">0</strong></article><article><small data-i18n-ag="fl.kpi.conflicts">Conflitos</small><strong id="conflicts">0</strong></article><article class="last-sync"><small data-i18n-ag="fl.kpi.lastSync">Última sincronização</small><strong id="last-sync" data-i18n-ag="fl.never">Nunca</strong></article></section>
<nav class="field-actions" aria-label="Meus atalhos de campo" data-i18n-ag-aria="fl.shortcutsAria"><button data-panel="quick">＋<strong data-i18n-ag="fl.nav.activity">Atividade</strong></button><button data-panel="occurrence">!<strong data-i18n-ag="fl.nav.occurrence">Ocorrência</strong></button><button data-panel="checkin">⌖<strong data-i18n-ag="fl.nav.checkin">Check-in</strong></button><button data-panel="evidence">▣<strong data-i18n-ag="fl.nav.evidence">Evidência</strong></button><button data-panel="checklists">✓<strong data-i18n-ag="fl.nav.checklists">Checklists</strong></button><button data-panel="qr">⌗<strong data-i18n-ag="fl.nav.qrReader">Leitor QR</strong></button><button id="sync">↻<strong data-i18n-ag="fl.nav.sync">Sincronizar</strong></button></nav>
<section class="field-card" id="quick"><h2 data-i18n-ag="fl.quickTitle">Novo registro</h2><form id="quick-form"><label><span data-i18n-ag="fl.quick.area">Área</span><select name="area" required><option value="" data-i18n-ag="ag.select">Selecione</option><option value="agriculture" data-i18n-ag="fl.area.agriculture">Agricultura</option><option value="livestock" data-i18n-ag="fl.area.livestock">Pecuária</option><option value="inventory" data-i18n-ag="fl.area.inventory">Estoque</option><option value="logistics" data-i18n-ag="fl.area.logistics">Logística</option></select></label><label><span data-i18n-ag="fl.quick.type">Tipo</span><select name="kind" required><option value="" data-i18n-ag="ag.select">Selecione</option><option data-i18n-ag="fl.kind.agriculture">Atividade agrícola</option><option data-i18n-ag="fl.kind.pest">Praga ou doença</option><option data-i18n-ag="fl.kind.inputApplication">Aplicação de insumo</option><option data-i18n-ag="fl.kind.irrigation">Irrigação</option><option data-i18n-ag="fl.kind.animalHandling">Manejo animal</option><option data-i18n-ag="fl.kind.animalHealth">Sanidade animal</option><option data-i18n-ag="fl.kind.weighing">Pesagem animal</option><option data-i18n-ag="fl.kind.refueling">Abastecimento</option><option data-i18n-ag="fl.kind.simpleMaintenance">Manutenção simples</option><option data-i18n-ag="fl.kind.simpleWaybill">Romaneio simples</option><option data-i18n-ag="fl.kind.logisticsOccurrence">Ocorrência logística</option></select></label><label><span data-i18n-ag="fl.itemRelated">Item relacionado</span><input id="entity-search" type="search" data-i18n-ag-ph="fl.phItemSearch" placeholder="Pesquise por nome ou código operacional" autocomplete="off" required /><select id="entity" name="entity" required size="4" aria-label="Resultados da pesquisa" data-i18n-ag-aria="fl.resultsAria"></select></label><label><span data-i18n-ag="fl.quantity">Quantidade</span><input name="quantity" type="number" min="0" step="0.01" /></label><label><span data-i18n-ag="fl.dateTime">Data e hora</span><input name="occurredAt" type="datetime-local" required /></label><label><span data-i18n-ag="fl.notesLabel">Observação</span><textarea name="notes" maxlength="500"></textarea></label><label class="check"><input name="location" type="checkbox" /><span data-i18n-ag="fl.includeLocation"> Incluir localização, se permitida</span></label><button class="primary" type="submit" data-i18n-ag="fl.saveRecord">Salvar registro</button></form></section>
<section class="field-card" id="occurrence" hidden><h2 data-i18n-ag="fl.occurrenceTitle">Nova ocorrência</h2><form id="occurrence-form"><label><span data-i18n-ag="fl.occurrenceType">Tipo</span><select name="occurrenceType" required><option value="" data-i18n-ag="ag.select">Selecione</option><option value="FIELD" data-i18n-ag="fl.type.field">Campo</option><option value="LOGISTICS" data-i18n-ag="fl.type.logistics">Logística</option><option value="QUALITY" data-i18n-ag="fl.type.quality">Qualidade</option><option value="SAFETY" data-i18n-ag="fl.type.safety">Segurança</option><option value="ENVIRONMENTAL" data-i18n-ag="fl.type.environmental">Ambiental</option></select></label><label><span data-i18n-ag="fl.severity">Criticidade</span><select name="severity" required><option value="LOW" data-i18n-ag="fl.sev.low">Baixa</option><option value="MEDIUM" data-i18n-ag="fl.sev.medium">Média</option><option value="HIGH" data-i18n-ag="fl.sev.high">Alta</option><option value="CRITICAL" data-i18n-ag="fl.sev.critical">Crítica</option></select></label><label><span data-i18n-ag="fl.titleField">Título</span><input name="title" required minlength="3" maxlength="160"></label><label><span data-i18n-ag="fl.dateTime">Data e hora</span><input name="occurredAt" type="datetime-local" required></label><label class="wide"><span data-i18n-ag="fl.description">Descrição</span><textarea name="description" required minlength="5" maxlength="2000"></textarea></label><label class="check wide"><input name="location" type="checkbox"><span data-i18n-ag="fl.includeAuthorizedLocation"> Incluir localização autorizada</span></label><button class="primary" type="submit" data-i18n-ag="fl.registerOccurrence">Registrar ocorrência</button></form></section>
<section class="field-card" id="checkin" hidden><h2 data-i18n-ag="fl.checkinTitle">Check-in operacional</h2><form id="checkin-form"><label><span data-i18n-ag="fl.operation">Operação</span><select name="operationType" required><option value="" data-i18n-ag="ag.select">Selecione</option><option value="TECHNICAL_VISIT" data-i18n-ag="fl.op.techVisit">Visita técnica</option><option value="COMMERCIAL_VISIT" data-i18n-ag="fl.op.commercialVisit">Visita comercial</option><option value="COLLECTION" data-i18n-ag="fl.op.collection">Coleta</option><option value="DELIVERY" data-i18n-ag="fl.op.delivery">Entrega</option><option value="INSPECTION" data-i18n-ag="fl.op.inspection">Inspeção</option><option value="AUDIT" data-i18n-ag="fl.op.audit">Auditoria</option></select></label><label><span data-i18n-ag="fl.dateTime">Data e hora</span><input name="occurredAt" type="datetime-local" required></label><label class="check"><input name="manual" type="checkbox"><span data-i18n-ag="fl.gpsUnavailable"> GPS indisponível</span></label><label id="manual-reason" hidden><span data-i18n-ag="fl.reason">Justificativa</span><input name="manualReason" minlength="5" maxlength="500"></label><label class="wide"><span data-i18n-ag="fl.notesLabel">Observação</span><textarea name="observation" maxlength="1000"></textarea></label><button class="primary" type="submit" data-i18n-ag="fl.confirmCheckin">Confirmar check-in</button></form></section>
<section class="field-card" id="evidence" hidden><h2 data-i18n-ag="fl.evidenceTitle">Capturar evidência</h2><form id="evidence-form"><label><span data-i18n-ag="fl.evidenceType">Tipo</span><select name="type" required><option value="" data-i18n-ag="ag.select">Selecione</option><option value="PHOTO" data-i18n-ag="fl.type.photo">Foto</option><option value="DOCUMENT" data-i18n-ag="fl.type.document">Documento</option></select></label><label><span data-i18n-ag="fl.entity">Entidade</span><select name="entity" class="lookup" required><option value="" data-i18n-ag="fl.phEntityName">Selecione pelo nome</option></select></label><label><span data-i18n-ag="fl.file">Arquivo</span><input name="file" type="file" accept="image/*,.pdf" capture="environment" required /></label><label><span data-i18n-ag="fl.notesLabel">Observação</span><textarea name="notes" maxlength="500"></textarea></label><button class="primary" type="submit" data-i18n-ag="fl.keepEvidence">Guardar evidência</button></form></section>
<section class="field-card" id="qr" hidden><h2 data-i18n-ag="fl.qrTitle">QR Code operacional</h2><p data-i18n-ag="fl.qrHint">Aponte a câmera ou informe o código impresso.</p><video id="qr-video" playsinline muted hidden></video><label><span data-i18n-ag="fl.qrCode">Código QR</span><input id="qr-code" minlength="12" maxlength="64" required /></label><button class="primary" id="resolve-qr" type="button" data-i18n-ag="fl.qrResolve">Consultar com segurança</button><div id="qr-result" role="status"></div></section>
<section class="field-card" id="checklists" hidden><h2 data-i18n-ag="fl.checklistTitle">Checklists pendentes</h2><div id="checklist-list" class="empty">Carregando…</div></section>
<section class="field-card"><h2 data-i18n-ag="fl.offlineTitle">Pendências offline</h2><div id="queue" class="empty" data-i18n-ag="fl.offlineEmpty">Nenhum registro pendente.</div></section>
<nav class="field-bottom" aria-label="Navegação mobile" data-i18n-ag-aria="fl.bottomNavAria"><a href="/" data-i18n-ag="fl.bottomHome">Início</a><button data-panel="quick" data-i18n-ag="fl.bottomOperate">Operar</button><button data-panel="checklists" data-i18n-ag="fl.nav.checklists">Checklists</button><button id="bottom-sync" data-i18n-ag="fl.nav.sync">Sincronizar</button></nav><div id="toast" role="status" aria-live="polite"></div>
</main>
<script src="~/js/field.js" asp-append-version="true"></script>
