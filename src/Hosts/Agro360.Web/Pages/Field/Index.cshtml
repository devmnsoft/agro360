@page "/field"
@model Agro360.Web.Pages.Field.IndexModel
@{ ViewData["Title"] = "Operação de campo"; }
<link rel="stylesheet" href="~/css/field.css" asp-append-version="true" />
<main class="field-shell">
<header class="field-header"><div><span class="eyebrow">Operação mobile-first</span><h1>Agro360 Campo</h1></div><output id="network" class="status" aria-live="polite">Verificando conexão…</output></header>
<section class="field-kpis" aria-label="Resumo operacional"><article><small>Pendentes</small><strong id="pending">0</strong></article><article><small>Com erro</small><strong id="errors">0</strong></article><article><small>Última sincronização</small><strong id="last-sync">Nunca</strong></article></section>
<nav class="field-actions" aria-label="Atalhos de campo"><button data-panel="quick">＋<strong>Manejo</strong></button><button data-panel="occurrence">!<strong>Ocorrência</strong></button><button data-panel="checkin">⌖<strong>Check-in</strong></button><button data-panel="evidence">▣<strong>Evidência</strong></button><button data-panel="checklists">✓<strong>Checklists</strong></button><button id="sync">↻<strong>Sincronizar</strong></button></nav>
<section class="field-card" id="quick"><h2>Novo registro</h2><form id="quick-form"><label>Área<select name="area" required><option value="">Selecione</option><option value="agriculture">Agricultura</option><option value="livestock">Pecuária</option><option value="inventory">Estoque</option><option value="logistics">Logística</option></select></label><label>Tipo<select name="kind" required><option value="">Selecione</option><option>Atividade agrícola</option><option>Praga ou doença</option><option>Aplicação de insumo</option><option>Irrigação</option><option>Manejo animal</option><option>Sanidade animal</option><option>Pesagem animal</option><option>Abastecimento</option><option>Manutenção simples</option><option>Romaneio simples</option><option>Ocorrência logística</option></select></label><label>Item relacionado<input id="entity-search" type="search" placeholder="Pesquise por nome ou código operacional" autocomplete="off" required /><select id="entity" name="entity" required size="4" aria-label="Resultados da pesquisa"></select></label><label>Quantidade<input name="quantity" type="number" min="0" step="0.01" /></label><label>Data e hora<input name="occurredAt" type="datetime-local" required /></label><label>Observação<textarea name="notes" maxlength="500"></textarea></label><label class="check"><input name="location" type="checkbox" /> Incluir localização, se permitida</label><button class="primary" type="submit">Salvar registro</button></form></section>
<section class="field-card" id="occurrence" hidden><h2>Nova ocorrência</h2><form id="occurrence-form"><label>Tipo<select name="occurrenceType" required><option value="">Selecione</option><option value="FIELD">Campo</option><option value="LOGISTICS">Logística</option><option value="QUALITY">Qualidade</option><option value="SAFETY">Segurança</option><option value="ENVIRONMENTAL">Ambiental</option></select></label><label>Criticidade<select name="severity" required><option value="LOW">Baixa</option><option value="MEDIUM">Média</option><option value="HIGH">Alta</option><option value="CRITICAL">Crítica</option></select></label><label>Título<input name="title" required minlength="3" maxlength="160"></label><label>Data e hora<input name="occurredAt" type="datetime-local" required></label><label class="wide">Descrição<textarea name="description" required minlength="5" maxlength="2000"></textarea></label><label class="check wide"><input name="location" type="checkbox"> Incluir localização autorizada</label><button class="primary" type="submit">Registrar ocorrência</button></form></section>
<section class="field-card" id="checkin" hidden><h2>Check-in operacional</h2><form id="checkin-form"><label>Operação<select name="operationType" required><option value="">Selecione</option><option value="TECHNICAL_VISIT">Visita técnica</option><option value="COMMERCIAL_VISIT">Visita comercial</option><option value="COLLECTION">Coleta</option><option value="DELIVERY">Entrega</option><option value="INSPECTION">Inspeção</option><option value="AUDIT">Auditoria</option></select></label><label>Data e hora<input name="occurredAt" type="datetime-local" required></label><label class="check"><input name="manual" type="checkbox"> GPS indisponível</label><label id="manual-reason" hidden>Justificativa<input name="manualReason" minlength="5" maxlength="500"></label><label class="wide">Observação<textarea name="observation" maxlength="1000"></textarea></label><button class="primary" type="submit">Confirmar check-in</button></form></section>
<section class="field-card" id="evidence" hidden><h2>Capturar evidência</h2><form id="evidence-form"><label>Tipo<select name="type" required><option value="">Selecione</option><option value="PHOTO">Foto</option><option value="DOCUMENT">Documento</option></select></label><label>Entidade<select name="entity" class="lookup" required><option value="">Selecione pelo nome</option></select></label><label>Arquivo<input name="file" type="file" accept="image/*,.pdf" capture="environment" required /></label><label>Observação<textarea name="notes" maxlength="500"></textarea></label><button class="primary" type="submit">Guardar evidência</button></form></section>
<section class="field-card" id="qr" hidden><h2>QR Code operacional</h2><p>Aponte a câmera ou informe o código impresso.</p><video id="qr-video" playsinline muted hidden></video><label>Código QR<input id="qr-code" minlength="12" maxlength="64" required /></label><button class="primary" id="resolve-qr" type="button">Consultar com segurança</button><div id="qr-result" role="status"></div></section>
<section class="field-card" id="checklists" hidden><h2>Checklists pendentes</h2><div id="checklist-list" class="empty">Carregando…</div></section>
<section class="field-card"><h2>Pendências offline</h2><div id="queue" class="empty">Nenhum registro pendente.</div></section>
<nav class="field-bottom" aria-label="Navegação mobile"><a href="/">Início</a><button data-panel="quick">Operar</button><button data-panel="checklists">Checklists</button><button id="bottom-sync">Sincronizar</button></nav><div id="toast" role="status" aria-live="polite"></div>
</main>
<script src="~/js/field.js" asp-append-version="true"></script>
