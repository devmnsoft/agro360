@page
@model Agro360.Web.Pages.Fiscal.IndexModel
@{ ViewData["Title"]="Fiscal e Faturamento"; }
<section class="page fiscal-page">
<header class="page-heading"><div><span class="eyebrow">Sprint 40 · gestão fiscal gerencial</span><h1>Fiscal e Faturamento</h1><p>Operações, regras tributárias informadas, faturamentos e documentos externos com rastreabilidade por tenant.</p></div><button class="primary-button" type="button" data-open="operation">Nova operação</button></header>
<div class="alert-banner"><strong>Emissão fiscal externa</strong><span>O Agro360 não simula autorização SEFAZ. Documentos permanecem “Aguardando emissão externa” até integração real com provedor e certificado.</span></div>
<aside class="panel fiscal-help"><h2>Como usar esta tela</h2><p>Cadastre primeiro o perfil, as séries, os produtos e as regras fiscais. Revise as pendências antes de emitir. Autorizações, cancelamentos e cartas de correção só mudam para concluídos após retorno real do provedor.</p></aside>
<nav class="section-tabs" aria-label="Áreas fiscais"><button class="active" data-tab="dashboard">Dashboard</button><button data-tab="profiles">Cadastro fiscal</button><button data-tab="series">Séries</button><button data-tab="products">Produtos fiscais</button><button data-tab="operations">Naturezas / CFOP</button><button data-tab="rules">CST / CSOSN</button><button data-tab="invoices">Emissão prevista</button><button data-tab="documents">Documentos emitidos</button><button data-tab="corrections">Cartas de correção</button><button data-tab="events">Eventos</button><button data-tab="pending">Pendências</button><button data-tab="reports">Relatórios</button></nav>
<div id="fiscal-message" class="form-message" role="status"></div>
<section data-panel="dashboard"><div class="metric-grid" id="fiscal-metrics" aria-busy="true"><article class="metric-card"><span>Carregando dados reais…</span></article></div><div class="panel"><h2>Alertas e pendências</h2><div id="fiscal-alerts" class="empty-state">Nenhum alerta carregado.</div></div></section>
<section data-panel="operations" hidden><div class="panel"><div class="panel-heading"><h2>Operações fiscais</h2><div><input class="table-search" data-search="operations" placeholder="Buscar por nome ou código"/><button type="button" data-open="operation">Nova</button></div></div><div class="table-wrap"><table><thead><tr><th>Código</th><th>Nome</th><th>Tipo</th><th>Estoque</th><th>Financeiro</th><th>Status</th></tr></thead><tbody id="operations-body"></tbody></table></div></div></section>
<section data-panel="rules" hidden><div class="panel"><div class="panel-heading"><h2>Regras por produto, operação e UF</h2><div><input class="table-search" data-search="rules" placeholder="Buscar CFOP ou operação"/><button type="button" data-open="rule">Nova regra</button></div></div><div class="table-wrap"><table><thead><tr><th>Operação</th><th>Origem → destino</th><th>CFOP</th><th>ICMS informado</th><th>Validade</th><th>Status</th></tr></thead><tbody id="rules-body"></tbody></table></div></div></section>
<section data-panel="invoices" hidden><div class="panel"><div class="panel-heading"><h2>Faturamentos</h2><div><input class="table-search" data-search="invoices" placeholder="Buscar cliente ou número"/><button type="button" data-open="invoice">Novo faturamento</button></div></div><div class="table-wrap"><table><thead><tr><th>Número</th><th>Cliente</th><th>Operação</th><th>Total</th><th>Status</th><th>Ações</th></tr></thead><tbody id="invoices-body"></tbody></table></div></div></section>
<section data-panel="documents" hidden><div class="panel"><div class="panel-heading"><h2>NF-e, NFS-e, CT-e e MDF-e</h2><div><input class="table-search" data-search="documents" placeholder="Número ou chave de acesso"/><button type="button" data-open="document">Registrar documento</button></div></div><div class="table-wrap"><table><thead><tr><th>Tipo</th><th>Número / série</th><th>Emissão</th><th>Total</th><th>Status</th><th>Ações</th></tr></thead><tbody id="documents-body"></tbody></table></div></div></section>
@foreach(var tab in new[]{("profiles","Cadastro fiscal do tenant","Razão social, regime tributário, município e provedor configurado."),("series","Séries fiscais","Numeração fiscal controlada por tipo de documento."),("products","Produtos fiscais","NCM, CFOP, origem e unidade fiscal obrigatórios."),("corrections","Cartas de correção","Solicitações registradas sem simular aceite da SEFAZ."),("events","Eventos fiscais","Trilha de auditoria das ações críticas."),("pending","Pendências fiscais","Integrações, rejeições e configurações que exigem atenção.")}){<section data-panel="@tab.Item1" hidden><div class="panel"><div class="panel-heading"><div><h2>@tab.Item2</h2><p>@tab.Item3</p></div></div><div class="table-wrap"><table><thead><tr><th>Identificação</th><th>Descrição</th><th>Status</th><th>Data</th></tr></thead><tbody data-catalog="@tab.Item1"><tr><td colspan="4"><div class="empty-state">Abra esta seção para carregar os dados reais.</div></td></tr></tbody></table></div></div></section>}
@foreach(var tab in new[]{("purchases","Conferência fiscal de compras","Compare pedido, recebimento e documento. Divergências de valor exigem justificativa."),("divergences","Divergências fiscais","Divergências reais abertas são preservadas para auditoria."),("integrations","Integração financeira fiscal","Previsões permanecem pendentes; nenhuma parcela é marcada como liquidada sem baixa real.")}){<section data-panel="@tab.Item1" hidden><div class="panel"><h2>@tab.Item2</h2><p>@tab.Item3</p>@if(tab.Item1=="purchases"){<button type="button" data-open="purchase">Iniciar conferência</button>}</div></section>}
<section data-panel="reports" hidden><div class="panel"><h2>Relatórios CSV</h2><div class="report-grid">@foreach(var r in new[]{("operations","Operações fiscais"),("rules","Regras fiscais"),("invoices","Faturamentos"),("documents","Documentos fiscais"),("documents-status","Documentos por status"),("invoices-customer","Faturamento por cliente"),("invoices-product","Faturamento por produto"),("invoices-operation","Faturamento por operação"),("purchase-divergences","Compras divergentes"),("pending-integrations","Integrações pendentes"),("stock-movements","Movimentos de estoque")}){<a class="report-card" data-report="@r.Item1" href="#"><strong>@r.Item2</strong><span>Exportar filtros atuais em CSV</span></a>}</div></div></section>
</section>
<dialog id="fiscal-dialog"><form id="fiscal-form" method="dialog"><header><h2 id="dialog-title">Cadastro fiscal</h2><button value="cancel" aria-label="Fechar">×</button></header><div id="dialog-fields" class="form-grid"></div><footer><button value="cancel">Cancelar</button><button class="primary-button" id="dialog-save" value="default">Salvar</button></footer></form></dialog>
@section Scripts { <script src="~/js/fiscal.js" asp-append-version="true" defer></script> }
