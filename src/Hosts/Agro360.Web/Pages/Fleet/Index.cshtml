@page "/fleet"
@model Agro360.Web.Pages.Fleet.IndexModel
@{ ViewData["Title"] = "Frota e Manutenção"; }

@section Styles { <link rel="stylesheet" href="~/css/fleet.css" asp-append-version="true" /> }

<section class="page-content fleet-page" id="fleet-app">
    <header class="page-heading">
        <div>
            <span class="eyebrow">Disponibilidade operacional</span>
            <h1>Frota e <span>manutenção</span></h1>
            <p>Identifique a necessidade, programe o atendimento, reserve peças, execute, inspecione e liberte o equipamento com custo rastreável.</p>
        </div>
        <div class="heading-actions">
            <button class="secondary-button" id="export" type="button">Exportar CSV</button>
            <button class="primary-button" id="primary-action" type="button">Novo registro</button>
        </div>
    </header>

    <details class="screen-help contextual-help" open>
        <summary>Como usar esta tela</summary>
        <div class="fleet-help" id="tab-help"></div>
    </details>

    <div class="fleet-metrics" id="metrics" aria-live="polite"></div>

    <nav class="fleet-tabs" aria-label="Áreas da frota">
        <button type="button" data-tab="overview" class="active">Visão geral</button>
        <button type="button" data-tab="assets">Equipamentos</button>
        <button type="button" data-tab="agenda">Agenda</button>
        <button type="button" data-tab="readings">Leituras</button>
        <button type="button" data-tab="plans">Planos preventivos</button>
        <button type="button" data-tab="requests">Solicitações</button>
        <button type="button" data-tab="orders">Ordens</button>
        <button type="button" data-tab="parts">Peças e serviços</button>
        <button type="button" data-tab="fuel">Abastecimentos</button>
        <button type="button" data-tab="costs">Custos</button>
        <button type="button" data-tab="reports">Relatórios</button>
    </nav>

    <section class="toolbar">
        <label>Buscar<input id="search" type="search" maxlength="120" placeholder="Código, placa ou OS" autocomplete="off" /></label>
        <label>Status<select id="status-filter"><option value="">Todos</option><option>AVAILABLE</option><option>OPERATING</option><option>MAINTENANCE</option><option>UNAVAILABLE</option><option>RESERVED</option><option>WAITING_PART</option><option>INSPECTION</option></select></label>
        <button class="secondary-button" id="refresh" type="button">Atualizar</button>
    </section>

    <section class="panel" id="content" aria-live="polite"><p class="empty-state">Carregando frota…</p></section>
</section>

<dialog id="fleet-dialog" class="fleet-dialog" aria-labelledby="dialog-title">
    <form id="fleet-form" novalidate>
        <header>
            <div><span class="eyebrow">Operação</span><h2 id="dialog-title">Novo registro</h2></div>
            <button type="button" class="dialog-close" data-close aria-label="Fechar">×</button>
        </header>
        <div class="fleet-form-grid" id="dialog-fields"></div>
        <p class="form-message" id="dialog-error" role="alert"></p>
        <footer>
            <button class="secondary-button" type="button" data-close>Cancelar</button>
            <button class="primary-button" type="submit" data-confirm-action data-confirm-title="Confirmar operação" data-confirm-consequence="A ação será persistida, auditada e pode alterar disponibilidade, estoque ou custos."><span>Salvar</span></button>
        </footer>
    </form>
</dialog>

<div id="fleet-toast" class="fleet-toast" hidden role="status"></div>
<script src="~/js/fleet.js" asp-append-version="true"></script>
