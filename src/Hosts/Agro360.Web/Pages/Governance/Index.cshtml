@page "/governance"
@model Agro360.Web.Pages.Governance.IndexModel
@{ViewData["Title"]="Governança de Dados";}
@section Head {<link rel="stylesheet" href="~/css/governance.css" asp-append-version="true" />}
<section class="gov-shell" data-view="@Model.ViewName">
<header class="gov-hero"><div><span class="eyebrow">MNSOFT · confiança operacional</span><h1>Governança de Dados</h1><p>Importação controlada, qualidade, privacidade, rastreabilidade e saúde técnica por tenant.</p></div><button class="primary-button" data-open-import>＋ Novo lote</button></header>
<details class="screen-help"><summary>Como usar esta tela</summary><p>Escolha uma área, aplique filtros e aja somente nos registros autorizados. Importações passam por mapeamento e pré-validação; correções, exportações e decisões LGPD exigem justificativa e ficam auditadas.</p></details>
<nav class="gov-tabs" aria-label="Governança"><button data-tab="dashboard">Dashboard</button><button data-tab="imports">Importação</button><button data-tab="quality">Qualidade</button><button data-tab="exports">Backup gerencial</button><button data-tab="lgpd">LGPD</button><button data-tab="audit">Auditoria avançada</button><button data-tab="security">Sessões e acessos</button><button data-tab="performance">Saúde das consultas</button><button data-tab="global">Governança global</button><button data-tab="my-data">Meus dados</button></nav>
<div id="gov-status" role="status">Carregando dados autorizados…</div>
<section id="dashboard" class="gov-panel"><h2>Indicadores do tenant</h2><div class="gov-kpis" id="gov-kpis"><article><b>—</b><span>Lotes recentes</span></article><article><b>—</b><span>Inconsistências críticas</span></article><article><b>—</b><span>Solicitações LGPD</span></article><article><b>—</b><span>Sessões ativas</span></article></div></section>
<section id="imports" class="gov-panel"><header><div><h2>Importação e migração</h2><p>Novo lote → Mapeamento → Pré-validação → Resultado</p></div><button data-open-import>Novo lote CSV</button></header><ol class="stepper"><li class="active">Arquivo</li><li>Mapeamento de colunas</li><li>Pré-validação</li><li>Resultado</li></ol><div class="table-wrap"><table><thead><tr><th>Arquivo</th><th>Módulo</th><th>Status</th><th>Válidas</th><th>Erros</th><th>Data</th></tr></thead><tbody id="import-list"></tbody></table></div></section>
<section id="quality" class="gov-panel"><header><div><h2>Inconsistências e duplicidades</h2><p>Campos ausentes, documentos inválidos, relações quebradas e cadastros incompletos.</p></div><button data-export="quality">Exportar CSV</button></header><div id="quality-list" class="empty-state">Nenhuma inconsistência retornada para os filtros atuais.</div></section>
<section id="exports" class="gov-panel"><header><div><h2>Backup gerencial</h2><p>Exportações reais em CSV/JSON, sem senhas, tokens, hashes ou segredos.</p></div><button data-open-export>Solicitar exportação</button></header><div id="export-list" class="empty-state">Consulte o histórico de solicitações do tenant.</div></section>
<section id="lgpd" class="gov-panel"><header><div><h2>Solicitações LGPD</h2><p>Base legal, finalidade, titular, eventos e decisão rastreável.</p></div><button data-open-lgpd>Nova solicitação</button></header><div id="lgpd-list" class="empty-state">Use a ação acima para registrar uma solicitação do titular.</div></section>
<section id="audit" class="gov-panel"><h2>Auditoria avançada</h2><p>Antes/depois sanitizados, usuário, tenant, origem, correlação, IP e justificativa. Eventos são imutáveis para usuários comuns.</p><div class="filter-row"><input placeholder="Módulo, entidade ou ação"><input type="date"><button>Filtrar</button><button data-export="audit">Exportar CSV</button></div></section>
<section id="security" class="gov-panel"><h2>Sessões e acessos</h2><p>Logins, falhas, bloqueios e sessões ativas. Encerre apenas sessões identificadas e confirme a ação.</p><div id="session-list" class="empty-state">Sessões são filtradas no servidor por tenant e perfil.</div></section>
<section id="performance" class="gov-panel"><h2>Saúde das consultas</h2><p>Latência, linhas retornadas e consultas críticas agregadas, sem armazenar parâmetros sensíveis.</p><div id="query-list" class="empty-state">Nenhum alerta de consulta no período.</div></section>
<section id="global" class="gov-panel"><h2>Governança global</h2><p>Exclusiva ao super administrador MNSOFT. Toda troca de tenant e ação global exige finalidade e gera auditoria reforçada.</p></section>
<section id="my-data" class="gov-panel"><h2>Meus dados e exportações</h2><p>Consulte a finalidade de tratamento, consentimentos aplicáveis e exportações solicitadas pela sua organização.</p></section>
</section>
<dialog id="import-dialog"><form id="import-form" method="dialog"><header><h2>Novo lote CSV</h2><button value="cancel" aria-label="Fechar">×</button></header><label>Módulo<select name="module" required><option value="">Selecione</option><option>USERS</option><option>FARMS</option><option>PLOTS</option><option>SEASONS</option><option>PRODUCERS</option><option>HERDS</option><option>INVENTORY</option><option>SUPPLIERS</option><option>PRODUCTS</option><option>CUSTOMERS</option><option>DOCUMENTS</option></select></label><label>Arquivo CSV<input name="file" type="file" accept=".csv,text/csv" required></label><label class="confirm"><input name="confirm" type="checkbox"> Confirmo o processamento mesmo se a pré-validação encontrar erros críticos</label><p class="form-error" role="alert"></p><footer><button value="cancel">Cancelar</button><button class="primary-button" value="default">Pré-validar</button></footer></form></dialog>
@section Scripts {<script src="~/js/governance.js" asp-append-version="true" defer></script>}
