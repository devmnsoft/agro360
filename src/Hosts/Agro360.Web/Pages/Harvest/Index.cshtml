@page "/Harvest"
@model Agro360.Web.Pages.Harvest.IndexModel
@{ ViewData["Title"] = "Colheita e Recebimento"; }
@section Styles { <link rel="stylesheet" href="~/css/harvest.css" asp-append-version="true" /> }
<section class="page-content harvest-page">
 <header class="page-heading"><div><span class="eyebrow">Safra · produção primária</span><h1>Colheita e <span>recebimento</span></h1><p>Da estimativa ao lote liberado, sem antecipar produção ou disponibilidade.</p></div><button class="secondary-button" id="refresh-harvest" type="button">Atualizar dados</button></header>
 <details class="screen-help" open><summary>Como usar</summary><div class="help-grid"><p><strong>Pré-requisitos:</strong> propriedade, safra aberta, talhão, produto, depósito e especificação de qualidade ativos.</p><p><strong>Fluxo:</strong> planeje, aponte a realidade, receba total ou parcialmente, classifique e só então destine a quantidade.</p><p><strong>Correções:</strong> não apague registros. Use ajustes/reversões auditáveis; conflitos pedem atualização da tela.</p><p><strong>Permissões:</strong> Agricultura grava plano/apontamento; Produção recebe; Qualidade decide; Liberação destina.</p></div></details>
 <section class="panel closing-panel" aria-labelledby="closing-title"><header class="panel-header"><div><span class="eyebrow">Conferência rastreável</span><h2 id="closing-title">Fechamento gerencial da safra</h2><p>Visão operacional; não constitui fechamento fiscal, contábil ou laudo técnico.</p></div><strong id="closing-state" class="closing-state">Preparação</strong></header>
  <section aria-labelledby="closing-scope-title"><h3 id="closing-scope-title">Escopo</h3><div class="closing-scope"><label>Safra *<span class="lookup-wrap"><input id="closing-season-search" class="lookup" data-lookup="crop-seasons" data-target="closing-season-id" autocomplete="off" placeholder="Pesquise a safra" required /><input id="closing-season-id" type="hidden" /></span><small>A propriedade e a unidade física são obtidas da safra no contexto autorizado.</small></label><label>Data de corte *<input id="closing-cutoff" type="date" required /><small>Usa a data operacional; geração e registros usam instante auditável.</small></label><div class="closing-actions"><button id="consult-closing" class="secondary-button" type="button">Consultar dados</button><button id="run-closing" class="secondary-button" type="button">Executar conferência</button><button id="create-closing" class="primary-button" type="button">Gerar versão</button><button id="export-closing" class="secondary-button" type="button">Exportar CSV</button></div></div></section>
  <p id="closing-message" role="status" aria-live="polite">Selecione a safra e a data de corte para consultar.</p><div id="closing-summary" class="closing-summary" hidden><section aria-labelledby="closing-summary-title"><h3 id="closing-summary-title">Resumo</h3><p id="closing-scope-text"></p></section><section aria-labelledby="closing-indicators-title"><h3 id="closing-indicators-title">Indicadores</h3><div id="closing-indicators" class="closing-indicators"></div></section><div class="closing-columns"><section><h3>Pendências</h3><div id="closing-issues"></div></section><section><h3>Histórico</h3><div id="closing-versions"></div></section></div></div>
 </section>
 <section class="harvest-kpis" id="harvest-kpis" aria-label="Indicadores"><article><small>Planejado</small><strong>—</strong></article><article><small>Colhido</small><strong>—</strong></article><article><small>A receber</small><strong>—</strong></article><article><small>Aguardando qualidade</small><strong>—</strong></article><article><small>Aprovado</small><strong>—</strong></article><article><small>Perdas físicas</small><strong>—</strong></article></section>
 <nav class="workflow-tabs" id="harvest-tabs" aria-label="Etapas da jornada"><button class="active" data-step="plan">1. Planejar</button><button data-step="record">2. Apontar</button><button data-step="receipt">3. Receber</button><button data-step="inspection">4. Classificar</button><button data-step="allocation">5. Destinar</button></nav>
 <section class="panel operation-panel"><header class="panel-header"><div><span class="eyebrow">Próxima ação</span><h2 id="harvest-form-title">Planejar colheita</h2></div><span class="status-pill">Dados auditados no servidor</span></header><div id="harvest-error" class="validation-summary" role="alert" tabindex="-1" hidden></div>
  <form id="harvest-form" novalidate><input type="hidden" name="step" value="plan" /><div id="harvest-fields" class="harvest-form-grid"></div><div class="form-actions"><button type="reset" class="secondary-button">Limpar</button><button type="submit" class="primary-button"><span>Salvar planejamento</span></button></div><p id="harvest-result" role="status" aria-live="polite"></p></form>
 </section>
 <section class="panel"><header class="panel-header"><div><span class="eyebrow">Histórico operacional</span><h2>Registros relacionados</h2></div><label>Filtrar etapa<select id="kind-filter"><option value="">Todas</option><option>PLAN</option><option>HARVEST</option><option>RECEIPT</option></select></label></header><div class="table-scroll"><table><thead><tr><th>Tipo</th><th>Referência</th><th>Estado atual</th><th>Quantidade</th><th>Saldo / próxima ação</th><th>Data</th></tr></thead><tbody id="harvest-list"><tr><td colspan="6">Carregando…</td></tr></tbody></table></div></section>
</section>
@section Scripts { <script src="~/js/harvest.js" asp-append-version="true"></script> }
