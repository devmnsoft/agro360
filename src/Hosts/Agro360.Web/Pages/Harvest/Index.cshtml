@page "/Harvest"
@model Agro360.Web.Pages.Harvest.IndexModel
@{
    ViewData["Title"] = "Colheita e Genealogia";
    ViewData["Breadcrumb"] = "Agricultura / Colheita e Genealogia";
}
@section Styles { <link rel="stylesheet" href="~/css/harvest.css" asp-append-version="true" /> }
<section class="page-content harvest-page">
 <header class="page-heading"><div><span class="eyebrow" data-i18n-ag="har.eyebrow">Safra · produção primária</span><h1><span data-i18n-ag="har.titleA">Colheita e</span> <span data-i18n-ag="har.titleB">recebimento</span></h1><p data-i18n-ag="har.subtitle">Da estimativa ao lote liberado, sem antecipar produção ou disponibilidade.</p></div><button class="secondary-button" id="refresh-harvest" type="button" data-i18n-ag="har.refresh">Atualizar dados</button></header>
 <div id="genealogy-warning-banner" class="alert-banner warning-banner" role="alert" hidden><strong data-i18n-ag="har.bannerStrong">Atenção:</strong> <span data-i18n-ag="har.bannerBody">Foram identificados lotes expedidos desta safra sem origem de talhão de colheita vinculada.</span> <a href="#genealogy-panel" data-i18n-ag="har.bannerLink">Verificar painel de Origem e Destino</a></div>
 <details class="screen-help contextual-help" open><summary data-i18n-ag="har.helpTitle">Como funciona esta tela</summary><div class="help-grid"><p><strong data-i18n-ag="har.help.purposeLbl">Finalidade:</strong><span data-i18n-ag="har.help.purpose"> gerenciar planos, apontamentos de campo, recebimentos físicos, inspeções e a genealogia completa da safra até a expedição.</span></p><p><strong data-i18n-ag="har.help.prereqLbl">Pré-requisitos:</strong><span data-i18n-ag="har.help.prereq"> propriedade, safra aberta, talhão, produto, depósito e especificação de qualidade ativos.</span></p><p><strong data-i18n-ag="har.help.seqLbl">Sequência operacional:</strong><span data-i18n-ag="har.help.seq"> planeje a colheita → aponte a colheita realizada → receba e confira no armazém → realize a classificação de qualidade → destine o material aprovado.</span></p><p><strong data-i18n-ag="har.help.genealogyLbl">Origem e destino (Genealogia):</strong><span data-i18n-ag="har.help.genealogy"> rastreia a cadeia contínua da safra e talhão até o lote de estoque, ordem industrial e remessa comercial. Elos quebrados são sinalizados como 'Não vinculado' sem inventar dados.</span></p><p><strong data-i18n-ag="har.help.closingLbl">Fechamento gerencial:</strong><span data-i18n-ag="har.help.closing"> congela indicadores em snapshot auditável. Estoque atual e receita reconhecida só são calculados com elos fechados e unidades homogêneas; caso contrário permanecem 'Não disponível' com justificativa explícita.</span></p></div></details>
 <section class="panel closing-panel" aria-labelledby="closing-title"><header class="panel-header"><div><span class="eyebrow" data-i18n-ag="har.closingEyebrow">Conferência rastreável</span><h2 id="closing-title" data-i18n-ag="har.closingTitle">Fechamento gerencial da safra</h2><p data-i18n-ag="har.closingDesc">Visão operacional; não constitui fechamento fiscal, contábil ou laudo técnico.</p></div><strong id="closing-state" class="closing-state" data-i18n-ag="har.closingPreparation">Preparação</strong></header>
  <section aria-labelledby="closing-scope-title"><h3 id="closing-scope-title" data-i18n-ag="har.scope">Escopo</h3><div class="closing-scope"><label><span data-i18n-ag="har.seasonLabel">Safra *</span><span class="lookup-wrap"><input id="closing-season-search" class="lookup" data-lookup="crop-seasons" data-target="closing-season-id" autocomplete="off" data-i18n-ag-ph="har.phSeason" placeholder="Pesquise a safra" required /><input id="closing-season-id" type="hidden" /></span><small data-i18n-ag="har.scopeNote">A propriedade e a unidade física são obtidas da safra no contexto autorizado.</small></label><label><span data-i18n-ag="har.cutoffLabel">Data de corte *</span><input id="closing-cutoff" type="date" required /><small data-i18n-ag="har.cutoffNote">Usa a data operacional; geração e registros usam instante auditável.</small></label><div class="closing-actions"><button id="consult-closing" class="secondary-button" type="button" data-i18n-ag="har.btn.consult">Consultar dados</button><button id="run-closing" class="secondary-button" type="button" data-i18n-ag="har.btn.runCheck">Executar conferência</button><button id="create-closing" class="primary-button" type="button" data-i18n-ag="har.btn.createVersion">Gerar versão</button><button id="export-closing" class="secondary-button" type="button" data-i18n-ag="har.btn.exportCsv">Exportar CSV</button></div></div></section>
  <p id="closing-message" role="status" aria-live="polite" data-i18n-ag="har.closingInitial">Selecione a safra e a data de corte para consultar.</p><div id="closing-summary" class="closing-summary" hidden><section aria-labelledby="closing-summary-title"><h3 id="closing-summary-title" data-i18n-ag="har.summary">Resumo</h3><p id="closing-scope-text"></p></section><section aria-labelledby="closing-indicators-title"><h3 id="closing-indicators-title" data-i18n-ag="har.indicators">Indicadores</h3><div id="closing-indicators" class="closing-indicators"></div></section><div class="closing-columns"><section><h3 data-i18n-ag="har.pending">Pendências</h3><div id="closing-issues"></div></section><section><h3 data-i18n-ag="har.history">Histórico</h3><div id="closing-versions"></div></section></div></div>
 </section>
 <section class="panel genealogy-panel" id="genealogy-panel" aria-labelledby="genealogy-title">
  <header class="panel-header">
   <div><span class="eyebrow" data-i18n-ag="har.genealogyEyebrow">Rastreabilidade integral</span><h2 id="genealogy-title" data-i18n-ag="har.genealogyTitle">Origem e destino · Genealogia</h2><p data-i18n-ag="har.genealogyDesc">Cadeia auditável da safra ao talhão, lote, beneficiamento, expedição e entrega.</p></div>
   <div class="genealogy-controls">
    <label><span data-i18n-ag="har.genealogy.seasonLabel">Safra</span>
     <span class="lookup-wrap">
      <input id="genealogy-season-search" class="lookup" data-lookup="crop-seasons" data-target="genealogy-season-id" autocomplete="off" data-i18n-ag-ph="har.genealogy.phSeason" placeholder="Selecione a safra" />
      <input id="genealogy-season-id" type="hidden" />
     </span>
    </label>
    <label><span data-i18n-ag="har.genealogy.lotLabel">Lote</span>
     <input id="genealogy-lot-search" type="text" data-i18n-ag-ph="har.genealogy.phLot" placeholder="ex.: LT-2026-001" autocomplete="off" />
    </label>
    <button id="search-genealogy" class="secondary-button" type="button" data-i18n-ag="har.genealogy.trace">Rastrear</button>
   </div>
  </header>
  <div id="genealogy-summary" class="genealogy-summary-cards" hidden>
   <article><small data-i18n-ag="har.card.reference">Referência</small><strong id="genealogy-target-label">—</strong></article>
   <article><small data-i18n-ag="har.card.chain">Cadeia</small><strong id="genealogy-chain-status">—</strong></article>
   <article><small data-i18n-ag="har.card.trackedStock">Estoque rastreado</small><strong id="genealogy-stock-label">—</strong></article>
   <article><small data-i18n-ag="har.card.recognizedRevenue">Receita reconhecida</small><strong id="genealogy-revenue-label">—</strong></article>
  </div>
  <p id="genealogy-status-message" role="status" aria-live="polite" data-i18n-ag="har.genealogy.initial">Selecione uma safra ou informe um lote para rastrear a genealogia.</p>
  <div class="table-scroll" id="genealogy-table-wrap" hidden>
   <table class="genealogy-table" aria-label="Elos da genealogia operacional" data-i18n-ag-aria="har.genealogy.tableAria">
    <thead>
     <tr>
      <th data-i18n-ag="har.col.stage">Estágio</th>
      <th data-i18n-ag="har.col.origin">Origem</th>
      <th data-i18n-ag="har.col.destination">Destino</th>
      <th data-i18n-ag="har.col.status">Status</th>
      <th data-i18n-ag="har.col.quantity">Quantidade</th>
      <th data-i18n-ag="har.col.lot">Lote</th>
      <th data-i18n-ag="har.col.date">Data</th>
      <th data-i18n-ag="har.col.details">Detalhes</th>
     </tr>
    </thead>
    <tbody id="genealogy-list"></tbody>
   </table>
  </div>
 </section>
 <section class="panel pending-panel" aria-labelledby="pending-title">
  <header class="panel-header"><div><span class="eyebrow" data-i18n-ag="har.pendingEyebrow">Central de direcionamento</span><h2 id="pending-title" data-i18n-ag="har.pendingTitle">Pendências operacionais</h2><p data-i18n-ag="har.pendingDesc">Aponta o impacto e direciona ao módulo responsável; nenhuma etapa é resolvida fora de sua origem.</p></div><button id="refresh-pendings" class="secondary-button" type="button" data-i18n-ag="har.pendingRefresh">Atualizar pendências</button></header>
  <p id="pending-status" role="status" aria-live="polite" data-i18n-ag="har.pendingLoading">Carregando pendências reais…</p>
  <div id="pending-list" class="pending-grid" aria-busy="true"></div>
 </section>
 <section class="harvest-kpis" id="harvest-kpis" aria-label="Indicadores" data-i18n-ag-aria="har.indicators"><article><small data-i18n-ag="har.kpi.planned">Planejado</small><strong>—</strong></article><article><small data-i18n-ag="har.kpi.harvested">Colhido</small><strong>—</strong></article><article><small data-i18n-ag="har.kpi.toReceive">A receber</small><strong>—</strong></article><article><small data-i18n-ag="har.kpi.awaitingQuality">Aguardando qualidade</small><strong>—</strong></article><article><small data-i18n-ag="har.kpi.approved">Aprovado</small><strong>—</strong></article><article><small data-i18n-ag="har.kpi.physicalLoss">Perdas físicas</small><strong>—</strong></article></section>
 <nav class="workflow-tabs" id="harvest-tabs" aria-label="Etapas da jornada" data-i18n-ag-aria="har.journeyTabsAria"><button class="active" data-step="plan" data-i18n-ag="har.tab.plan">1. Planejar</button><button data-step="record" data-i18n-ag="har.tab.record">2. Apontar</button><button data-step="receipt" data-i18n-ag="har.tab.receipt">3. Receber</button><button data-step="inspection" data-i18n-ag="har.tab.inspection">4. Classificar</button><button data-step="allocation" data-i18n-ag="har.tab.allocation">5. Destinar</button></nav>
 <section class="panel operation-panel"><header class="panel-header"><div><span class="eyebrow" data-i18n-ag="har.nextAction">Próxima ação</span><h2 id="harvest-form-title" data-i18n-ag="har.schema.plan.title">Planejar colheita</h2></div><span class="status-pill" data-i18n-ag="har.auditedData">Dados auditados no servidor</span></header><div id="harvest-error" class="validation-summary" role="alert" tabindex="-1" hidden></div>
  <form id="harvest-form" novalidate><input type="hidden" name="step" value="plan" /><div id="harvest-fields" class="harvest-form-grid"></div><div class="form-actions"><button type="reset" class="secondary-button" data-i18n-ag="har.clear">Limpar</button><button type="submit" class="primary-button"><span data-i18n-ag="har.savePlan">Salvar planejamento</span></button></div><p id="harvest-result" role="status" aria-live="polite"></p></form>
 </section>
 <section class="panel"><header class="panel-header"><div><span class="eyebrow" data-i18n-ag="har.historyEyebrow">Histórico operacional</span><h2 data-i18n-ag="har.relatedRecords">Registros relacionados</h2></div><label><span data-i18n-ag="har.filterStep">Filtrar etapa</span><select id="kind-filter"><option value="" data-i18n-ag="har.all">Todas</option><option>PLAN</option><option>HARVEST</option><option>RECEIPT</option></select></label></header><div class="table-scroll"><table><thead><tr><th data-i18n-ag="har.col.type">Tipo</th><th data-i18n-ag="har.col.reference">Referência</th><th data-i18n-ag="har.col.currentState">Estado atual</th><th data-i18n-ag="har.col.quantity">Quantidade</th><th data-i18n-ag="har.col.balance">Saldo / próxima ação</th><th data-i18n-ag="har.col.date">Data</th></tr></thead><tbody id="harvest-list"><tr><td colspan="6">Carregando…</td></tr></tbody></table></div></section>
</section>
@section Scripts { <script src="~/js/harvest.js" asp-append-version="true"></script> }
