@page
@model IndexModel
@{
    ViewData["Title"] = "Command Center";
}

<div class="page-content">
    <section class="page-heading">
        <div>
            <span class="eyebrow">Visão integrada da operação</span>
            <h1>Bom dia. <span>O campo está em movimento.</span></h1>
            <p id="dashboard-subtitle">Consolidando produção, rebanho, estoque e resultado.</p>
        </div>
        <div class="heading-actions">
            <button class="secondary-button" type="button" id="refresh-dashboard"><svg><use href="#i-chart" /></svg> Atualizar dados</button>
            <button class="primary-button" type="button" data-feature="quick-action"><svg><use href="#i-plus" /></svg> Nova operação</button>
        </div>
    </section>

    <section class="kpi-grid" aria-label="Indicadores principais">
        <article class="kpi-card accent-green">
            <div class="kpi-top"><span>Margem estimada</span><i>resultado</i></div>
            <strong id="kpi-margin" class="skeleton-value">R$ —</strong>
            <footer><span class="trend positive">visão corrente</span><small>recebíveis − custos</small></footer>
        </article>
        <article class="kpi-card">
            <div class="kpi-top"><span>Valor em estoque</span><i>estoque</i></div>
            <strong id="kpi-inventory" class="skeleton-value">R$ —</strong>
            <footer><span id="kpi-alerts" class="trend neutral">— alertas</span><small>custo médio</small></footer>
        </article>
        <article class="kpi-card">
            <div class="kpi-top"><span>Safras ativas</span><i>agricultura</i></div>
            <strong id="kpi-seasons" class="skeleton-value">—</strong>
            <footer><span id="kpi-area" class="trend positive">— ha</span><small>área gerenciada</small></footer>
        </article>
        <article class="kpi-card">
            <div class="kpi-top"><span>Rebanho ativo</span><i>pecuária</i></div>
            <strong id="kpi-animals" class="skeleton-value">—</strong>
            <footer><span id="kpi-farms" class="trend neutral">— fazendas</span><small>animais rastreados</small></footer>
        </article>
    </section>

    <section class="kpi-grid operational-kpis" aria-label="Indicadores da Sprint 6">
        <article class="kpi-card"><div class="kpi-top"><span>Compras abertas</span><i>compras</i></div><strong id="ops-open-purchases">—</strong><footer><small id="ops-awaiting">— aguardando aprovação</small></footer></article>
        <article class="kpi-card"><div class="kpi-top"><span>Alertas de estoque</span><i>insumos</i></div><strong id="ops-low-stock">—</strong><footer><small id="ops-expiring">— próximos do vencimento</small></footer></article>
        <article class="kpi-card"><div class="kpi-top"><span>Frota disponível</span><i>máquinas</i></div><strong id="ops-assets">—</strong><footer><small id="ops-maintenance">— em manutenção</small></footer></article>
        <article class="kpi-card"><div class="kpi-top"><span>Combustível no mês</span><i>litros</i></div><strong id="ops-fuel">—</strong><footer><small>consumo consolidado</small></footer></article>
    </section>

    <section class="panel agriculture-360" aria-labelledby="agriculture-title">
<header class="panel-header"><div><span class="eyebrow">Sprint 11 · decisão no campo</span><h2 id="agriculture-title">Agricultura 360</h2></div><a class="primary-button" href="/agriculture">Abrir módulo</a></header>
<nav class="livestock-modules" aria-label="Módulos agrícolas"><a href="/agriculture"><strong>Caderno de campo</strong><small>execução e custo</small></a><a href="/agriculture"><strong>Planejamento</strong><small>previsto × realizado</small></a><a href="/agriculture"><strong>Fitossanidade</strong><small>alertas críticos</small></a><a href="/agriculture"><strong>Ordens de serviço</strong><small>equipe e checklist</small></a></nav>
</section>

<section class="panel finance-360" aria-labelledby="finance-title">
        <header class="panel-header"><div><span class="eyebrow">Sprint 8 · gestão econômica</span><h2 id="finance-title">Financeiro Agro</h2></div><span class="live-badge"><i></i> previsto e realizado</span></header>
        <div class="finance-kpis" id="finance-kpis" aria-live="polite">
            <article><small>Saldo previsto</small><strong id="finance-expected">R$ —</strong></article><article><small>Saldo realizado</small><strong id="finance-actual">R$ —</strong></article><article><small>A pagar vencido</small><strong id="finance-overdue-pay">R$ —</strong></article><article><small>A receber vencido</small><strong id="finance-overdue-receive">R$ —</strong></article><article><small>Margem do mês</small><strong id="finance-margin">R$ —</strong></article>
        </div>
        <nav class="livestock-modules" aria-label="Módulos financeiros">
            <button data-feature="chart-accounts">▤<strong>Plano de contas</strong><small>estrutura gerencial</small></button><button data-feature="cost-centers">◎<strong>Centros de custo</strong><small>rateios do agro</small></button><button data-feature="payables">↗<strong>Contas a pagar</strong><small>baixas e vencimentos</small></button><button data-feature="receivables">↙<strong>Contas a receber</strong><small>parcelas e recebimentos</small></button><button data-feature="cash-flow">⌁<strong>Fluxo de caixa</strong><small>dia, mês e ano</small></button><button data-feature="economic-results">▥<strong>Resultados</strong><small>safra, talhão e rebanho</small></button>
        </nav>
    </section>

    <section class="panel storage-360" aria-labelledby="storage-title">
        <header class="panel-header"><div><span class="eyebrow">Sprint 9 · pós-colheita rastreável</span><h2 id="storage-title">Armazenagem &amp; Logística</h2></div><span class="live-badge"><i></i> capacidade em tempo real</span></header>
        <div class="finance-kpis" id="storage-kpis" aria-live="polite">
            <article><small>Capacidade total</small><strong id="storage-total">— t</strong></article><article><small>Ocupação</small><strong id="storage-occupied">— t</strong></article><article><small>Disponível</small><strong id="storage-available">— t</strong></article><article><small>Romaneios pendentes</small><strong id="storage-receipts">—</strong></article><article><small>Frete no mês</small><strong id="storage-freight">R$ —</strong></article>
        </div>
        <nav class="livestock-modules" aria-label="Módulos de armazenagem e logística">
            <button data-feature="storage-structures">▦<strong>Armazéns e silos</strong><small>capacidade e localização</small></button><button data-feature="storage-receipts">⚖<strong>Romaneios</strong><small>pesagem e qualidade</small></button><button data-feature="storage-quality">◇<strong>Qualidade</strong><small>laudos e descontos</small></button><button data-feature="storage-lots">▣<strong>Lotes</strong><small>saldo e rastreabilidade</small></button><button data-feature="storage-processing">♨<strong>Beneficiamento</strong><small>secagem e perdas</small></button><button data-feature="storage-shipments">⇥<strong>Expedição</strong><small>carregamento e baixa</small></button><button data-feature="storage-logistics">⌁<strong>Fretes</strong><small>viagens e ocorrências</small></button><button data-feature="storage-contracts">▤<strong>Contratos</strong><small>saldo a entregar</small></button>
        </nav>
        <p class="empty-row" id="storage-alerts" role="status">Entre para carregar alertas de capacidade e qualidade.</p>
    </section>

    <section class="panel traceability-360" aria-labelledby="traceability-title">
        <header class="panel-header"><div><span class="eyebrow">Sprint 10 · Amazônia conectada</span><h2 id="traceability-title">Rastreabilidade &amp; Rede Regional</h2></div><span class="live-badge"><i></i> ledger verificável</span></header>
        <div class="finance-kpis" aria-label="Indicadores de rastreabilidade"><article><small>Lotes rastreados</small><strong>origem → venda</strong></article><article><small>Conformidade</small><strong>tempo e temperatura</strong></article><article><small>Integridade</small><strong>hash encadeado</strong></article><article><small>Logística</small><strong>fluvial e vicinal</strong></article><article><small>Resultados</small><strong>split auditável</strong></article></div>
        <nav class="livestock-modules" aria-label="Módulos da Sprint 10">
          <button data-feature="traceability-lots">◉<strong>Rastreabilidade</strong><small>lotes e origem</small></button><button data-feature="lot-timeline">⌁<strong>Timeline do lote</strong><small>trilha completa</small></button><button data-feature="processing-compliance">♨<strong>Conformidade</strong><small>beneficiamento</small></button><button data-feature="immutable-ledger">◇<strong>Ledger</strong><small>integridade</small></button><button data-feature="certificates">▣<strong>Certificados</strong><small>consulta por QR</small></button><button data-feature="regional-routes">⇢<strong>Rotas regionais</strong><small>fluvial e vicinal</small></button><button data-feature="regional-trips">⌖<strong>Viagens</strong><small>janelas e ocorrências</small></button><button data-feature="sales-partners">◎<strong>Parceiros</strong><small>força distribuída</small></button><button data-feature="commissions">％<strong>Comissões</strong><small>regras vigentes</small></button><button data-feature="revenue-split">≋<strong>Split</strong><small>divisão de resultado</small></button>
        </nav>
    </section>

    <section class="panel livestock-360" aria-labelledby="livestock-title">
        <header class="panel-header"><div><span class="eyebrow">Sprint 7 · visão consolidada</span><h2 id="livestock-title">Pecuária 360</h2></div><span class="live-badge"><i></i> rebanho, pastos e produção</span></header>
        <div class="livestock-kpis" id="livestock-kpis" aria-live="polite"><p><span class="loading-ring"></span> Carregando indicadores zootécnicos...</p></div>
        <nav class="livestock-modules" aria-label="Módulos de pecuária">
          <button data-feature="animals">🐄<strong>Animais</strong><small>cadastro e histórico</small></button><button data-feature="herds">◉<strong>Lotes</strong><small>categorias e lotação</small></button><button data-feature="pastures">🌱<strong>Pastagens</strong><small>piquetes e alertas</small></button><button data-feature="handling">⚖<strong>Manejo</strong><small>pesagens e movimentos</small></button><button data-feature="health">✚<strong>Sanidade</strong><small>vacinas e carência</small></button><button data-feature="reproduction">♡<strong>Reprodução</strong><small>ciclos e partos</small></button><button data-feature="nutrition">◈<strong>Nutrição</strong><small>dietas e custos</small></button><button data-feature="production">◒<strong>Produção</strong><small>leite e ganho de peso</small></button>
        </nav>
    </section>

    <section class="command-grid">
        <article class="panel operations-panel">
            <header class="panel-header">
                <div><span class="eyebrow">Fluxo operacional</span><h2>Atividade recente</h2></div>
                <span class="live-badge"><i></i> dados autorizados</span>
            </header>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Operação</th><th>Módulo</th><th>Valor</th><th>Status</th><th>Horário</th></tr></thead>
                    <tbody id="recent-operations">
                        <tr class="empty-row"><td colspan="5"><span class="loading-ring"></span> Carregando operações...</td></tr>
                    </tbody>
                </table>
            </div>
        </article>

        <aside class="panel pulse-panel">
            <header class="panel-header"><div><span class="eyebrow">Pulso da operação</span><h2>Agro Pulse</h2></div><span class="ai-label">explicável</span></header>
            <div class="pulse-score"><div><strong id="pulse-score">—</strong><small>/100</small></div><span>Qualidade operacional</span></div>
            <div class="pulse-bars">
                <div><span>Dados de campo</span><i><b style="--value: 0%"></b></i><strong id="pulse-field">—</strong></div>
                <div><span>Estoque conciliado</span><i><b style="--value: 0%"></b></i><strong id="pulse-stock">—</strong></div>
                <div><span>Rastreabilidade</span><i><b style="--value: 0%"></b></i><strong id="pulse-trace">—</strong></div>
            </div>
            <div class="insight-card">
                <span>Leitura do sistema</span>
                <p id="pulse-insight">Conecte-se para gerar uma leitura baseada nos dados reais do tenant.</p>
                <small>Fonte: dados operacionais autorizados · sem execução automática</small>
            </div>
        </aside>
    </section>

    <section class="module-strip">
        <header class="panel-header"><div><span class="eyebrow">Atalhos inteligentes</span><h2>Continue de onde parou</h2></div></header>
        <div class="module-cards">
            <button type="button" data-feature="planting"><span class="module-icon"><svg><use href="#i-leaf" /></svg></span><div><strong>Registrar plantio</strong><small>Baixa estoque e gera custo</small></div><svg><use href="#i-arrow" /></svg></button>
            <button type="button" data-feature="weighing"><span class="module-icon"><svg><use href="#i-animal" /></svg></span><div><strong>Nova pesagem</strong><small>Calcula GMD automaticamente</small></div><svg><use href="#i-arrow" /></svg></button>
            <button type="button" data-feature="stock"><span class="module-icon"><svg><use href="#i-box" /></svg></span><div><strong>Entrada de estoque</strong><small>Lote, validade e custo médio</small></div><svg><use href="#i-arrow" /></svg></button>
            <button type="button" data-feature="sale"><span class="module-icon"><svg><use href="#i-coins" /></svg></span><div><strong>Confirmar venda</strong><small>Gera recebível e rastreio</small></div><svg><use href="#i-arrow" /></svg></button>
        </div>
    </section>
</div>
