@page "/intelligence"
@model Agro360.Web.Pages.Intelligence.IndexModel
@{ ViewData["Title"] = "Inteligência Agro360"; }
<link rel="stylesheet" href="~/css/intelligence.css" asp-append-version="true" />
<section class="intelligence-page" data-api="intelligence">
 <header><div><span class="eyebrow">Decisão operacional · dados rastreáveis</span><h1>Inteligência Agro360</h1><p>Riscos, recomendações e prioridades explicáveis para agir com segurança.</p></div><button class="primary-button" id="refresh-bi">Atualizar central</button></header>
 <form class="bi-filters" id="bi-filters"><label>Período inicial<input type="date" name="from" required /></label><label>Período final<input type="date" name="to" required /></label><label>Propriedade<select name="farmId" id="farm-filter"><option value="">Todas as propriedades</option></select></label><button type="submit">Aplicar filtros</button><span class="form-message" role="alert"></span></form>
 <nav class="bi-tabs" aria-label="Áreas de inteligência"><button data-panel="decision" class="active">Central de decisão</button><button data-panel="recommendations">Recomendações</button><button data-panel="scores">Scores</button><button data-panel="anomalies">Anomalias</button><button data-panel="priorities">Prioridades do Dia</button><button data-panel="rules">Motor de regras</button><button data-panel="assistant">Assistente</button><button data-panel="reports">Relatórios</button><button data-panel="alerts">Alertas</button><button data-panel="forecasts">Previsões</button><button data-panel="custom">Meus painéis</button></nav>
 <div id="bi-status" class="bi-status" role="status">Carregando indicadores…</div>
 <section id="decision" class="bi-panel active"><div id="decision-grid" class="indicator-grid"></div><h2>Top riscos operacionais</h2><div id="top-score-list" class="data-list"></div><h2>Impacto imediato</h2><div id="decision-priorities" class="data-list"></div><div id="indicator-grid" class="indicator-grid"></div><h2>Alertas existentes</h2><div id="risk-list" class="data-list"></div></section>
 <section id="recommendations" class="bi-panel"><div class="panel-heading"><div><h2>Recomendações</h2><p>Nenhuma recomendação altera a operação sem sua aprovação.</p></div><button type="button" data-export="recommendations">Exportar CSV</button></div><form class="intelligence-search" data-filter="recommendations"><input name="search" maxlength="120" placeholder="Buscar por motivo ou título" /><select name="severity"><option value="">Todas as severidades</option><option>CRITICAL</option><option>HIGH</option><option>ATTENTION</option><option>LOW</option></select><button>Filtrar</button></form><div id="recommendation-list" class="data-list"></div></section>
 <section id="scores" class="bi-panel"><h2>Scores de risco transparentes</h2><p>A faixa deriva de fatores observados e da versão da fórmula registrada.</p><div id="score-list" class="data-list"></div></section>
 <section id="anomalies" class="bi-panel"><h2>Anomalias</h2><p>Desvios estatísticos indicam risco; nunca são acusação de fraude.</p><div id="anomaly-list" class="data-list"></div></section>
 <section id="priorities" class="bi-panel"><h2>Prioridades do Dia</h2><p>Ordenação por prazo, severidade e impacto, somente dentro das suas permissões.</p><div id="priority-list" class="data-list"></div></section>
 <section id="rules" class="bi-panel"><h2>Motor de Regras Inteligentes</h2><form id="rule-form" class="rule-form"><label>Nome<input name="name" minlength="3" maxlength="160" required /></label><label>Módulo<select name="module" required><option value="">Selecione</option><option>Operacional</option><option>Comercial</option><option>Financeiro</option><option>Logística</option><option>Produção agrícola</option><option>Pecuária</option><option>Estoque</option><option>Qualidade</option><option>Compliance</option><option>Fiscal</option></select></label><label>Tipo<select name="type" required><option value="">Selecione</option><option>OPERATIONAL</option><option>COMMERCIAL</option><option>FINANCIAL</option><option>LOGISTICS</option><option>QUALITY</option></select></label><label>Severidade<select name="severity" required><option>ATTENTION</option><option>HIGH</option><option>CRITICAL</option><option>LOW</option></select></label><label>Peso<input name="weight" type="number" min="0.01" step="0.01" required /></label><label>Periodicidade (minutos)<input name="periodicityMinutes" type="number" min="1" value="1440" required /></label><label class="wide">Descrição<textarea name="description" maxlength="1000" required></textarea></label><label class="wide">Condição rastreável (JSON)<textarea name="conditionDefinition" required>{"metric":"","operator":">","threshold":0}</textarea></label><label class="wide">Ação sugerida<textarea name="suggestedAction" maxlength="1000" required></textarea></label><label class="check"><input name="active" type="checkbox" checked /> Regra ativa</label><button type="submit">Salvar regra</button><span class="form-message" role="alert"></span></form><div id="rule-list" class="data-list"></div></section>
 <section id="reports" class="bi-panel"><h2>Relatórios gerenciais</h2><form id="report-form"><label>Relatório<select id="report-select" required><option value="">Selecione pelo nome</option></select></label><label>Status<select id="report-status"><option value="">Todos</option><option>OPEN</option><option>COMPLETED</option><option>CANCELLED</option></select></label><button type="submit">Executar</button><button type="button" id="export-csv">Exportar CSV</button></form><div id="report-result" class="table-scroll"></div></section>
 <section id="alerts" class="bi-panel"><h2>Central de alertas</h2><div id="alert-list" class="data-list"></div></section>
 <section id="forecasts" class="bi-panel"><h2>Previsões transparentes</h2><div id="forecast-list" class="indicator-grid"></div></section>
 <section id="assistant" class="bi-panel"><h2>Agro360 Assistente</h2><p class="assistant-note">Busca guiada em dados reais do seu tenant. Nenhum provider externo é necessário e toda resposta indica seu módulo de origem.</p><form id="assistant-form"><label>Pergunta<select id="assistant-question" required><option value="">Selecione uma pergunta operacional</option><option>Quais contas vencem esta semana?</option><option>Quais itens estão abaixo do estoque mínimo?</option><option>Quais máquinas precisam de manutenção?</option><option>Quais lotes estão bloqueados?</option><option>Quais viagens estão em risco?</option></select></label><button type="submit">Consultar dados</button></form><div id="assistant-answer" class="assistant-answer"></div></section>
 <section id="custom" class="bi-panel"><h2>Dashboards personalizados</h2><form id="dashboard-form"><label>Nome<input name="name" maxlength="120" required /></label><label>Descrição<input name="description" maxlength="500" /></label><button type="submit">Criar painel</button></form><div id="dashboard-list" class="data-list"></div></section>
</section>
@section Scripts { <script src="~/js/intelligence.js" asp-append-version="true" defer></script> }
