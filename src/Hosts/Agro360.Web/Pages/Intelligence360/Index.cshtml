@page "/inteligencia-agro360"
@model Agro360.Web.Pages.Intelligence360.IndexModel
@{ ViewData["Title"] = "Inteligência Agro360 · Painel 360"; }
<link rel="stylesheet" href="~/css/intelligence360.css" asp-append-version="true" />
<main class="ix-shell" id="ix-app" data-api="/api/intelligence360">
 <header><div><span>DECISÃO BASEADA EM DADOS REAIS</span><h1>Inteligência Agro360</h1><p>Painel executivo, riscos, alertas e recomendações rastreáveis por tenant.</p></div><button id="ix-refresh">Atualizar painel</button></header>
 <nav aria-label="Visões executivas"><button class="active" data-view="panel">Painel 360</button><button data-view="indicators">Indicadores</button><button data-view="alerts">Central de Alertas</button><button data-view="rules">Motor de Regras</button><button data-view="risks">Radar de Riscos</button><button data-view="recommendations">Recomendações</button><button data-view="audit">Auditoria Transversal</button><button data-view="reports">Relatórios Executivos</button><button data-view="targets">Configurações de Metas</button></nav>
 <p id="ix-status" role="status">Consolidando fontes autorizadas…</p>
 <section id="panel" class="ix-view active"><div id="ix-summary" class="ix-grid"></div><h2>Indicadores calculados</h2><div id="ix-kpis" class="ix-grid"></div></section>
 <section id="indicators" class="ix-view"><div class="ix-heading"><div><h2>Motor de indicadores</h2><p>Fórmulas são avaliadas no backend; ausência de dados permanece indisponível.</p></div><button id="ix-new-kpi">Novo indicador</button></div><div id="ix-indicator-list" class="ix-empty">Use o Painel 360 para consultar os indicadores ativos.</div></section>
 <section id="alerts" class="ix-view"><h2>Central de Alertas</h2><div class="ix-empty">Alertas reais aparecerão aqui após avaliação de regras ativas.</div></section>
 <section id="rules" class="ix-view"><h2>Motor de Regras Gerenciais</h2><p>Condições parametrizadas; SQL livre não é aceito.</p><a href="/intelligence">Abrir configuração de regras</a></section>
 <section id="risks" class="ix-view"><h2>Radar de Riscos</h2><div class="ix-empty">Nenhum risco aberto para os filtros atuais.</div></section>
 <section id="recommendations" class="ix-view"><h2>Recomendações operacionais</h2><p class="ix-rule-note">Recomendações são geradas por regras transparentes do sistema, não por modelo externo, e nunca executam ações automaticamente.</p><div class="ix-empty">Nenhuma recomendação pendente.</div></section>
 <section id="audit" class="ix-view"><h2>Auditoria Transversal</h2><div class="ix-empty">Eventos críticos serão apresentados sem segredos ou dados sensíveis.</div></section>
 <section id="reports" class="ix-view"><h2>Relatórios Executivos</h2><div class="ix-reports"><a href="/api/intelligence360/reports/indicators.csv">Indicadores CSV</a><a href="/api/intelligence360/reports/alerts.csv">Alertas CSV</a><a href="/api/intelligence360/reports/risks.csv">Riscos CSV</a><a href="/api/intelligence360/reports/recommendations.csv">Recomendações CSV</a><a href="/api/intelligence360/reports/audit.csv">Auditoria CSV</a></div></section>
 <section id="targets" class="ix-view"><h2>Configurações de Metas</h2><p>Metas são decimais e percentuais aceitam somente valores entre 0 e 100.</p></section>
</main>
<dialog id="ix-kpi-dialog"><form id="ix-kpi-form"><header><h2>Novo indicador</h2><button type="button" data-close aria-label="Fechar">×</button></header><label>Nome<input name="name" minlength="3" maxlength="160" required /></label><label>Código interno<input name="code" pattern="[A-Z][A-Z0-9_]{2,59}" required /></label><label>Categoria<select name="category" required><option value="">Selecione</option>@foreach(var item in new[]{"FINANCE","PRODUCTION","INVENTORY","PROCUREMENT","SALES","EXPORT","FISCAL","LOGISTICS","QUALITY","COMPLIANCE","LIVESTOCK","AGRICULTURE","TRACEABILITY","SUSTAINABILITY","OPERATIONAL","STRATEGIC"}){<option value="@item">@item</option>}</select></label><label>Fonte de dados<select name="dataSource" required><option value="">Selecione uma integração</option>@foreach(var item in new[]{"FINANCE","PROCUREMENT","INVENTORY","PRODUCTION","QUALITY","EXPORT","FISCAL","LOGISTICS","COMPLIANCE","TRACEABILITY","AGRICULTURE","LIVESTOCK"}){<option>@item</option>}</select></label><label>Fórmula permitida<select name="formula" required><option value="SUM">Soma</option><option value="COUNT">Contagem</option><option value="AVERAGE">Média</option><option value="PERCENTAGE">Percentual</option></select></label><label>Periodicidade<select name="periodicity" required><option>DAILY</option><option>WEEKLY</option><option>MONTHLY</option></select></label><label>Unidade<select name="unit" required><option>NUMBER</option><option>CURRENCY</option><option>PERCENT</option></select></label><label>Meta<input name="target" type="number" step="0.01" /></label><p class="error" role="alert"></p><footer><button type="button" data-close>Cancelar</button><button type="submit">Salvar indicador</button></footer></form></dialog>
<script src="~/js/intelligence360.js" asp-append-version="true"></script>
