@page
@model Agro360.Web.Pages.Inventory.IndexModel
@{ ViewData["Title"]="Requisições internas de materiais"; }
@section Styles { <link rel="stylesheet" href="~/css/material-requests.css" asp-append-version="true" /> }
<div class="mr-shell"><nav class="breadcrumbs" aria-label="Navegação">Estoque e Almoxarifado / Operações</nav>
<nav class="stock-tabs" aria-label="Jornadas de estoque"><button type="button" data-stock-tab="requests">Requisições</button><button type="button" data-stock-tab="transfers">Transferências</button><button type="button" data-stock-tab="counts">Inventário físico</button></nav>
<div data-stock-panel="requests">
<header class="mr-hero"><div><span class="eyebrow">Materiais e consumo rastreável</span><h1>Requisições internas</h1><p>Solicite, aprove, reserve, entregue, consuma e devolva sem confundir cada fato operacional.</p></div><button class="primary-button" data-open="request-dialog">Nova requisição</button></header>
<details class="mr-help" open><summary>Como usar</summary><p><b>Pré-requisitos:</b> produto ativo, unidade, depósito e saldo liberado pela qualidade. Salve rascunho ou submeta; quando uma regra configurada exigir, a aprovação antecede a reserva. Reserva não baixa estoque. A entrega faz a saída física e o custo só é apropriado no consumo — exceto quando “consumo direto” estiver explicitamente marcado. Sobras boas retornam ao saldo; condição danificada ou desconhecida aguarda inspeção.</p></details>
<section class="mr-kpis" id="kpis" aria-live="polite"></section>
<form class="mr-filter" id="filter"><label>Buscar por número<input name="search" type="search"></label><label>Situação<select name="status"><option value="">Todas</option><option>DRAFT</option><option>AWAITING_APPROVAL</option><option>APPROVED</option><option>RESERVED</option><option>PARTIALLY_DELIVERED</option><option>DELIVERED</option><option>CANCELLED</option></select></label><button>Aplicar filtros</button></form>
<section class="mr-table" id="requests"><p>Carregando requisições…</p></section><section id="detail" class="mr-detail" hidden aria-live="polite"></section></div>
<dialog id="request-dialog"><form id="request-form"><header><h2>Nova requisição</h2><button type="button" data-close aria-label="Fechar">×</button></header><p>Campos com * são obrigatórios. Os seletores já respeitam o cliente autenticado.</p><div class="form-grid"><label>Unidade / propriedade *<select name="farmId" data-lookup="farms" required></select><small>Contexto operacional da solicitação.</small></label><label>Depósito pretendido<select name="warehouseId" data-lookup="warehouses"></select></label><label>Centro de custo<select name="costCenterId" data-lookup="cost-centers"></select></label><label>Finalidade *<select name="purpose" required><option value="">Selecione</option><option>AGRICULTURE</option><option>MAINTENANCE</option><option>PRODUCTION</option><option>OPERATION</option><option>TRANSFER</option></select></label><label>Data necessária *<input name="neededOn" type="date" required></label><label>Prioridade *<select name="priority" required><option>MEDIUM</option><option>LOW</option><option>HIGH</option><option>URGENT</option></select></label><label class="wide">Justificativa da urgência<textarea name="urgencyReason" maxlength="1000"></textarea></label><label>Produto ativo *<select name="productId" data-lookup="products" required></select></label><label>Quantidade *<input name="quantity" type="number" min="0.001" step="0.001" required></label><label>Unidade *<input name="unit" readonly required></label><label class="wide">Observações<textarea name="notes" maxlength="2000"></textarea></label></div><div class="actions"><button name="mode" value="draft">Salvar rascunho</button><button class="primary-button" name="mode" value="submit">Submeter requisição</button></div><p class="form-message" role="alert"></p></form></dialog>
<dialog id="action-dialog"><form id="action-form"><header><h2 data-title>Executar etapa</h2><button type="button" data-close>×</button></header><p data-effect></p><input type="hidden" name="requestId"><input type="hidden" name="itemId"><input type="hidden" name="deliveryId"><input type="hidden" name="version"><input type="hidden" name="action"><div class="form-grid" data-fields></div><button class="primary-button">Confirmar operação</button><p class="form-message" role="alert"></p></form></dialog>
</div>
<section data-stock-panel="transfers" hidden><header class="mr-hero"><div><span class="eyebrow">Custódia entre depósitos</span><h1>Transferências</h1><p>Acompanhe separação, trânsito, recebimentos parciais e divergências.</p></div><button class="primary-button" data-open="transfer-dialog">Nova transferência</button></header><details class="mr-help" open><summary>Como usar</summary><p><b>Pré-requisitos:</b> depósitos distintos da mesma unidade, produto e lote cadastrados, saldo livre e permissão nos depósitos. Crie a transferência, confira os itens, confirme a expedição e registre cada conferência no destino. A expedição retira o saldo da origem e o mantém em trânsito; recebimentos parciais não encerram a operação. Avaria e bloqueio geram ocorrência e não liberam saldo.</p></details><form class="mr-filter" data-filter="transfers"><label>Situação<select name="status"><option value="">Todas</option><option>AWAITING_SHIPMENT</option><option>IN_TRANSIT</option><option>PARTIALLY_RECEIVED</option><option>RECEIVED</option><option>CANCELLED</option></select></label><button>Aplicar filtros</button></form><div id="transfer-list" class="mr-table" aria-live="polite"></div><div id="transfer-detail" class="mr-detail" hidden></div></section>
<section data-stock-panel="counts" hidden><header class="mr-hero"><div><span class="eyebrow">Saldo registrado × realidade física</span><h1>Inventário físico</h1><p>Planeje contagens parciais, preserve recontagens e aprove ajustes rastreáveis.</p></div><button class="primary-button" data-open="count-dialog">Planejar inventário</button></header><details class="mr-help" open><summary>Como usar</summary><p><b>Pré-requisitos:</b> depósito e responsável definidos. Ao abrir, o sistema fotografa o saldo e bloqueia todas as movimentações do escopo. Campo vazio permanece “não contado”; digite zero para confirmar ausência física. Reconcilie escolhendo uma contagem, solicite recontagem quando necessário e só então aprove os ajustes. Reservas insuficientes e valorização ausente viram pendências explícitas.</p></details><form class="mr-filter" data-filter="counts"><label>Situação<select name="status"><option value="">Todas</option><option>PLANNED</option><option>COUNTING</option><option>RECONCILING</option><option>COMPLETED</option></select></label><button>Aplicar filtros</button></form><div id="count-list" class="mr-table" aria-live="polite"></div><div id="count-detail" class="mr-detail" hidden></div></section>
<dialog id="transfer-dialog"><form id="transfer-form"><header><h2>Nova transferência</h2><button type="button" data-close aria-label="Fechar">×</button></header><div class="form-grid"><label>Unidade / propriedade *<select name="farmId" data-ops-lookup="farms" required></select></label><label>Depósito de origem *<select name="sourceWarehouseId" data-ops-lookup="warehouses" required></select></label><label>Depósito de destino *<select name="destinationWarehouseId" data-ops-lookup="warehouses" required></select></label><label>Responsável *<select name="responsibleId" data-ops-lookup="people" required></select></label><label>Data prevista *<input type="date" name="expectedOn" required></label><label>Produto *<select name="productId" data-ops-lookup="products" required></select></label><label>Lote<input name="lotNumber" maxlength="100"></label><label>Quantidade *<input name="quantity" type="number" min="0.000001" step="0.001" required></label><label>Unidade *<input name="unit" readonly required></label><label class="wide">Justificativa *<textarea name="justification" minlength="5" maxlength="1000" required></textarea></label></div><button class="primary-button">Criar e aguardar expedição</button><p class="form-message" role="alert"></p></form></dialog>
<dialog id="count-dialog"><form id="count-form"><header><h2>Planejar inventário</h2><button type="button" data-close aria-label="Fechar">×</button></header><div class="form-grid"><label>Depósito *<select name="warehouseId" data-ops-lookup="warehouses" required></select></label><label>Responsável *<select name="responsibleId" data-ops-lookup="people" required></select></label><label>Produto (opcional)<select name="productId" data-ops-lookup="products"></select></label><label>Categoria<input name="category" maxlength="60"></label><label>Lote<input name="lotNumber" maxlength="100"></label><label class="check"><input type="checkbox" name="blind"> Contagem cega</label></div><p>A política desta versão é bloqueio de movimentações no escopo durante toda a contagem.</p><button class="primary-button">Planejar</button><p class="form-message" role="alert"></p></form></dialog>
<dialog id="stock-action-dialog"><form id="stock-action-form"><header><h2 data-title>Confirmar operação</h2><button type="button" data-close aria-label="Fechar">×</button></header><p data-effect></p><div data-fields class="form-grid"></div><button class="primary-button">Confirmar</button><p class="form-message" role="alert"></p></form></dialog>
</div>
@section Scripts { <script src="~/js/material-requests.js" asp-append-version="true"></script><script src="~/js/stock-control.js" asp-append-version="true"></script> }
