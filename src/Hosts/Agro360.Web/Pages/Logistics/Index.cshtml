@page "/logistics"
@model Agro360.Web.Pages.Logistics.IndexModel
@{
    ViewData["Title"] = "Expedição e Entrega";
    ViewData["Breadcrumb"] = "Logística / Retornos";
}
@section Styles { <link rel="stylesheet" href="~/css/logistics.css" asp-append-version="true" /> }
<section class="page-content logistics-page" id="logistics-app">
 <header class="page-heading"><div><span class="eyebrow">Jornada ponta a ponta</span><h1>Expedição e <span>entrega</span></h1><p>Do pedido aprovado à reconciliação da entrega, sem confundir reserva, saída física, aceite, faturamento e pagamento.</p></div><button class="secondary-button" id="refresh-logistics" type="button">Atualizar</button></header>
 <details class="screen-help contextual-help" id="logistics-screen-help" open><summary>Como funciona esta tela</summary><div><p><strong>Finalidade:</strong> priorizar pedidos, acompanhar separação, viagens, tentativas e retornos.</p><p><strong>Pré-requisitos:</strong> pedido aprovado, saldo e lote liberado, unidade compatível e permissão logística.</p><p><strong>Sequência:</strong> filtre a fila → reserve e confira → confirme a saída → vincule a viagem → registre cada tentativa → receba e avalie retornos.</p><p><strong>Devoluções e Qualidade:</strong> O recebimento físico deixa o retorno em AWAITING_QUALITY e aciona a inspeção de qualidade. A destinação final (RELEASE, BLOCK ou DISPOSE) é obrigatória. Laudo CONFORMING não libera o lote sozinho; inspeções NON_CONFORMING, INCONCLUSIVE, AMBIGUOUS ou PENDING_MODEL bloqueiam RELEASE. Descartes (DISPOSE) registram perda física com quantidade, unidade e motivo obrigatório, com custo opcional e sem gerar faturamento ou duplicidades.</p><p><strong>Resultado:</strong> encerre somente quando toda quantidade estiver entregue, retornada, perdida com justificativa ou reconciliada de forma autorizada.</p></div></details>
 <nav class="journey-nav" aria-label="Etapas da expedição"><button data-view="overview" class="active">Visão geral</button><button data-view="queue">Pedidos a expedir</button><button data-view="picking">Separação</button><button data-view="shipments">Expedições</button><button data-view="trips">Viagens</button><button data-view="deliveries">Entregas</button><button data-view="returns">Retornos</button><button data-view="costs">Custos</button><button data-view="reports">Relatórios</button></nav>
 <div class="logistics-indicators" id="logistics-indicators" aria-live="polite"><p>Carregando indicadores…</p></div>
 <form class="toolbar" id="queue-filters"><label>Número comercial<input name="number" type="search" maxlength="40" placeholder="Ex.: PED-1024" /></label><label>Cliente<input name="customer" type="search" maxlength="160" /></label><label>Prazo até<input name="dueUntil" type="date" /></label><label>Situação<select name="status"><option value="">Todas aptas</option><option>APPROVED</option><option>FULFILLMENT</option></select></label><input name="page" type="hidden" value="1" /><input name="pageSize" type="hidden" value="20" /><button class="primary-button" type="submit">Aplicar filtros</button></form>
 <section class="panel" id="logistics-content" aria-live="polite"><p class="empty-state">Carregando fila operacional…</p></section>
 <dialog id="trace-dialog" aria-labelledby="trace-title"><header><h2 id="trace-title">Rastreabilidade operacional</h2><button type="button" data-close aria-label="Fechar">×</button></header><div id="trace-content"></div><button class="secondary-button" type="button" data-close>Fechar</button></dialog>
 <dialog id="return-disposition-dialog" class="action-dialog" aria-labelledby="disposition-title">
     <form method="dialog" id="return-disposition-form">
         <header><h2 id="disposition-title">Destinação de Retorno</h2><button type="button" data-close aria-label="Fechar">×</button></header>
         <div class="dialog-body">
             <p id="disposition-item-info">Selecione o destino físico do material recebido.</p>
             <label>Decisão de Destinação <span aria-hidden="true">*</span>
                 <select id="disposition-decision" required>
                     <option value="RELEASE">Liberar para estoque (RELEASE)</option>
                     <option value="BLOCK">Manter em quarentena / bloqueado (BLOCK)</option>
                     <option value="DISPOSE">Descartar / Registrar perda (DISPOSE)</option>
                 </select>
             </label>
             <label>Quantidade a destinar <span aria-hidden="true">*</span>
                 <input type="number" id="disposition-quantity" step="0.0001" min="0.0001" required />
             </label>
             <div id="disposition-loss-fields" hidden>
                 <label>Unidade da perda <span aria-hidden="true">*</span>
                     <input type="text" id="disposition-unit" maxlength="20" placeholder="Ex: kg, un, sc" />
                 </label>
                 <label>Custo estimado da perda (opcional)
                     <input type="number" id="disposition-cost" step="0.01" min="0" placeholder="0.00" />
                     <small>Registrado sem emitir títulos fiscais ou duplicatas a pagar.</small>
                 </label>
             </div>
             <div class="form-actions">
                 <button type="button" class="secondary-button" data-close>Cancelar</button>
                 <button type="submit" class="primary-button" id="disposition-proceed-btn">Prosseguir para Justificativa</button>
             </div>
         </div>
     </form>
 </dialog>
</section>
@section Scripts { <script src="~/js/logistics.js" asp-append-version="true"></script> }
