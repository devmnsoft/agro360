@page
@model Agro360.Web.Pages.Maps.IndexModel
@{ ViewData["Title"]="Mapa Agro"; }
<section class="map-shell" data-map-app>
 <header class="map-heading"><div><p class="eyebrow">Sprint 17 · território conectado</p><h1>Mapa Agro</h1><p>Geometrias, operação, logística e alertas em uma visão sem dependência de token externo.</p></div><div id="map-status" role="status" aria-live="polite">Carregando camadas…</div></header>
 <nav class="tabs map-tabs" aria-label="Telas geoespaciais">
 @foreach(var tab in new[]{("map","Mapa operacional"),("layers","Camadas do mapa"),("property","Propriedade"),("field","Talhão"),("pasture","Pastagem / piquete"),("zones","Zonas de manejo"),("occurrences","Ocorrências"),("imports","Importar GeoJSON"),("exports","Exportar GeoJSON"),("routes","Rotas regionais"),("territory","Monitoramento territorial"),("dashboard","Dashboard")}) { <button type="button" data-view="@tab.Item1">@tab.Item2</button> }
 </nav>
 <div class="map-toolbar"><label>Filtrar camada<select id="layer-filter"><option value="">Todas</option><option value="PROPERTY">Propriedades</option><option value="FIELD">Talhões / culturas</option><option value="PASTURE">Pastagens / animais</option><option value="ROUTE">Rotas / logística</option><option value="OCCURRENCE">Ocorrências / alertas</option><option value="WAREHOUSE">Armazenagem</option></select></label><label>Status<select id="status-filter"><option value="">Todos</option><option>ACTIVE</option><option>BLOCKED</option><option>RESOLVED</option></select></label><button class="primary-button" id="reload-map" type="button">Atualizar</button></div>
 <section data-panel="map" class="map-panel"><div id="offline-map" class="offline-map" aria-label="Mapa vetorial operacional"><svg viewBox="0 0 900 480" role="img"><defs><pattern id="grid" width="45" height="45" patternUnits="userSpaceOnUse"><path d="M45 0H0V45" fill="none" stroke="currentColor" opacity=".12"/></pattern></defs><rect width="900" height="480" fill="url(#grid)"/><path d="M80 360 180 95l250 25 105 105-75 185-260 20Z" class="map-property"/><path d="m180 95 55 160 225 155M235 255l300-30" class="map-boundary"/><path d="M20 420C280 350 560 470 880 170" class="map-route"/><g id="feature-layer"></g></svg><p class="map-fallback">Mapa vetorial local · disponível mesmo sem internet</p></div><aside id="map-legend" class="cards"><p class="empty">Nenhuma camada carregada.</p></aside></section>
 <section data-panel="layers" hidden><h2>Camadas selecionáveis</h2><div id="layer-list" class="cards"><p class="empty">Carregando…</p></div></section>
 <section data-panel="property" hidden><h2>Editar propriedade no mapa</h2><form class="geo-form" data-entity="PROPERTY"><label>Nome<input name="name" maxlength="180" required></label><label>Status<select name="status" required><option>ACTIVE</option><option>DRAFT</option><option>INACTIVE</option></select></label><label>Área informada (ha)<input name="informedAreaHa" type="number" min="0.0001" step="0.0001"></label><label class="wide">Polígono GeoJSON<textarea name="geoJson" required>{"type":"Polygon","coordinates":[[[-48.5,-1.5],[-48.4,-1.5],[-48.4,-1.4],[-48.5,-1.5]]]}</textarea></label><button class="primary-button" type="submit">Salvar propriedade</button></form></section>
 <section data-panel="field" hidden><h2>Editar talhão no mapa</h2><div data-feature-form="FIELD"></div></section>
 <section data-panel="pasture" hidden><h2>Editar pastagem ou piquete</h2><div data-feature-form="PASTURE"></div></section>
 <section data-panel="zones" hidden><h2>Zonas de manejo</h2><p>Produtividade, solo, aplicação, irrigação, pragas, sanidade, relevo e risco ambiental.</p><div data-feature-form="MANAGEMENT_ZONE"></div></section>
 <section data-panel="occurrences" hidden><h2>Ocorrências geolocalizadas</h2><form id="occurrence-form" class="geo-form"><label>Descrição<input name="name" maxlength="180" required></label><label>Tipo<select name="type" required><option value="">Selecione</option><option>PEST</option><option>DISEASE</option><option>EROSION</option><option>FLOODING</option><option>BROKEN_FENCE</option><option>ENVIRONMENTAL_RISK</option></select></label><label>Severidade<select name="severity" required><option>LOW</option><option>MEDIUM</option><option>HIGH</option><option>CRITICAL</option></select></label><label>Responsável<select name="responsibleId" data-lookup="users" required><option value="">Pesquise e selecione</option></select></label><label class="wide">Localização GeoJSON<input name="geoJson" value='{"type":"Point","coordinates":[-48.49,-1.45]}' required></label><button class="primary-button" type="submit">Registrar ocorrência</button></form></section>
 <section data-panel="imports" hidden><h2>Importação GeoJSON</h2><form id="import-form" class="geo-form"><label>Destino<select name="entityType" required><option>PROPERTY</option><option>FIELD</option><option>PASTURE</option><option>MANAGEMENT_ZONE</option></select></label><label>Arquivo<input id="geo-file" name="file" type="file" accept=".geojson,application/geo+json,application/json" required></label><label><input name="confirm" type="checkbox"> Confirmar gravação após validação integral</label><button class="primary-button" type="submit">Validar arquivo</button></form><div id="import-review" class="cards empty">Selecione um arquivo para revisão.</div></section>
 <section data-panel="exports" hidden><h2>Exportação GeoJSON</h2><p>Exporte uma FeatureCollection com dados reais do tenant e filtros ativos.</p><button id="export-button" class="primary-button" type="button">Baixar GeoJSON</button></section>
 <section data-panel="routes" hidden><h2>Rotas regionais no mapa</h2><p>Trechos fluviais, vicinais, balsas, coleta e entrega. Interdições exigem autorização.</p><div data-feature-form="ROUTE"></div></section>
 <section data-panel="territory" hidden><h2>Monitoramento territorial</h2><div class="cards"><article><h3>Áreas preservadas, APP e reserva legal</h3><p>Indicadores usam somente áreas informadas ou calculadas cadastradas.</p></article><article><h3>Produtivas, degradadas e recuperação</h3><p>Sem geometria ou área cadastrada, o painel informa ausência de dados.</p></article><article><h3>Risco, certificações e ESG</h3><p>Alertas territoriais mantêm origem e auditoria.</p></article></div></section>
 <section data-panel="dashboard" hidden><h2>Dashboard geoespacial</h2><div id="geo-dashboard" class="cards"><p class="empty">Carregando indicadores…</p></div></section>
</section>
@section Scripts { <script src="~/js/maps.js" asp-append-version="true"></script> }
