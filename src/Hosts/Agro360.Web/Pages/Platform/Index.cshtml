@page "/platform"
@model Agro360.Web.Pages.Platform.PlatformModel
@{ ViewData["Title"]="Administração Global MNSOFT"; }
<link rel="stylesheet" href="~/css/saas.css" asp-append-version="true" />
<section class="saas-page" data-console="global"><header><div><span class="eyebrow">Agro360 Enterprise · MNSOFT</span><h1>Administração Global MNSOFT</h1><p>Super administração da plataforma: organizações, planos, cobranças, feature flags, auditoria e uso.</p></div><div class="saas-toolbar"><label for="saas-culture">Idioma</label><select id="saas-culture" aria-label="Idioma"><option value="pt-BR">Português</option><option value="en-US">English</option><option value="es-ES">Español</option><option value="fr-FR">Français</option></select><button id="saas-refresh" class="primary-button">Atualizar</button></div></header>
<nav class="saas-tabs" aria-label="Módulos da administração global"><button class="active" data-view="dashboard" data-global="true">Dashboard global</button><button data-view="tenants" data-global="true">Organizações</button><button data-view="plans" data-global="true">Planos</button><button data-view="billing" data-global="true">Cobranças</button><button data-view="features" data-global="true">Feature flags</button><button data-view="audit" data-global="true">Auditoria geral</button><button data-view="usage" data-global="true">Uso e limites</button></nav>
<details class="contextual-help"><summary>Como funciona esta tela</summary><p id="saas-help">Consulte os indicadores globais. Ações administrativas exigem super administração da plataforma MNSOFT e ficam registradas na auditoria.</p></details>
<div id="saas-status" role="status">Carregando dados…</div><main id="saas-content" aria-live="polite" aria-busy="true"></main>
<dialog id="saas-dialog"><form id="saas-form" method="dialog"><h2 id="dialog-title">cadastro</h2><div id="dialog-fields"></div><p class="form-message" role="alert"></p><footer><button value="cancel">Cancelar</button><button class="primary-button" value="default">Salvar</button></footer></form></dialog></section>
@section Scripts { <script src="~/js/saas.js" asp-append-version="true" defer></script> }
