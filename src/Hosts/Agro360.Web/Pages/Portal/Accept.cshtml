@page
@{Layout="_PortalLayout";ViewData["Title"]="Ativar acesso";}
<section class="flow-page"><a class="back" href="/Portal/Login">← Voltar ao login</a><form id="portal-accept" class="portal-form flow-card"><span class="step">PRIMEIRO ACESSO · ETAPA ÚNICA</span><h1>Ative seu acesso com segurança</h1><p>Crie uma senha pessoal para acessar somente as informações autorizadas pela organização.</p><label>Código do convite<input name="token" required autocomplete="one-time-code" minlength="32" value="@Request.Query["token"]"></label><label>Nova senha<input name="password" type="password" autocomplete="new-password" required minlength="12" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{12,}" aria-describedby="password-help"></label><small id="password-help">Use 12 caracteres ou mais, com maiúscula, minúscula, número e símbolo.</small><label class="check"><input name="acceptTerms" type="checkbox" required> Li e aceito os termos de uso e a política de privacidade.</label><div class="form-feedback" role="status"></div><button class="primary" type="submit">Ativar e acessar</button></form></section>
