@page
@{Layout="_PortalLayout";ViewData["Title"]="Marketplace";}
<section id="portal-marketplace"><div class="portal-hero"><div><span class="eyebrow">MARKETPLACE AGRO360</span><h1>Origem confiável. Negócios transparentes.</h1><p>Consulte somente lotes com disponibilidade real e solicite uma condição comercial.</p></div></div><form class="filters" id="marketplace-filter"><label>Produto ou cultura<input name="search" type="search" maxlength="100" placeholder="Buscar no catálogo"></label><label>Região<input name="region" maxlength="120"></label><label>Preço máximo<input name="maximumPrice" type="number" min="0.01" step="0.01"></label><button class="secondary" type="submit">Aplicar filtros</button></form><div class="listing-grid" data-listings><div class="empty">Carregando ofertas disponíveis…</div></div><dialog id="quote-dialog"><form id="quote-form" class="portal-form"><button class="dialog-close" type="button" aria-label="Fechar">×</button><span class="eyebrow">SOLICITAR COTAÇÃO</span><h2 data-quote-title>Condição comercial</h2><input name="listingId" type="hidden"><label>Quantidade<input name="quantity" type="number" min="0.0001" step="0.0001" required></label><label>Seu nome<input name="contactName" required maxlength="160"></label><label>E-mail<input name="contactEmail" type="email" required maxlength="254"></label><label>Observações<textarea name="notes" maxlength="1000"></textarea></label><div class="form-feedback" role="status"></div><button class="primary" type="submit">Enviar solicitação</button></form></dialog></section>
