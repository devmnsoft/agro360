@page
@{Layout="_PortalLayout";ViewData["Title"]="Solicitações";}
<section id="portal-requests"><div class="portal-hero"><div><span class="eyebrow">CENTRAL DE ATENDIMENTO</span><h1>Solicitações</h1><p>Converse com a organização e acompanhe cada etapa.</p></div><button class="primary" data-open-request>Nova solicitação</button></div><div class="request-list" data-requests><div class="empty">Carregando solicitações…</div></div><dialog id="request-dialog"><form id="request-form" class="portal-form"><button class="dialog-close" type="button" aria-label="Fechar">×</button><h2>Como podemos ajudar?</h2><label>Tipo<select name="type" required><option value="">Selecione</option><option value="COMMERCIAL_QUESTION">Dúvida comercial</option><option value="DOCUMENT">Solicitação de documento</option><option value="CERTIFICATE">Solicitação de certificado</option><option value="DELIVERY_ISSUE">Problema na entrega</option><option value="ORDER_DIVERGENCE">Divergência de pedido</option><option value="REGISTRATION_UPDATE">Atualização cadastral</option><option value="QUOTE">Solicitação de cotação</option><option value="COMPLIANCE">Compliance/documentação</option><option value="OTHER">Outro</option></select></label><label>Assunto<input name="subject" required maxlength="160"></label><label>Descrição<textarea name="description" required minlength="10" maxlength="4000" rows="5"></textarea></label><label>Prioridade<select name="priority" required><option value="LOW">Baixa</option><option value="MEDIUM" selected>Normal</option><option value="HIGH">Alta</option><option value="CRITICAL">Crítica</option></select></label><div class="form-feedback" role="status"></div><button class="primary" type="submit">Enviar solicitação</button></form></dialog></section>
