@page
@model Agro360.Web.Pages.Procurement.IndexModel
@{ ViewData["Title"]="Compras e Suprimentos"; }
@section Styles { <link rel="stylesheet" href="~/css/procurement.css" asp-append-version="true" /> }
<main class="procurement-shell">
 <header class="procurement-hero"><div><span class="eyebrow" data-i18n-pr="heroEyebrow">Cadeia de suprimentos</span><h1><span data-i18n-pr="heroTitleA">Compras</span> <em>&amp;</em> <span data-i18n-pr="heroTitleB">Suprimentos</span></h1><p data-i18n-pr="heroSubtitle">Da necessidade ao recebimento, com alçada, evidência e rastreabilidade por unidade operacional.</p></div><button id="proc-refresh" class="proc-primary" data-i18n-pr="refresh">Atualizar indicadores</button></header>
 <section id="proc-kpis" class="proc-kpis" aria-live="polite"><div class="proc-loading" data-i18n-pr="kpiLoading">Carregando indicadores reais…</div></section>
 <nav class="proc-tabs" aria-label="Áreas de compras" data-i18n-aria="navAria"><button data-tab="suppliers" class="active" data-i18n-pr="tabSuppliers">Fornecedores</button><button data-tab="catalog" data-i18n-pr="tabCatalog">Catálogo</button><button data-tab="requisitions" data-i18n-pr="tabRequisitions">Requisições</button><button data-tab="approvals" data-i18n-pr="tabApprovals">Aprovações</button><button data-tab="quotations" data-i18n-pr="tabQuotations">Cotações</button><button data-tab="orders" data-i18n-pr="tabOrders">Pedidos</button><button data-tab="receipts" data-i18n-pr="tabReceipts">Recebimentos</button><button data-tab="supplier-returns" data-i18n-pr="tabReturns">Devoluções ao fornecedor</button><button data-tab="invoice-matches" data-i18n-pr="tabMatches">Conferência e divergências</button><button data-tab="reports" data-i18n-pr="tabReports">Relatórios</button></nav>
 <section class="proc-panel active" id="suppliers"><header><div><h2 data-i18n-pr="suppliersTitle">Fornecedores e homologação</h2><p data-i18n-pr="suppliersDesc">Cadastro, risco e validade documental.</p></div><button data-dialog="supplier-dialog" class="proc-primary" data-i18n-pr="newSupplier">Novo fornecedor</button></header><form class="proc-filter" data-list="suppliers"><input name="search" type="search" placeholder="Buscar razão social ou fantasia" data-i18n-ph="phSupplierSearch"><select name="status"><option value="" data-i18n-pr="allStatuses">Todos os status</option><option>ACTIVE</option><option>APPROVED</option><option>UNDER_REVIEW</option><option>BLOCKED</option><option>INACTIVE</option></select><button data-i18n-pr="filterBtn">Filtrar</button><a href="/api/procurement/reports/suppliers.csv" data-i18n-pr="exportCsv">Exportar CSV</a></form><div class="proc-table" data-content="suppliers"></div></section>
 <section class="proc-panel" id="catalog"><header><div><h2 data-i18n-pr="catalogTitle">Catálogo comprável</h2><p data-i18n-pr="catalogDesc">Materiais, serviços e ativos com requisitos de recebimento.</p></div><button data-dialog="catalog-dialog" class="proc-primary" data-i18n-pr="newItem">Novo item</button></header><form class="proc-filter" data-list="catalog"><input name="search" type="search" placeholder="Buscar item ou código" data-i18n-ph="phCatalogSearch"><select name="status"><option value="" data-i18n-pr="activeInactive">Ativos e inativos</option><option>ACTIVE</option><option>INACTIVE</option></select><button data-i18n-pr="filterBtn">Filtrar</button></form><div class="proc-table" data-content="catalog"></div></section>
 <section class="proc-panel" id="requisitions"><header><div><h2 data-i18n-pr="reqsTitle">Requisições internas</h2><p data-i18n-pr="reqsDesc">Necessidades operacionais com prioridade e centro de custo.</p></div><button data-dialog="requisition-dialog" class="proc-primary" data-i18n-pr="newReq">Nova requisição</button></header><details class="proc-help"><summary data-i18n-pr="reqHelpSummary">Fluxo e responsabilidades</summary><p data-i18n-pr="reqHelpBody">Salve em rascunho para revisar ou envie à aprovação. Após o envio, rejeitar e cancelar exige justificativa; o solicitante não pode aprovar a própria demanda. Pedidos consomem somente o saldo aprovado.</p></details><form class="proc-filter" data-list="requisitions"><input name="search" type="search" placeholder="Buscar número" data-i18n-ph="phReqSearch"><select name="status"><option value="" data-i18n-pr="allOpt">Todos</option><option>DRAFT</option><option>AWAITING_APPROVAL</option><option>APPROVED</option><option>PARTIALLY_FULFILLED</option><option>CONVERTED</option><option>CANCELLED</option></select><button data-i18n-pr="filterBtn">Filtrar</button><a href="/api/procurement/reports/requisitions.csv" data-i18n-pr="exportCsv">Exportar CSV</a></form><div class="proc-table" data-content="requisitions"></div></section>
 <section class="proc-panel" id="approvals"><header><div><h2 data-i18n-pr="approvalsTitle">Aprovações</h2><p data-i18n-pr="approvalsDesc">Fila real de decisões de alçada: requisições enviadas e pedidos criados aguardando aprovação.</p></div></header><div class="proc-table" data-content="approvals"></div></section>
 <section class="proc-panel" id="quotations"><header><div><h2 data-i18n-pr="quotTitle">Cotações</h2><p data-i18n-pr="quotDesc">Participantes, propostas registradas e conversão auditável para pedido.</p></div><button data-dialog="quotation-request-dialog" class="proc-primary" data-i18n-pr="newQuotation">Nova cotação</button></header><details class="proc-help"><summary data-i18n-pr="quotHelpSummary">Jornada da cotação</summary><p data-i18n-pr="quotHelpBody"><b>Fluxo:</b> abra a cotação a partir de uma requisição aprovada com ao menos dois fornecedores participantes, registre as propostas reais recebidas de cada fornecedor, compare os totais por item, decida o vencedor de cada item (escolher proposta acima da menor exige justificativa auditável) e converta em pedidos — um por fornecedor vencedor, sem duplicar se repetido. Nenhuma proposta é simulada nem enviada automaticamente.</p></details><form class="proc-filter" data-list="quotations"><input name="search" type="search" placeholder="Buscar número da cotação ou da requisição" data-i18n-ph="phQuotSearch"><select name="status"><option value="" data-i18n-pr="allOpt">Todos</option><option>SENT</option><option>PARTIAL</option><option>RESPONDED</option><option>ANALYSIS</option><option>APPROVED</option><option>REJECTED</option><option>EXPIRED</option><option>CANCELLED</option></select><button data-i18n-pr="filterBtn">Filtrar</button></form><div class="proc-table" data-content="quotations"></div></section>
 <section class="proc-panel" id="orders"><header><div><h2 data-i18n-pr="ordersTitle">Pedidos de compra</h2><p data-i18n-pr="ordersDesc">Aprovação, entrega prevista e acompanhamento de saldo.</p></div><button data-dialog="order-dialog" class="proc-primary" data-i18n-pr="newOrder">Novo pedido</button></header><form class="proc-filter" data-list="orders"><input name="search" type="search" placeholder="Número ou fornecedor" data-i18n-ph="phOrderSearch"><select name="status"><option value="" data-i18n-pr="allOpt">Todos</option><option>AWAITING_APPROVAL</option><option>APPROVED</option><option>PARTIALLY_RECEIVED</option><option>RECEIVED</option></select><button data-i18n-pr="filterBtn">Filtrar</button><a href="/api/procurement/reports/orders.csv" data-i18n-pr="exportCsv">Exportar CSV</a></form><div class="proc-table" data-content="orders"></div></section>
 <section class="proc-panel" id="receipts"><header><div><h2 data-i18n-pr="receiptsTitle">Recebimento e conferência</h2><p data-i18n-pr="receiptsDesc">Presença física, decisão de qualidade e disponibilidade são eventos separados.</p></div><button data-dialog="receipt-dialog" class="proc-primary" data-i18n-pr="newReceipt">Registrar recebimento</button></header><details class="proc-help"><summary data-i18n-pr="receiptHelpSummary">Como usar</summary><p data-i18n-pr="receiptHelpBody">Selecione um pedido aprovado, confira o saldo calculado, informe quantidade, lote, validade e depósito, depois revise e confirme. Materiais com inspeção ou validade vencida permanecem bloqueados; somente uma decisão autorizada libera a quantidade aceita. A previsão financeira fica aberta e não representa pagamento.</p></details><form class="proc-filter" data-list="receipts"><input name="search" type="search" placeholder="Recebimento, pedido ou fornecedor" data-i18n-ph="phReceiptSearch"><select name="status"><option value="" data-i18n-pr="allOpt">Todos</option><option>PENDING</option><option>PARTIAL</option><option>RECEIVED</option><option>DIVERGENT</option></select><button data-i18n-pr="filterBtn">Filtrar</button></form><div class="proc-table" data-content="receipts"></div></section>
 <section class="proc-panel" id="supplier-returns"><header><div><h2 data-i18n-pr="returnsTitle">Devoluções ao fornecedor</h2><p data-i18n-pr="returnsDesc">Baixa auditável no estoque com crédito aberto; decisão separada do registro.</p></div></header><details class="proc-help"><summary data-i18n-pr="returnHelpSummary">Como usar</summary><p data-i18n-pr="returnHelpBody">Registre a devolução no detalhe de um recebimento concluído ou divergente, respeitando o saldo aceito e ainda não devolvido de cada linha. A aprovação baixa o estoque, reabre o saldo do pedido e gera crédito aberto — nenhuma conta é paga ou compensada automaticamente. Quem registrou a devolução não pode aprová-la.</p></details><form class="proc-filter" data-list="supplier-returns"><input name="search" type="search" placeholder="Devolução, recebimento ou fornecedor" data-i18n-ph="phReturnSearch"><select name="status"><option value="" data-i18n-pr="allOpt">Todas</option><option>PENDING_APPROVAL</option><option>APPROVED</option><option>REJECTED</option><option>CANCELLED</option></select><button data-i18n-pr="filterBtn">Filtrar</button></form><div class="proc-table" data-content="supplier-returns"></div></section>
 <section class="proc-panel" id="invoice-matches"><header><div><h2 data-i18n-pr="matchesTitle">Conferência de cobranças</h2><p data-i18n-pr="matchesDesc">Compara contrato, aceite e cobrança sem presumir validação fiscal ou pagamento.</p></div><div style="display:flex;gap:10px;align-items:center"><button type="button" id="proc-tolerances" class="proc-link" data-i18n-pr="tolerancesBtn">Tolerâncias</button><button data-dialog="match-dialog" class="proc-primary" data-i18n-pr="newMatch">Conferir cobrança</button></div></header><details class="proc-help"><summary data-i18n-pr="matchHelpSummary">Como usar</summary><p data-i18n-pr="matchHelpBody"><b>Pré-requisitos:</b> pedido aprovado e recebimento aceito. Selecione explicitamente a linha recebida, informe os valores do documento e confirme. <b>Resultado:</b> diferenças dentro das tolerâncias ficam conferidas; as demais aguardam decisão autorizada. O documento continua “não validado fiscalmente”; conferência aprovada não significa pagamento e nenhuma conta é paga por esta ação. Consulte o manual de Compras e Suprimentos.</p></details><form class="proc-filter" data-list="invoice-matches"><label><span data-i18n-pr="searchLbl">Busca</span><input name="search" type="search" placeholder="Documento, pedido ou fornecedor" data-i18n-ph="phMatchSearch"></label><label><span data-i18n-pr="situationLbl">Situação</span><select name="status"><option value="" data-i18n-pr="allOpt">Todas</option><option>MATCHED</option><option>PENDING_EXCEPTION</option><option>REJECTED</option></select></label><button data-i18n-pr="filterBtn">Filtrar</button></form><div class="proc-table" data-content="invoice-matches"></div></section>
 <section class="proc-panel" id="reports"><header><div><h2 data-i18n-pr="reportsTitle">Relatórios de compras</h2><p data-i18n-pr="reportsDesc">Arquivos CSV respeitam filtros, permissões e tenant.</p></div></header><div class="report-grid"><a href="/api/procurement/reports/suppliers.csv" data-i18n-pr="reportSuppliers">Fornecedores</a><a href="/api/procurement/reports/requisitions.csv" data-i18n-pr="reportRequisitions">Requisições</a><a href="/api/procurement/reports/orders.csv" data-i18n-pr="reportOrders">Pedidos de compra</a></div></section>
</main>
<template id="requisition-line-template"><div class="proc-line-row" data-line><label><span data-i18n-pr="lineItem">Item do catálogo *</span><select name="catalogItemId" data-lookup="catalog" required><option value="" data-i18n-pr="loadingItems">Carregando itens ativos…</option></select></label><label><span data-i18n-pr="qtyRequired">Quantidade *</span><input name="quantity" type="number" min="0.001" step="0.001" required></label><label><span data-i18n-pr="unitRequired">Unidade *</span><input name="unit" required placeholder="kg, un, L"></label><button type="button" class="proc-line-remove" data-remove-line aria-label="Remover linha" data-i18n-aria="removeLineAria">&times;</button></div></template>
<template id="order-line-template"><div class="proc-line-row" data-line><label><span data-i18n-pr="lineItemSimple">Item *</span><select name="catalogItemId" data-lookup="catalog" required><option value="" data-i18n-pr="loadingItems">Carregando itens ativos…</option></select></label><label><span data-i18n-pr="qtyRequired">Quantidade *</span><input name="quantity" type="number" min="0.001" step="0.001" required></label><label><span data-i18n-pr="unitRequired">Unidade *</span><input name="unit" required></label><label><span data-i18n-pr="unitPriceRequired">Preço unitário *</span><input name="unitPrice" type="number" min="0.01" step="0.01" required></label><label><span data-i18n-pr="discountLbl">Desconto</span><input name="discount" type="number" min="0" step="0.01" value="0"></label><button type="button" class="proc-line-remove" data-remove-line aria-label="Remover linha" data-i18n-aria="removeLineAria">&times;</button></div></template>
<template id="receipt-line-template"><div class="proc-line-row" data-line><label><span data-i18n-pr="selPendingItemPh">Selecione o item pendente</span><select name="purchaseOrderItemId" required><option value="">Selecione o pedido</option></select></label><label><span data-i18n-pr="qtyRequired">Quantidade *</span><input name="quantity" type="number" min="0.001" step="0.001" required></label><label><span data-i18n-pr="lotLbl">Lote do fornecedor</span><input name="supplierLot"></label><label><span data-i18n-pr="expiryLbl">Validade</span><input name="expiresOn" type="date"></label><button type="button" class="proc-line-remove" data-remove-line aria-label="Remover linha" data-i18n-aria="removeLineAria">&times;</button></div></template>
<dialog id="match-detail-dialog" class="proc-wide"><header><h2 data-i18n-pr="matchDetailTitle">Resultado da conferência</h2><button type="button" onclick="this.closest('dialog').close()" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><div class="match-detail-content"></div></dialog>
<dialog id="match-dialog"><form method="dialog" class="proc-form" data-endpoint="invoice-matches"><header><h2 data-i18n-pr="matchFormTitle">Conferir cobrança parcial</h2><button value="cancel" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><p data-i18n-pr="matchFormHint">Campos com * são obrigatórios. A vinculação é manual: nomes semelhantes nunca são associados automaticamente.</p><div class="form-grid"><label><span data-i18n-pr="orderSel">Pedido *</span><select name="purchaseOrderId" data-lookup="match-orders" required><option value="" data-i18n-pr="selOrderPh">Selecione o pedido</option></select></label><label><span data-i18n-pr="matchLineLabel">Linha recebida e aceita *</span><select name="matchLine" required><option value="" data-i18n-pr="selOrderFirstPh">Selecione primeiro o pedido</option></select></label><label><span data-i18n-pr="documentNumber">Número do documento *</span><input name="documentNumber" required maxlength="100" autocomplete="off"></label><label><span data-i18n-pr="series">Série</span><input name="documentSeries" maxlength="30"></label><label><span data-i18n-pr="issueDate">Emissão *</span><input name="issuedOn" type="date" required></label><label><span data-i18n-pr="currency">Moeda *</span><input name="currency" value="BRL" readonly required aria-describedby="currency-help"><small id="currency-help" data-i18n-pr="currencyHelp">Outra moeda exige política de câmbio e será bloqueada.</small></label><label><span data-i18n-pr="billedQty">Quantidade cobrada *</span><input name="matchQuantity" type="number" min="0.000001" step="0.000001" required></label><label><span data-i18n-pr="unitPriceLbl">Preço unitário *</span><input name="matchUnitPrice" type="number" min="0" step="0.0001" required></label><label><span data-i18n-pr="lineDiscount">Desconto da linha</span><input name="lineDiscount" type="number" min="0" step="0.01" value="0"></label><label><span data-i18n-pr="generalDiscount">Desconto geral</span><input name="documentDiscount" type="number" min="0" step="0.01" value="0"></label><label><span data-i18n-pr="freight">Frete</span><input name="matchFreight" type="number" min="0" step="0.01" value="0"></label><label><span data-i18n-pr="additional">Valores adicionais</span><input name="additionalAmount" type="number" min="0" step="0.01" value="0"></label><label class="wide"><span data-i18n-pr="lineDescription">Descrição da linha *</span><input name="lineDescription" required maxlength="300" placeholder="Descrição exatamente como consta no documento" data-i18n-ph="phLineDoc"></label></div><p data-match-total aria-live="polite" data-i18n-pr="calcTotalInit">Total calculado: R$ 0,00</p><button class="proc-primary" data-i18n-pr="registerMatchBtn">Conferir e registrar</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="receipt-detail-dialog" class="proc-wide"><header><h2 data-i18n-pr="receiptDetailTitle">Detalhes do recebimento</h2><button type="button" onclick="this.closest('dialog').close()" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><details class="proc-help"><summary data-i18n-pr="receiptDetailHelpSummary">Como usar</summary><p data-i18n-pr="receiptDetailHelpBody">Consulte itens, lotes e quantidades bloqueadas, disponíveis e rejeitadas. Use Decidir somente após realizar a inspeção e reunir a evidência aplicável.</p></details><div class="receipt-detail-content"></div></dialog>
<dialog id="quality-dialog"><form method="dialog" id="quality-form"><header><h2 data-i18n-pr="qualityDialogTitle">Decisão de qualidade</h2><button value="cancel" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><p data-quality-max></p><input type="hidden" name="receiptItemId"><input type="hidden" name="receiptId"><div class="form-grid"><label><span data-i18n-pr="acceptedQty">Quantidade aceita</span><input name="acceptedQuantity" type="number" min="0" step="0.001" value="0" required></label><label><span data-i18n-pr="rejectedQty">Quantidade rejeitada</span><input name="rejectedQuantity" type="number" min="0" step="0.001" value="0" required></label><label><span data-i18n-pr="resultLbl">Resultado</span><select name="result" required><option value="APPROVED" data-i18n-pr="qApproved">Aprovado</option><option value="CONDITIONALLY_APPROVED" data-i18n-pr="qConditional">Aprovado com condição</option><option value="REJECTED" data-i18n-pr="qRejected">Reprovado</option></select></label><label><span data-i18n-pr="evidenceLbl">Evidência / documento</span><input name="evidenceReference" maxlength="500" placeholder="Número ou referência do laudo" data-i18n-ph="phReportRef"></label><label class="wide"><span data-i18n-pr="justificationField2">Justificativa</span><textarea name="reason" maxlength="1000" placeholder="Obrigatória para rejeição ou condição" data-i18n-ph="phJustReq"></textarea></label></div><button class="proc-primary" data-i18n-pr="registerReleaseBtn">Registrar e liberar elegível</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="supplier-dialog"><form method="dialog" class="proc-form" data-endpoint="suppliers"><header><h2 data-i18n-pr="supplierDialogTitle">Novo fornecedor</h2><button value="cancel" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><div class="form-grid"><label><span data-i18n-pr="legalName">Razão social</span><input name="legalName" required minlength="3" maxlength="200"></label><label><span data-i18n-pr="tradeName">Nome fantasia</span><input name="tradeName" maxlength="200"></label><label><span data-i18n-pr="taxDoc">Documento fiscal</span><input name="taxDocument" inputmode="numeric" pattern="[0-9.\/-]{11,18}"></label><label><span data-i18n-pr="typeLbl">Tipo</span><select name="type" required><option value="" data-i18n-pr="select">Selecione</option><option>INPUTS</option><option>PESTICIDES</option><option>FERTILIZERS</option><option>SEEDS</option><option>PARTS</option><option>FUEL</option><option>SERVICES</option><option>LOGISTICS</option><option>LABORATORY</option><option>OTHER</option></select></label><label><span data-i18n-pr="mainCategory">Categoria principal</span><input name="category" required></label><label><span data-i18n-pr="emailLbl">E-mail</span><input name="email" type="email"></label><label><span data-i18n-pr="phoneLbl">Telefone</span><input name="phone" type="tel" pattern="[0-9()+ -]{8,20}"></label><label><span data-i18n-pr="countryLbl">País</span><input name="country" value="Brasil" required></label><label><span data-i18n-pr="statusLbl">Status</span><select name="status" required><option value="ACTIVE" data-i18n-pr="stActive">Ativo</option><option value="UNDER_REVIEW" data-i18n-pr="stReview">Em homologação</option><option value="INACTIVE" data-i18n-pr="stInactive">Inativo</option><option value="BLOCKED" data-i18n-pr="stBlocked">Bloqueado</option></select></label><label><span data-i18n-pr="avgDelivery">Prazo médio (dias)</span><input name="averageDeliveryDays" type="number" min="0" value="0" required></label><label class="wide"><span data-i18n-pr="notesLbl">Observações</span><textarea name="notes" maxlength="1000"></textarea></label></div><input type="hidden" name="tags" value=""><button class="proc-primary" data-i18n-pr="saveSupplierBtn">Salvar fornecedor</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="catalog-dialog"><form method="dialog" class="proc-form" data-endpoint="catalog"><header><h2 data-i18n-pr="catalogDialogTitle">Novo item</h2><button value="cancel" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><div class="form-grid"><label><span data-i18n-pr="nameLbl">Nome</span><input name="name" required></label><label><span data-i18n-pr="internalCode">Código interno</span><input name="code" required></label><label><span data-i18n-pr="categoryLbl">Categoria</span><select name="category" required><option value="" data-i18n-pr="select">Selecione</option><option>AGRICULTURAL_INPUT</option><option>PESTICIDE</option><option>FERTILIZER</option><option>SEED</option><option>PACKAGING</option><option>PPE</option><option>PART</option><option>FUEL</option><option>SERVICE</option><option>VETERINARY</option><option>OTHER</option></select></label><label><span data-i18n-pr="unitField">Unidade</span><input name="unit" required placeholder="kg, un, L, h"></label><label><span data-i18n-pr="typeLbl">Tipo</span><select name="type" required><option>MATERIAL</option><option>SERVICE</option><option>ASSET</option></select></label><label><span data-i18n-pr="stockProduct">Produto de estoque</span><select name="relatedProductId" data-lookup="products"><option value="" data-i18n-pr="phStockProduct">Selecione para material/ativo</option></select></label><label><span data-i18n-pr="minStock">Estoque mínimo</span><input name="minimumStock" type="number" min="0" step="0.001"></label><fieldset class="wide"><legend data-i18n-pr="requirements">Exigências</legend><label><input type="checkbox" name="requiresLot"> <span data-i18n-pr="reqLot">Lote</span></label><label><input type="checkbox" name="requiresExpiry"> <span data-i18n-pr="reqExpiry">Validade</span></label><label><input type="checkbox" name="requiresDocument"> <span data-i18n-pr="reqDocument">Documento</span></label><label><input type="checkbox" name="requiresInspection"> <span data-i18n-pr="reqInspection">Inspeção</span></label><label><input type="checkbox" name="requiresApprovedSupplier"> <span data-i18n-pr="reqApprovedSupplier">Fornecedor homologado</span></label></fieldset></div><button class="proc-primary" data-i18n-pr="saveItemBtn">Salvar item</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="requisition-dialog"><form method="dialog" class="proc-form" data-endpoint="requisitions"><header><h2 data-i18n-pr="reqDialogTitle">Nova requisição</h2><button value="cancel" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><div class="form-grid"><label><span data-i18n-pr="originLbl">Origem / necessidade</span><input name="origin" required placeholder="Manutenção, Lavoura, Qualidade" data-i18n-ph="phOrigin"></label><label><span data-i18n-pr="operationalUnit">Unidade operacional</span><select name="propertyId" data-lookup="farms"><option value="" data-i18n-pr="useContext">Usar contexto atual</option></select></label><label><span data-i18n-pr="priorityLbl">Prioridade</span><select name="priority" required><option>MEDIUM</option><option>LOW</option><option>HIGH</option><option>URGENT</option></select></label><label><span data-i18n-pr="neededOn">Data necessária</span><input name="neededOn" type="date" required></label><label class="wide"><span data-i18n-pr="justificationField3">Justificativa</span><textarea name="justification" required minlength="3"></textarea></label><fieldset class="wide" data-lines data-template="#requisition-line-template"><legend data-i18n-pr="itemsRequested">Itens solicitados</legend><div data-lines-body></div><p class="proc-help" data-i18n-pr="unitConsistency">A unidade deve coincidir com o cadastro do item; conversões são explícitas.</p><button type="button" class="proc-link" data-add-line="[data-lines][data-template='#requisition-line-template']" data-i18n-pr="addItem">Adicionar item</button></fieldset><label class="wide"><input type="checkbox" name="submit"> <span data-i18n-pr="submitNow">Enviar imediatamente à fila de aprovação</span></label></div><button class="proc-primary" data-i18n-pr="saveReqBtn">Salvar requisição</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="order-dialog"><form method="dialog" class="proc-form" data-endpoint="orders"><header><h2 data-i18n-pr="orderDialogTitle">Novo pedido</h2><button value="cancel" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><div class="form-grid"><label><span data-i18n-pr="supplierLbl">Fornecedor</span><select name="supplierId" data-lookup="suppliers" required></select></label><label><span data-i18n-pr="operationalUnit">Unidade operacional</span><select name="propertyId" data-lookup="farms"><option value="" data-i18n-pr="useContext">Usar contexto atual</option></select></label><fieldset class="wide" data-lines data-template="#order-line-template"><legend data-i18n-pr="orderItems">Itens do pedido</legend><div data-lines-body></div><button type="button" class="proc-link" data-add-line="[data-lines][data-template='#order-line-template']" data-i18n-pr="addItem">Adicionar item</button></fieldset><label><span data-i18n-pr="freight">Frete</span><input name="freight" type="number" min="0" step="0.01" value="0"></label><label><span data-i18n-pr="taxesLbl">Impostos</span><input name="taxes" type="number" min="0" step="0.01" value="0"></label><label><span data-i18n-pr="paymentTerms">Condição de pagamento</span><input name="paymentTerms" required></label><label><span data-i18n-pr="deliveryOn">Entrega prevista</span><input name="deliveryOn" type="date" required></label><label class="wide"><span data-i18n-pr="deliveryAddress">Endereço de entrega</span><textarea name="deliveryAddress" required></textarea></label></div><button class="proc-primary" data-i18n-pr="createForApproval">Criar para aprovação</button><span class="form-message"></span></form></dialog>
<dialog id="receipt-dialog"><form method="dialog" class="proc-form" data-endpoint="receipts"><header><h2 data-i18n-pr="receiptDialogTitle">Registrar recebimento</h2><button value="cancel" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><div class="form-grid"><label><span data-i18n-pr="approvedOrderSel">Pedido aprovado</span><select name="purchaseOrderId" data-lookup="orders" required></select></label><fieldset class="wide" data-lines data-template="#receipt-line-template"><legend data-i18n-pr="pendingItemLbl">Item pendente *</legend><div data-lines-body></div><button type="button" class="proc-link" data-add-line="[data-lines][data-template='#receipt-line-template']" data-i18n-pr="addItem">Adicionar item</button></fieldset><label><span data-i18n-pr="receivedAt">Data/hora</span><input name="receivedAt" type="datetime-local" required></label><label><span data-i18n-pr="warehouseLbl">Depósito para entrada física</span><select name="warehouseId" data-lookup="warehouses"><option value="" data-i18n-pr="naService">Não aplicável a serviço</option></select></label><label><span data-i18n-pr="financeAccount">Conta da previsão financeira</span><select name="financeAccountId" data-lookup="finance-accounts" required></select></label><label><span data-i18n-pr="firstDueOn">Primeiro vencimento</span><input name="firstDueOn" type="date" required></label><label><span data-i18n-pr="installments">Parcelas</span><input name="installments" type="number" min="1" max="60" value="1" required></label><label><span data-i18n-pr="invoiceDoc">Nota/documento</span><input name="invoiceDocument"></label><label><input name="overrideExcess" type="checkbox"> <span data-i18n-pr="overrideExcess">Autorizar excesso</span></label><label class="wide"><span data-i18n-pr="excessJustification">Justificativa do excesso</span><textarea name="excessJustification" minlength="5"></textarea></label></div><p data-i18n-pr="receiptFooter">A confirmação registra a presença física. Itens com inspeção ou validade vencida ficam em quarentena e não entram no saldo disponível; a previsão financeira permanece aberta, nunca paga.</p><button class="proc-primary" data-i18n-pr="confirmReceiveFull">Conferir e receber</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="quotation-request-dialog"><form method="dialog" id="quotation-request-form"><header><h2 data-i18n-pr="newQuotationTitle">Nova cotação</h2><button value="cancel" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><p data-i18n-pr="quotRequestHint">Somente requisições aprovadas ou com saldo aprovado aceitam cotação, e existe no máximo uma cotação em aberto por requisição.</p><div class="form-grid"><label><span data-i18n-pr="approvedReqLbl">Requisição aprovada *</span><select name="requisitionId" required><option value="" data-i18n-pr="selApprovedReqPh">Selecione a requisição aprovada</option></select></label><label><span data-i18n-pr="dueDateLbl">Prazo para receber propostas *</span><input name="dueDate" type="date" required></label><label class="wide"><span data-i18n-pr="participantsLbl">Fornecedores participantes *</span><select name="supplierIds" multiple size="6" required><option value="" data-i18n-pr="loadingSuppliers">Carregando fornecedores ativos…</option></select><small data-i18n-pr="atLeastTwo">Ao menos dois fornecedores. Segure Ctrl para marcar vários.</small></label></div><button class="proc-primary" data-i18n-pr="requestQuotationBtn">Solicitar cotação</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="quote-dialog"><form method="dialog" id="quote-form"><header><h2 data-i18n-pr="quoteTitle">Registrar proposta recebida</h2><button value="cancel" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><p data-i18n-pr="quoteHint">Digitada exatamente como o fornecedor enviou; nada é cotado nem enviado automaticamente.</p><input type="hidden" name="quoteQuotationId"><div class="form-grid"><label><span data-i18n-pr="participantLbl">Fornecedor participante *</span><select name="participant" required><option value="" data-i18n-pr="selParticipantPh">Selecione o fornecedor participante</option></select></label><label><span data-i18n-pr="quotedItemLbl">Item cotado *</span><select name="quotationItem" required><option value="" data-i18n-pr="selQuotedItemPh">Selecione o item da cotação</option></select></label><label><span data-i18n-pr="unitPriceLbl">Preço unitário *</span><input name="unitPrice" type="number" min="0.01" step="0.01" required></label><label><span data-i18n-pr="discountUnit">Desconto por unidade</span><input name="discount" type="number" min="0" step="0.01" value="0"></label><label><span data-i18n-pr="deliveryDays">Prazo de entrega (dias) *</span><input name="deliveryDays" type="number" min="0" max="365" required></label><label><span data-i18n-pr="proposalValidity">Validade da proposta</span><input name="proposalValidUntil" type="date"></label><label><span data-i18n-pr="paymentTerms">Condição de pagamento</span><input name="paymentTerms" maxlength="100"></label><label><span data-i18n-pr="freight">Frete</span><input name="freight" type="number" min="0" step="0.01"></label><label><span data-i18n-pr="taxesLbl">Impostos</span><input name="taxes" type="number" min="0" step="0.01"></label><label class="wide"><span data-i18n-pr="notesWide">Observações</span><textarea name="notes" maxlength="1000"></textarea></label></div><button class="proc-primary" data-i18n-pr="registerQuoteBtn">Registrar proposta</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="quotation-detail-dialog" class="proc-wide"><header><h2 data-i18n-pr="quotDetailTitle">Detalhes da cotação</h2><button type="button" onclick="this.closest('dialog').close()" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><details class="proc-help"><summary data-i18n-pr="quotDetailHelpSummary">Como usar</summary><p data-i18n-pr="quotDetailHelpBody">Compare as propostas registradas, escolha o vencedor por item (a seleção padrão é a menor proposta) e registre a decisão. Somente a conversão cria pedidos — um por fornecedor vencedor, sem duplicar se repetida.</p></details><div class="quotation-detail-content"></div></dialog>
<dialog id="compare-dialog" class="proc-wide"><header><h2 data-i18n-pr="compareTitle">Comparação de cotações da requisição</h2><button type="button" onclick="this.closest('dialog').close()" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><details class="proc-help"><summary data-i18n-pr="compareHelpSummary">Como usar</summary><p data-i18n-pr="compareHelpBody">Todas as propostas vigentes das cotações da requisição, ordenadas por item. A menor proposta de cada item está marcada; decisões já registradas aparecem sinalizadas.</p></details><div class="compare-content"></div></dialog>
<dialog id="divergence-dialog"><form method="dialog" id="divergence-form"><header><h2 data-i18n-pr="divergenceTitle">Decidir divergência de conferência</h2><button value="cancel" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><p data-i18n-pr="divergenceHint">A justificativa é obrigatória e permanece no histórico. Nenhuma destas decisões efetua pagamento.</p><input type="hidden" name="divergenceId"><input type="hidden" name="matchId"><div class="form-grid"><label><span data-i18n-pr="decisionFieldLbl">Decisão *</span><select name="decision" required><option value="APPROVED_EXCEPTION" data-i18n-pr="approveException">Aprovar exceção</option><option value="CORRECTION_REQUESTED" data-i18n-pr="requestCorrection">Solicitar correção</option><option value="REJECTED" data-i18n-pr="rejectBilling">Rejeitar cobrança</option></select></label><label class="wide"><span data-i18n-pr="justificationReq">Justificativa *</span><textarea name="justification" required minlength="5" maxlength="1000"></textarea></label><label class="wide"><span data-i18n-pr="evidenceLbl2">Evidência / documento</span><input name="evidenceReference" maxlength="500" placeholder="Número ou referência do comprovante" data-i18n-ph="phProofRef"></label></div><button class="proc-primary" data-i18n-pr="confirmDecisionBtn">Confirmar decisão</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="supplier-return-dialog"><form method="dialog" id="supplier-return-form"><header><h2 data-i18n-pr="returnDialogTitle">Devolver itens ao fornecedor</h2><button value="cancel" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><p data-i18n-pr="returnDialogHint">Somente o saldo aceito e ainda não devolvido pode voltar ao fornecedor. A devolução aguarda aprovação de outro usuário; nada sai do estoque antes dela.</p><input type="hidden" name="receiptId"><div data-return-items aria-live="polite"></div><label class="wide"><span data-i18n-pr="returnReason">Motivo da devolução *</span><textarea name="reason" required minlength="5" maxlength="1000" placeholder="Descreva o motivo real da devolução" data-i18n-ph="phReturnReason"></textarea></label><button type="submit" class="proc-primary" data-return-submit data-i18n-pr="registerReturnBtn">Registrar devolução</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="return-decision-dialog"><form method="dialog" id="return-decision-form"><header><h2 data-i18n-pr="returnDecisionTitle">Decidir devolução ao fornecedor</h2><button value="cancel" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><p data-i18n-pr="returnDecisionHint">Aprovar baixa o estoque, reabre o saldo do pedido e gera crédito aberto sem compensar títulos automaticamente. Reprovar não altera estoque, pedido nem financeiro.</p><input type="hidden" name="returnId"><div class="form-grid"><label><span data-i18n-pr="decisionFieldLbl">Decisão *</span><select name="decision" required><option value="APPROVE" data-i18n-pr="approveReturnOpt">Aprovar devolução</option><option value="REJECT" data-i18n-pr="rejectReturnOpt">Reprovar devolução</option></select></label><label class="wide"><span data-i18n-pr="justificationField2">Justificativa</span><textarea name="reason" maxlength="1000" placeholder="Obrigatória para reprovação" data-i18n-ph="phReasonReq"></textarea></label></div><button class="proc-primary" data-i18n-pr="confirmDecisionBtn">Confirmar decisão</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="return-detail-dialog" class="proc-wide"><header><h2 data-i18n-pr="returnDetailTitle">Detalhes da devolução ao fornecedor</h2><button type="button" onclick="this.closest('dialog').close()" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><details class="proc-help"><summary data-i18n-pr="returnDetailHelpSummary">Como usar</summary><p data-i18n-pr="returnDetailHelpBody">Consulte itens devolvidos, status da decisão e o crédito aberto. Crédito aberto não representa pagamento nem compensação automática de contas a pagar.</p></details><div class="return-detail-content"></div></dialog>
<dialog id="requisition-detail-dialog" class="proc-wide"><header><h2 data-i18n-pr="reqDetailTitle">Detalhes da requisição</h2><button type="button" onclick="this.closest('dialog').close()" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><div class="requisition-detail-content"></div></dialog>
<dialog id="quotation-cancel-dialog"><form method="dialog" id="quotation-cancel-form"><header><h2 data-i18n-pr="cancelTitle">Cancelar cotação</h2><button value="cancel" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><p data-i18n-pr="cancelHint">Somente cotações abertas podem ser canceladas. A justificativa permanece no histórico auditável.</p><input type="hidden" name="quotationId"><label class="wide"><span data-i18n-pr="cancelReason">Justificativa do cancelamento *</span><textarea name="reason" required minlength="5" maxlength="500" placeholder="Explique o motivo real do cancelamento" data-i18n-ph="phCancelReason"></textarea></label><button class="proc-primary" data-i18n-pr="cancelConfirmBtn">Confirmar cancelamento</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="tolerance-dialog"><form method="dialog" id="tolerance-form"><header><h2 data-i18n-pr="toleranceTitle">Tolerâncias de conferência</h2><button value="cancel" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><p data-i18n-pr="toleranceHint">Limites dentro dos quais a diferença entre contrato, aceite e cobrança é conferida sem exceção. Alterações ficam versionadas e auditadas.</p><input type="hidden" name="toleranceVersion"><div class="form-grid"><label><span data-i18n-pr="tolQtyPercent">Divergência de quantidade (%)</span><input name="quantityPercent" type="number" min="0" step="0.01" required></label><label><span data-i18n-pr="tolQtyAbs">Divergência de quantidade absoluta</span><input name="quantityAbsolute" type="number" min="0" step="0.001" required></label><label><span data-i18n-pr="tolPricePercent">Divergência de preço (%)</span><input name="pricePercent" type="number" min="0" step="0.01" required></label><label><span data-i18n-pr="tolPriceAbs">Divergência de preço absoluta</span><input name="priceAbsolute" type="number" min="0" step="0.01" required></label><label><span data-i18n-pr="tolTotalPercent">Divergência de total (%)</span><input name="totalPercent" type="number" min="0" step="0.01" required></label><label><span data-i18n-pr="tolTotalAbs">Divergência de total absoluto</span><input name="totalAbsolute" type="number" min="0" step="0.01" required></label><label><span data-i18n-pr="tolExcessPercent">Excesso de recebimento (%)</span><input name="excessPercent" type="number" min="0" step="0.01" required></label><label><span data-i18n-pr="tolExcessAbs">Excesso de recebimento absoluto</span><input name="excessAbsolute" type="number" min="0" step="0.001" required></label><label><span data-i18n-pr="tolDeliveryDays">Tolerância de entrega (dias)</span><input name="deliveryDays" type="number" min="0" max="365" required></label></div><label class="wide"><input type="checkbox" name="separationOfDuties"> <span data-i18n-pr="tolSod">Segregação de funções (não permitir conferir e decidir na mesma pessoa)</span></label><button class="proc-primary" data-i18n-pr="saveTolerances">Salvar tolerâncias</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="decision-reason-dialog"><form method="dialog" id="decision-reason-form"><header><h2 data-i18n-pr="reasonDialogTitle">Justificar decisão</h2><button value="cancel" aria-label="Fechar" data-i18n-aria="closeAria">×</button></header><p data-i18n-pr="reasonDialogHint">A justificativa é enviada ao endpoint e permanece no histórico de auditoria.</p><input type="hidden" name="decisionKind"><input type="hidden" name="decisionId"><input type="hidden" name="decisionVersion"><label class="wide"><span data-i18n-pr="reasonField">Justificativa *</span><textarea name="reason" required minlength="5" maxlength="1000" placeholder="Explique o motivo da sua decisão" data-i18n-ph="phReasonGeneric"></textarea></label><button class="proc-primary" data-i18n-pr="confirmDecisionBtn">Confirmar decisão</button><span class="form-message" role="alert"></span></form></dialog>
@section Scripts { <script src="~/js/procurement.js" asp-append-version="true"></script> }
