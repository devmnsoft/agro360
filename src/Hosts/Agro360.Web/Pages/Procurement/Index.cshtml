@page
@model Agro360.Web.Pages.Procurement.IndexModel
@{ ViewData["Title"]="Compras e Suprimentos"; }
@section Styles { <link rel="stylesheet" href="~/css/procurement.css" asp-append-version="true" /> }
<main class="procurement-shell">
 <header class="procurement-hero"><div><span class="eyebrow">Sprint 37 · cadeia de suprimentos</span><h1>Compras <em>&amp;</em> Suprimentos</h1><p>Da necessidade ao recebimento, com alçada, evidência e rastreabilidade por organização.</p></div><button id="proc-refresh" class="proc-primary">Atualizar indicadores</button></header>
 <section id="proc-kpis" class="proc-kpis" aria-live="polite"><div class="proc-loading">Carregando indicadores reais…</div></section>
 <nav class="proc-tabs" aria-label="Áreas de compras"><button data-tab="suppliers" class="active">Fornecedores</button><button data-tab="catalog">Catálogo</button><button data-tab="requisitions">Requisições</button><button data-tab="orders">Pedidos</button><button data-tab="receipts">Recebimento</button><button data-tab="reports">Relatórios</button></nav>
 <section class="proc-panel active" id="suppliers"><header><div><h2>Fornecedores e homologação</h2><p>Cadastro, risco e validade documental.</p></div><button data-dialog="supplier-dialog" class="proc-primary">Novo fornecedor</button></header><form class="proc-filter" data-list="suppliers"><input name="search" type="search" placeholder="Buscar razão social ou fantasia"><select name="status"><option value="">Todos os status</option><option>ACTIVE</option><option>APPROVED</option><option>UNDER_REVIEW</option><option>BLOCKED</option><option>INACTIVE</option></select><button>Filtrar</button><a href="/api/procurement/reports/suppliers.csv">Exportar CSV</a></form><div class="proc-table" data-content="suppliers"></div></section>
 <section class="proc-panel" id="catalog"><header><div><h2>Catálogo comprável</h2><p>Materiais, serviços e ativos com requisitos de recebimento.</p></div><button data-dialog="catalog-dialog" class="proc-primary">Novo item</button></header><form class="proc-filter" data-list="catalog"><input name="search" type="search" placeholder="Buscar item ou código"><select name="status"><option value="">Ativos e inativos</option><option>ACTIVE</option><option>INACTIVE</option></select><button>Filtrar</button></form><div class="proc-table" data-content="catalog"></div></section>
 <section class="proc-panel" id="requisitions"><header><div><h2>Requisições internas</h2><p>Necessidades operacionais com prioridade e centro de custo.</p></div><button data-dialog="requisition-dialog" class="proc-primary">Nova requisição</button></header><form class="proc-filter" data-list="requisitions"><input name="search" type="search" placeholder="Buscar número"><select name="status"><option value="">Todos</option><option>OPEN</option><option>AWAITING_APPROVAL</option><option>APPROVED</option><option>FULFILLED</option></select><button>Filtrar</button><a href="/api/procurement/reports/requisitions.csv">Exportar CSV</a></form><div class="proc-table" data-content="requisitions"></div></section>
 <section class="proc-panel" id="orders"><header><div><h2>Pedidos de compra</h2><p>Aprovação, entrega prevista e acompanhamento de saldo.</p></div><button data-dialog="order-dialog" class="proc-primary">Novo pedido</button></header><form class="proc-filter" data-list="orders"><input name="search" type="search" placeholder="Número ou fornecedor"><select name="status"><option value="">Todos</option><option>AWAITING_APPROVAL</option><option>APPROVED</option><option>PARTIALLY_RECEIVED</option><option>RECEIVED</option></select><button>Filtrar</button><a href="/api/procurement/reports/orders.csv">Exportar CSV</a></form><div class="proc-table" data-content="orders"></div></section>
 <section class="proc-panel" id="receipts"><header><div><h2>Recebimento e conferência</h2><p>Lote, validade, divergência e liberação transacional.</p></div><button data-dialog="receipt-dialog" class="proc-primary">Registrar recebimento</button></header><div class="proc-empty">Selecione um pedido aprovado no formulário de recebimento. A entrada de estoque somente é concluída quando o integrador real confirmar a transação.</div></section>
 <section class="proc-panel" id="reports"><header><div><h2>Relatórios de compras</h2><p>Arquivos CSV respeitam filtros, permissões e tenant.</p></div></header><div class="report-grid"><a href="/api/procurement/reports/suppliers.csv">Fornecedores</a><a href="/api/procurement/reports/requisitions.csv">Requisições</a><a href="/api/procurement/reports/orders.csv">Pedidos de compra</a></div></section>
</main>
<dialog id="supplier-dialog"><form method="dialog" class="proc-form" data-endpoint="suppliers"><header><h2>Novo fornecedor</h2><button value="cancel" aria-label="Fechar">×</button></header><div class="form-grid"><label>Razão social<input name="legalName" required minlength="3" maxlength="200"></label><label>Nome fantasia<input name="tradeName" maxlength="200"></label><label>Documento fiscal<input name="taxDocument" inputmode="numeric" pattern="[0-9.\/-]{11,18}"></label><label>Tipo<select name="type" required><option value="">Selecione</option><option>INPUTS</option><option>PESTICIDES</option><option>FERTILIZERS</option><option>SEEDS</option><option>PARTS</option><option>FUEL</option><option>SERVICES</option><option>LOGISTICS</option><option>LABORATORY</option><option>OTHER</option></select></label><label>Categoria principal<input name="category" required></label><label>E-mail<input name="email" type="email"></label><label>Telefone<input name="phone" type="tel" pattern="[0-9()+ -]{8,20}"></label><label>País<input name="country" value="Brasil" required></label><label>Status<select name="status" required><option value="ACTIVE">Ativo</option><option value="UNDER_REVIEW">Em homologação</option><option value="INACTIVE">Inativo</option><option value="BLOCKED">Bloqueado</option></select></label><label>Prazo médio (dias)<input name="averageDeliveryDays" type="number" min="0" value="0" required></label><label class="wide">Observações<textarea name="notes" maxlength="1000"></textarea></label></div><input type="hidden" name="tags" value=""><button class="proc-primary">Salvar fornecedor</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="catalog-dialog"><form method="dialog" class="proc-form" data-endpoint="catalog"><header><h2>Novo item</h2><button value="cancel">×</button></header><div class="form-grid"><label>Nome<input name="name" required></label><label>Código interno<input name="code" required></label><label>Categoria<select name="category" required><option value="">Selecione</option><option>AGRICULTURAL_INPUT</option><option>PESTICIDE</option><option>FERTILIZER</option><option>SEED</option><option>PACKAGING</option><option>PPE</option><option>PART</option><option>FUEL</option><option>SERVICE</option><option>VETERINARY</option><option>OTHER</option></select></label><label>Unidade<input name="unit" required placeholder="kg, un, L, h"></label><label>Tipo<select name="type" required><option>MATERIAL</option><option>SERVICE</option><option>ASSET</option></select></label><label>Estoque mínimo<input name="minimumStock" type="number" min="0" step="0.001"></label><fieldset class="wide"><legend>Exigências</legend><label><input type="checkbox" name="requiresLot"> Lote</label><label><input type="checkbox" name="requiresExpiry"> Validade</label><label><input type="checkbox" name="requiresDocument"> Documento</label><label><input type="checkbox" name="requiresInspection"> Inspeção</label><label><input type="checkbox" name="requiresApprovedSupplier"> Fornecedor homologado</label></fieldset></div><button class="proc-primary">Salvar item</button><span class="form-message"></span></form></dialog>
<dialog id="requisition-dialog"><form method="dialog" class="proc-form" data-endpoint="requisitions"><header><h2>Nova requisição</h2><button value="cancel">×</button></header><div class="form-grid"><label>Origem<input name="origin" required placeholder="Manutenção, Lavoura, Qualidade"></label><label>Prioridade<select name="priority" required><option>MEDIUM</option><option>LOW</option><option>HIGH</option><option>URGENT</option></select></label><label>Data necessária<input name="neededOn" type="date" required></label><label class="wide">Justificativa<textarea name="justification" required minlength="3"></textarea></label><label class="wide">Item do catálogo<select name="catalogItemId" data-lookup="catalog" required><option value="">Carregando itens ativos…</option></select></label><label>Quantidade<input name="quantity" type="number" min="0.001" step="0.001" required></label><label>Unidade<input name="unit" required></label></div><button class="proc-primary">Abrir requisição</button><span class="form-message"></span></form></dialog>
<dialog id="order-dialog"><form method="dialog" class="proc-form" data-endpoint="orders"><header><h2>Novo pedido</h2><button value="cancel">×</button></header><div class="form-grid"><label>Fornecedor<select name="supplierId" data-lookup="suppliers" required></select></label><label>Item<select name="catalogItemId" data-lookup="catalog" required></select></label><label>Quantidade<input name="quantity" type="number" min="0.001" step="0.001" required></label><label>Unidade<input name="unit" required></label><label>Preço unitário<input name="unitPrice" type="number" min="0.01" step="0.01" required></label><label>Desconto<input name="discount" type="number" min="0" step="0.01" value="0"></label><label>Frete<input name="freight" type="number" min="0" step="0.01" value="0"></label><label>Impostos informados<input name="taxes" type="number" min="0" step="0.01" value="0"></label><label>Condição de pagamento<input name="paymentTerms" required></label><label>Entrega prevista<input name="deliveryOn" type="date" required></label><label class="wide">Endereço de entrega<textarea name="deliveryAddress" required></textarea></label></div><button class="proc-primary">Criar para aprovação</button><span class="form-message"></span></form></dialog>
<dialog id="receipt-dialog"><form method="dialog" class="proc-form" data-endpoint="receipts"><header><h2>Registrar recebimento</h2><button value="cancel">×</button></header><div class="form-grid"><label>Pedido aprovado<select name="purchaseOrderId" data-lookup="orders" required></select></label><label>Item do pedido<select name="purchaseOrderItemId" required><option value="">Selecione o pedido</option></select></label><label>Quantidade recebida<input name="quantity" type="number" min="0.001" step="0.001" required></label><label>Data/hora<input name="receivedAt" type="datetime-local" required></label><label>Lote do fornecedor<input name="supplierLot"></label><label>Validade<input name="expiresOn" type="date"></label><label>Nota/documento<input name="invoiceDocument"></label><label class="wide">Observações<textarea name="notes"></textarea></label></div><button class="proc-primary">Conferir e receber</button><span class="form-message"></span></form></dialog>
@section Scripts { <script src="~/js/procurement.js" asp-append-version="true"></script> }
