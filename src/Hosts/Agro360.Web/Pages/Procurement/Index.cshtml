@page
@model Agro360.Web.Pages.Procurement.IndexModel
@{ ViewData["Title"]="Compras e Suprimentos"; }
@section Styles { <link rel="stylesheet" href="~/css/procurement.css" asp-append-version="true" /> }
<main class="procurement-shell">
 <header class="procurement-hero"><div><span class="eyebrow">Cadeia de suprimentos</span><h1>Compras <em>&amp;</em> Suprimentos</h1><p>Da necessidade ao recebimento, com alçada, evidência e rastreabilidade por unidade operacional.</p></div><button id="proc-refresh" class="proc-primary">Atualizar indicadores</button></header>
 <section id="proc-kpis" class="proc-kpis" aria-live="polite"><div class="proc-loading">Carregando indicadores reais…</div></section>
 <nav class="proc-tabs" aria-label="Áreas de compras"><button data-tab="suppliers" class="active">Fornecedores</button><button data-tab="catalog">Catálogo</button><button data-tab="requisitions">Requisições</button><button data-tab="quotations">Cotações</button><button data-tab="orders">Pedidos</button><button data-tab="receipts">Recebimentos</button><button data-tab="supplier-returns">Devoluções ao fornecedor</button><button data-tab="invoice-matches">Conferência e divergências</button><button data-tab="reports">Relatórios</button></nav>
 <section class="proc-panel active" id="suppliers"><header><div><h2>Fornecedores e homologação</h2><p>Cadastro, risco e validade documental.</p></div><button data-dialog="supplier-dialog" class="proc-primary">Novo fornecedor</button></header><form class="proc-filter" data-list="suppliers"><input name="search" type="search" placeholder="Buscar razão social ou fantasia"><select name="status"><option value="">Todos os status</option><option>ACTIVE</option><option>APPROVED</option><option>UNDER_REVIEW</option><option>BLOCKED</option><option>INACTIVE</option></select><button>Filtrar</button><a href="/api/procurement/reports/suppliers.csv">Exportar CSV</a></form><div class="proc-table" data-content="suppliers"></div></section>
 <section class="proc-panel" id="catalog"><header><div><h2>Catálogo comprável</h2><p>Materiais, serviços e ativos com requisitos de recebimento.</p></div><button data-dialog="catalog-dialog" class="proc-primary">Novo item</button></header><form class="proc-filter" data-list="catalog"><input name="search" type="search" placeholder="Buscar item ou código"><select name="status"><option value="">Ativos e inativos</option><option>ACTIVE</option><option>INACTIVE</option></select><button>Filtrar</button></form><div class="proc-table" data-content="catalog"></div></section>
 <section class="proc-panel" id="requisitions"><header><div><h2>Requisições internas</h2><p>Necessidades operacionais com prioridade e centro de custo.</p></div><button data-dialog="requisition-dialog" class="proc-primary">Nova requisição</button></header><details class="proc-help"><summary>Fluxo e responsabilidades</summary><p>Salve em rascunho para revisar ou envie à aprovação. Após o envio, rejeitar e cancelar exige justificativa; o solicitante não pode aprovar a própria demanda. Pedidos consomem somente o saldo aprovado.</p></details><form class="proc-filter" data-list="requisitions"><input name="search" type="search" placeholder="Buscar número"><select name="status"><option value="">Todos</option><option>DRAFT</option><option>AWAITING_APPROVAL</option><option>APPROVED</option><option>PARTIALLY_FULFILLED</option><option>CONVERTED</option><option>CANCELLED</option></select><button>Filtrar</button><a href="/api/procurement/reports/requisitions.csv">Exportar CSV</a></form><div class="proc-table" data-content="requisitions"></div></section>
 <section class="proc-panel" id="quotations"><header><div><h2>Cotações</h2><p>Participantes, propostas registradas e conversão auditável para pedido.</p></div><button data-dialog="quotation-request-dialog" class="proc-primary">Nova cotação</button></header><details class="proc-help"><summary>Jornada da cotação</summary><p><b>Fluxo:</b> abra a cotação a partir de uma requisição aprovada com ao menos dois fornecedores participantes, registre as propostas reais recebidas de cada fornecedor, compare os totais por item, decida o vencedor de cada item (escolher proposta acima da menor exige justificativa auditável) e converta em pedidos — um por fornecedor vencedor, sem duplicar se repetido. Nenhuma proposta é simulada nem enviada automaticamente.</p></details><form class="proc-filter" data-list="quotations"><input name="search" type="search" placeholder="Buscar número da cotação ou da requisição"><select name="status"><option value="">Todos</option><option>SENT</option><option>PARTIAL</option><option>RESPONDED</option><option>ANALYSIS</option><option>APPROVED</option><option>REJECTED</option><option>EXPIRED</option><option>CANCELLED</option></select><button>Filtrar</button></form><div class="proc-table" data-content="quotations"></div></section>
 <section class="proc-panel" id="orders"><header><div><h2>Pedidos de compra</h2><p>Aprovação, entrega prevista e acompanhamento de saldo.</p></div><button data-dialog="order-dialog" class="proc-primary">Novo pedido</button></header><form class="proc-filter" data-list="orders"><input name="search" type="search" placeholder="Número ou fornecedor"><select name="status"><option value="">Todos</option><option>AWAITING_APPROVAL</option><option>APPROVED</option><option>PARTIALLY_RECEIVED</option><option>RECEIVED</option></select><button>Filtrar</button><a href="/api/procurement/reports/orders.csv">Exportar CSV</a></form><div class="proc-table" data-content="orders"></div></section>
 <section class="proc-panel" id="receipts"><header><div><h2>Recebimento e conferência</h2><p>Presença física, decisão de qualidade e disponibilidade são eventos separados.</p></div><button data-dialog="receipt-dialog" class="proc-primary">Registrar recebimento</button></header><details class="proc-help"><summary>Como usar</summary><p>Selecione um pedido aprovado, confira o saldo calculado, informe quantidade, lote, validade e depósito, depois revise e confirme. Materiais com inspeção ou validade vencida permanecem bloqueados; somente uma decisão autorizada libera a quantidade aceita. A previsão financeira fica aberta e não representa pagamento.</p></details><form class="proc-filter" data-list="receipts"><input name="search" type="search" placeholder="Recebimento, pedido ou fornecedor"><select name="status"><option value="">Todos</option><option>PENDING</option><option>PARTIAL</option><option>RECEIVED</option><option>DIVERGENT</option></select><button>Filtrar</button></form><div class="proc-table" data-content="receipts"></div></section>
 <section class="proc-panel" id="supplier-returns"><header><div><h2>Devoluções ao fornecedor</h2><p>Baixa auditável no estoque com crédito aberto; decisão separada do registro.</p></div></header><details class="proc-help"><summary>Como usar</summary><p>Registre a devolução no detalhe de um recebimento concluído ou divergente, respeitando o saldo aceito e ainda não devolvido de cada linha. A aprovação baixa o estoque, reabre o saldo do pedido e gera crédito aberto — nenhuma conta é paga ou compensada automaticamente. Quem registrou a devolução não pode aprová-la.</p></details><form class="proc-filter" data-list="supplier-returns"><input name="search" type="search" placeholder="Devolução, recebimento ou fornecedor"><select name="status"><option value="">Todas</option><option>PENDING_APPROVAL</option><option>APPROVED</option><option>REJECTED</option><option>CANCELLED</option></select><button>Filtrar</button></form><div class="proc-table" data-content="supplier-returns"></div></section>
 <section class="proc-panel" id="invoice-matches"><header><div><h2>Conferência de cobranças</h2><p>Compara contrato, aceite e cobrança sem presumir validação fiscal ou pagamento.</p></div><button data-dialog="match-dialog" class="proc-primary">Conferir cobrança</button></header><details class="proc-help"><summary>Como usar</summary><p><b>Pré-requisitos:</b> pedido aprovado e recebimento aceito. Selecione explicitamente a linha recebida, informe os valores do documento e confirme. <b>Resultado:</b> diferenças dentro das tolerâncias ficam conferidas; as demais aguardam decisão autorizada. O documento continua “não validado fiscalmente”; conferência aprovada não significa pagamento e nenhuma conta é paga por esta ação. Consulte o manual de Compras e Suprimentos.</p></details><form class="proc-filter" data-list="invoice-matches"><label>Busca<input name="search" type="search" placeholder="Documento, pedido ou fornecedor"></label><label>Situação<select name="status"><option value="">Todas</option><option>MATCHED</option><option>PENDING_EXCEPTION</option><option>REJECTED</option></select></label><button>Filtrar</button></form><div class="proc-table" data-content="invoice-matches"></div></section>
 <section class="proc-panel" id="reports"><header><div><h2>Relatórios de compras</h2><p>Arquivos CSV respeitam filtros, permissões e tenant.</p></div></header><div class="report-grid"><a href="/api/procurement/reports/suppliers.csv">Fornecedores</a><a href="/api/procurement/reports/requisitions.csv">Requisições</a><a href="/api/procurement/reports/orders.csv">Pedidos de compra</a></div></section>
</main>
<template id="requisition-line-template"><div class="proc-line-row" data-line><label>Item do catálogo *<select name="catalogItemId" data-lookup="catalog" required><option value="">Carregando itens ativos…</option></select></label><label>Quantidade *<input name="quantity" type="number" min="0.001" step="0.001" required></label><label>Unidade *<input name="unit" required placeholder="kg, un, L"></label><button type="button" class="proc-line-remove" data-remove-line aria-label="Remover linha">&times;</button></div></template>
<template id="order-line-template"><div class="proc-line-row" data-line><label>Item *<select name="catalogItemId" data-lookup="catalog" required><option value="">Carregando itens ativos…</option></select></label><label>Quantidade *<input name="quantity" type="number" min="0.001" step="0.001" required></label><label>Unidade *<input name="unit" required></label><label>Preço unitário *<input name="unitPrice" type="number" min="0.01" step="0.01" required></label><label>Desconto<input name="discount" type="number" min="0" step="0.01" value="0"></label><button type="button" class="proc-line-remove" data-remove-line aria-label="Remover linha">&times;</button></div></template>
<dialog id="match-detail-dialog" class="proc-wide"><header><h2>Resultado da conferência</h2><button type="button" onclick="this.closest('dialog').close()" aria-label="Fechar">×</button></header><div class="match-detail-content"></div></dialog>
<dialog id="match-dialog"><form method="dialog" class="proc-form" data-endpoint="invoice-matches"><header><h2>Conferir cobrança parcial</h2><button value="cancel" aria-label="Fechar">×</button></header><p>Campos com * são obrigatórios. A vinculação é manual: nomes semelhantes nunca são associados automaticamente.</p><div class="form-grid"><label>Pedido *<select name="purchaseOrderId" data-lookup="match-orders" required><option value="">Selecione o pedido</option></select></label><label>Linha recebida e aceita *<select name="matchLine" required><option value="">Selecione primeiro o pedido</option></select></label><label>Número do documento *<input name="documentNumber" required maxlength="100" autocomplete="off"></label><label>Série<input name="documentSeries" maxlength="30"></label><label>Emissão *<input name="issuedOn" type="date" required></label><label>Moeda *<input name="currency" value="BRL" readonly required aria-describedby="currency-help"><small id="currency-help">Outra moeda exige política de câmbio e será bloqueada.</small></label><label>Quantidade cobrada *<input name="matchQuantity" type="number" min="0.000001" step="0.000001" required></label><label>Preço unitário *<input name="matchUnitPrice" type="number" min="0" step="0.0001" required></label><label>Desconto da linha<input name="lineDiscount" type="number" min="0" step="0.01" value="0"></label><label>Desconto geral<input name="documentDiscount" type="number" min="0" step="0.01" value="0"></label><label>Frete<input name="matchFreight" type="number" min="0" step="0.01" value="0"></label><label>Valores adicionais<input name="additionalAmount" type="number" min="0" step="0.01" value="0"></label><label class="wide">Descrição da linha *<input name="lineDescription" required maxlength="300" placeholder="Descrição exatamente como consta no documento"></label></div><p data-match-total aria-live="polite">Total calculado: R$ 0,00</p><button class="proc-primary">Conferir e registrar</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="receipt-detail-dialog" class="proc-wide"><header><h2>Detalhes do recebimento</h2><button type="button" onclick="this.closest('dialog').close()" aria-label="Fechar">×</button></header><details class="proc-help"><summary>Como usar</summary><p>Consulte itens, lotes e quantidades bloqueadas, disponíveis e rejeitadas. Use Decidir somente após realizar a inspeção e reunir a evidência aplicável.</p></details><div class="receipt-detail-content"></div></dialog>
<dialog id="quality-dialog"><form method="dialog" id="quality-form"><header><h2>Decisão de qualidade</h2><button value="cancel" aria-label="Fechar">×</button></header><p data-quality-max></p><input type="hidden" name="receiptItemId"><input type="hidden" name="receiptId"><div class="form-grid"><label>Quantidade aceita<input name="acceptedQuantity" type="number" min="0" step="0.001" value="0" required></label><label>Quantidade rejeitada<input name="rejectedQuantity" type="number" min="0" step="0.001" value="0" required></label><label>Resultado<select name="result" required><option value="APPROVED">Aprovado</option><option value="CONDITIONALLY_APPROVED">Aprovado com condição</option><option value="REJECTED">Reprovado</option></select></label><label>Evidência / documento<input name="evidenceReference" maxlength="500" placeholder="Número ou referência do laudo"></label><label class="wide">Justificativa<textarea name="reason" maxlength="1000" placeholder="Obrigatória para rejeição ou condição"></textarea></label></div><button class="proc-primary">Registrar e liberar elegível</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="supplier-dialog"><form method="dialog" class="proc-form" data-endpoint="suppliers"><header><h2>Novo fornecedor</h2><button value="cancel" aria-label="Fechar">×</button></header><div class="form-grid"><label>Razão social<input name="legalName" required minlength="3" maxlength="200"></label><label>Nome fantasia<input name="tradeName" maxlength="200"></label><label>Documento fiscal<input name="taxDocument" inputmode="numeric" pattern="[0-9.\/-]{11,18}"></label><label>Tipo<select name="type" required><option value="">Selecione</option><option>INPUTS</option><option>PESTICIDES</option><option>FERTILIZERS</option><option>SEEDS</option><option>PARTS</option><option>FUEL</option><option>SERVICES</option><option>LOGISTICS</option><option>LABORATORY</option><option>OTHER</option></select></label><label>Categoria principal<input name="category" required></label><label>E-mail<input name="email" type="email"></label><label>Telefone<input name="phone" type="tel" pattern="[0-9()+ -]{8,20}"></label><label>País<input name="country" value="Brasil" required></label><label>Status<select name="status" required><option value="ACTIVE">Ativo</option><option value="UNDER_REVIEW">Em homologação</option><option value="INACTIVE">Inativo</option><option value="BLOCKED">Bloqueado</option></select></label><label>Prazo médio (dias)<input name="averageDeliveryDays" type="number" min="0" value="0" required></label><label class="wide">Observações<textarea name="notes" maxlength="1000"></textarea></label></div><input type="hidden" name="tags" value=""><button class="proc-primary">Salvar fornecedor</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="catalog-dialog"><form method="dialog" class="proc-form" data-endpoint="catalog"><header><h2>Novo item</h2><button value="cancel">×</button></header><div class="form-grid"><label>Nome<input name="name" required></label><label>Código interno<input name="code" required></label><label>Categoria<select name="category" required><option value="">Selecione</option><option>AGRICULTURAL_INPUT</option><option>PESTICIDE</option><option>FERTILIZER</option><option>SEED</option><option>PACKAGING</option><option>PPE</option><option>PART</option><option>FUEL</option><option>SERVICE</option><option>VETERINARY</option><option>OTHER</option></select></label><label>Unidade<input name="unit" required placeholder="kg, un, L, h"></label><label>Tipo<select name="type" required><option>MATERIAL</option><option>SERVICE</option><option>ASSET</option></select></label><label>Produto de estoque<select name="relatedProductId" data-lookup="products"><option value="">Selecione para material/ativo</option></select></label><label>Estoque mínimo<input name="minimumStock" type="number" min="0" step="0.001"></label><fieldset class="wide"><legend>Exigências</legend><label><input type="checkbox" name="requiresLot"> Lote</label><label><input type="checkbox" name="requiresExpiry"> Validade</label><label><input type="checkbox" name="requiresDocument"> Documento</label><label><input type="checkbox" name="requiresInspection"> Inspeção</label><label><input type="checkbox" name="requiresApprovedSupplier"> Fornecedor homologado</label></fieldset></div><button class="proc-primary">Salvar item</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="requisition-dialog"><form method="dialog" class="proc-form" data-endpoint="requisitions"><header><h2>Nova requisição</h2><button value="cancel">×</button></header><div class="form-grid"><label>Origem / necessidade<input name="origin" required placeholder="Manutenção, Lavoura, Qualidade"></label><label>Unidade operacional<select name="propertyId" data-lookup="farms"><option value="">Usar contexto atual</option></select></label><label>Prioridade<select name="priority" required><option>MEDIUM</option><option>LOW</option><option>HIGH</option><option>URGENT</option></select></label><label>Data necessária<input name="neededOn" type="date" required></label><label class="wide">Justificativa<textarea name="justification" required minlength="3"></textarea></label><fieldset class="wide" data-lines data-template="#requisition-line-template"><legend>Itens solicitados</legend><div data-lines-body></div><p class="proc-help">A unidade deve coincidir com o cadastro do item; conversões são explícitas.</p><button type="button" class="proc-link" data-add-line="[data-lines][data-template='#requisition-line-template']">Adicionar item</button></fieldset><label class="wide"><input type="checkbox" name="submit"> Enviar imediatamente à fila de aprovação</label></div><button class="proc-primary">Salvar requisição</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="order-dialog"><form method="dialog" class="proc-form" data-endpoint="orders"><header><h2>Novo pedido</h2><button value="cancel">×</button></header><div class="form-grid"><label>Fornecedor<select name="supplierId" data-lookup="suppliers" required></select></label><label>Unidade operacional<select name="propertyId" data-lookup="farms"><option value="">Usar contexto atual</option></select></label><fieldset class="wide" data-lines data-template="#order-line-template"><legend>Itens do pedido</legend><div data-lines-body></div><button type="button" class="proc-link" data-add-line="[data-lines][data-template='#order-line-template']">Adicionar item</button></fieldset><label>Frete<input name="freight" type="number" min="0" step="0.01" value="0"></label><label>Impostos informados<input name="taxes" type="number" min="0" step="0.01" value="0"></label><label>Condição de pagamento<input name="paymentTerms" required></label><label>Entrega prevista<input name="deliveryOn" type="date" required></label><label class="wide">Endereço de entrega<textarea name="deliveryAddress" required></textarea></label></div><button class="proc-primary">Criar para aprovação</button><span class="form-message"></span></form></dialog>
<dialog id="receipt-dialog"><form method="dialog" class="proc-form" data-endpoint="receipts"><header><h2>Registrar recebimento</h2><button value="cancel">×</button></header><div class="form-grid"><label>Pedido aprovado<select name="purchaseOrderId" data-lookup="orders" required></select></label><label>Item pendente<select name="purchaseOrderItemId" required><option value="">Selecione o pedido</option></select></label><label>Quantidade recebida<input name="quantity" type="number" min="0.001" step="0.001" required></label><label>Data/hora<input name="receivedAt" type="datetime-local" required></label><label>Depósito para entrada física<select name="warehouseId" data-lookup="warehouses"><option value="">Não aplicável a serviço</option></select></label><label>Conta da previsão financeira<select name="financeAccountId" data-lookup="finance-accounts" required></select></label><label>Primeiro vencimento<input name="firstDueOn" type="date" required></label><label>Parcelas<input name="installments" type="number" min="1" max="60" value="1" required></label><label>Lote do fornecedor<input name="supplierLot"></label><label>Validade<input name="expiresOn" type="date"></label><label>Nota/documento<input name="invoiceDocument"></label><label><input name="overrideExcess" type="checkbox"> Autorizar excesso</label><label class="wide">Justificativa do excesso<textarea name="excessJustification" minlength="5"></textarea></label><label class="wide">Observações<textarea name="notes"></textarea></label></div><p>A confirmação registra a presença física. Itens com inspeção ou validade vencida ficam em quarentena e não entram no saldo disponível; a previsão financeira permanece aberta, nunca paga.</p><button class="proc-primary">Conferir e receber</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="quotation-request-dialog"><form method="dialog" id="quotation-request-form"><header><h2>Nova cotação</h2><button value="cancel" aria-label="Fechar">×</button></header><p>Somente requisições aprovadas ou com saldo aprovado aceitam cotação, e existe no máximo uma cotação em aberto por requisição.</p><div class="form-grid"><label>Requisição aprovada *<select name="requisitionId" required><option value="">Selecione a requisição aprovada</option></select></label><label>Prazo para receber propostas *<input name="dueDate" type="date" required></label><label class="wide">Fornecedores participantes *<select name="supplierIds" multiple size="6" required><option value="">Carregando fornecedores ativos…</option></select><small>Ao menos dois fornecedores. Segure Ctrl para marcar vários.</small></label></div><button class="proc-primary">Solicitar cotação</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="quote-dialog"><form method="dialog" id="quote-form"><header><h2>Registrar proposta recebida</h2><button value="cancel" aria-label="Fechar">×</button></header><p>Digitada exatamente como o fornecedor enviou; nada é cotado nem enviado automaticamente.</p><input type="hidden" name="quoteQuotationId"><div class="form-grid"><label>Fornecedor participante *<select name="participant" required><option value="">Selecione o fornecedor participante</option></select></label><label>Item cotado *<select name="quotationItem" required><option value="">Selecione o item da cotação</option></select></label><label>Preço unitário *<input name="unitPrice" type="number" min="0.01" step="0.01" required></label><label>Desconto por unidade<input name="discount" type="number" min="0" step="0.01" value="0"></label><label>Prazo de entrega (dias) *<input name="deliveryDays" type="number" min="0" max="365" required></label><label>Validade da proposta<input name="proposalValidUntil" type="date"></label><label>Condição de pagamento<input name="paymentTerms" maxlength="100"></label><label>Frete<input name="freight" type="number" min="0" step="0.01"></label><label>Impostos<input name="taxes" type="number" min="0" step="0.01"></label><label class="wide">Observações<textarea name="notes" maxlength="1000"></textarea></label></div><button class="proc-primary">Registrar proposta</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="quotation-detail-dialog" class="proc-wide"><header><h2>Detalhes da cotação</h2><button type="button" onclick="this.closest('dialog').close()" aria-label="Fechar">×</button></header><details class="proc-help"><summary>Como usar</summary><p>Compare as propostas registradas, escolha o vencedor por item (a seleção padrão é a menor proposta) e registre a decisão. Somente a conversão cria pedidos — um por fornecedor vencedor, sem duplicar se repetida.</p></details><div class="quotation-detail-content"></div></dialog>
<dialog id="compare-dialog" class="proc-wide"><header><h2>Comparação de cotações da requisição</h2><button type="button" onclick="this.closest('dialog').close()" aria-label="Fechar">×</button></header><details class="proc-help"><summary>Como usar</summary><p>Todas as propostas vigentes das cotações da requisição, ordenadas por item. A menor proposta de cada item está marcada; decisões já registradas aparecem sinalizadas.</p></details><div class="compare-content"></div></dialog>
<dialog id="divergence-dialog"><form method="dialog" id="divergence-form"><header><h2>Decidir divergência de conferência</h2><button value="cancel" aria-label="Fechar">×</button></header><p>A justificativa é obrigatória e permanece no histórico. Nenhuma destas decisões efetua pagamento.</p><input type="hidden" name="divergenceId"><input type="hidden" name="matchId"><div class="form-grid"><label>Decisão *<select name="decision" required><option value="APPROVED_EXCEPTION">Aprovar exceção</option><option value="CORRECTION_REQUESTED">Solicitar correção</option><option value="REJECTED">Rejeitar cobrança</option></select></label><label class="wide">Justificativa *<textarea name="justification" required minlength="5" maxlength="1000"></textarea></label><label class="wide">Evidência / documento<input name="evidenceReference" maxlength="500" placeholder="Número ou referência do comprovante"></label></div><button class="proc-primary">Confirmar decisão</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="supplier-return-dialog"><form method="dialog" id="supplier-return-form"><header><h2>Devolver itens ao fornecedor</h2><button value="cancel" aria-label="Fechar">×</button></header><p>Somente o saldo aceito e ainda não devolvido pode voltar ao fornecedor. A devolução aguarda aprovação de outro usuário; nada sai do estoque antes dela.</p><input type="hidden" name="receiptId"><div data-return-items aria-live="polite"></div><label class="wide">Motivo da devolução *<textarea name="reason" required minlength="5" maxlength="1000" placeholder="Descreva o motivo real da devolução"></textarea></label><button class="proc-primary" data-return-submit>Registrar devolução</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="return-decision-dialog"><form method="dialog" id="return-decision-form"><header><h2>Decidir devolução ao fornecedor</h2><button value="cancel" aria-label="Fechar">×</button></header><p>Aprovar baixa o estoque, reabre o saldo do pedido e gera crédito aberto sem compensar títulos automaticamente. Reprovar não altera estoque, pedido nem financeiro.</p><input type="hidden" name="returnId"><div class="form-grid"><label>Decisão *<select name="decision" required><option value="APPROVE">Aprovar devolução</option><option value="REJECT">Reprovar devolução</option></select></label><label class="wide">Justificativa<textarea name="reason" maxlength="1000" placeholder="Obrigatória para reprovação"></textarea></label></div><button class="proc-primary">Confirmar decisão</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="return-detail-dialog" class="proc-wide"><header><h2>Detalhes da devolução ao fornecedor</h2><button type="button" onclick="this.closest('dialog').close()" aria-label="Fechar">×</button></header><details class="proc-help"><summary>Como usar</summary><p>Consulte itens devolvidos, status da decisão e o crédito aberto. Crédito aberto não representa pagamento nem compensação automática de contas a pagar.</p></details><div class="return-detail-content"></div></dialog>
@section Scripts { <script src="~/js/procurement.js" asp-append-version="true"></script> }
