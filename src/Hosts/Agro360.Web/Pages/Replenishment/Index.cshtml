@page
@model Agro360.Web.Pages.Replenishment.IndexModel
@{ ViewData["Title"]="Planejamento de reposição"; }
@section Styles { <link rel="stylesheet" href="~/css/procurement.css" asp-append-version="true" /> }
<main class="procurement-shell">
 <header class="procurement-hero"><div><span class="eyebrow">Estoque e Suprimentos</span><h1>Planejamento de <em>reposição</em></h1><p>Identifique faltas, confira a memória do cálculo e encaminhe uma decisão para o fluxo existente de Compras.</p></div><a class="proc-primary" href="/Procurement#requisitions">Acompanhar em Compras</a></header>
 <details class="proc-help" open><summary>Como usar</summary><p><strong>Pré-requisito:</strong> cadastre uma política por produto e depósito, com conversão real entre unidade de compra e estoque. Depois escolha a data necessária e o horizonte, analise e abra a memória. A análise não compra nem reserva. Ao confirmar, uma requisição aberta é criada para aprovação; use transferência existente quando houver saldo autorizado em outro depósito.</p></details>
 <nav class="proc-tabs"><button class="active" data-tab="needs">Necessidades</button><button data-tab="policies">Políticas</button></nav>
 <section class="proc-panel active" id="needs"><header><div><h2>Necessidades de materiais</h2><p>Disponibilidade atual, projeção, cobertura existente e próxima ação.</p></div><button class="proc-primary" data-dialog="analysis-dialog">Nova análise</button></header>
  <form class="proc-filter" id="need-filter"><select name="productId" data-products><option value="">Todos os produtos</option></select><select name="warehouseId" data-warehouses><option value="">Todos os depósitos</option></select><select name="status"><option value="">Todas as situações</option><option>IDENTIFIED</option><option>FORWARDED</option><option>FULFILLED</option><option>DISMISSED</option></select><label><input type="checkbox" name="uncoveredOnly" value="true"> Somente descoberta</label><button>Filtrar</button></form><div class="proc-table" id="needs-table"></div>
 </section>
 <section class="proc-panel" id="policies"><header><div><h2>Políticas por produto e depósito</h2><p>Sem consumo, prazo ou segurança inventados.</p></div><button class="proc-primary" data-dialog="policy-dialog">Nova política</button></header><div class="proc-table" id="policies-table"></div></section>
</main>
<dialog id="policy-dialog"><form class="proc-form" id="policy-form"><header><h2>Política de reposição</h2><button type="button" data-close>×</button></header><details class="proc-help"><summary>Como usar</summary><p>Informe valores na unidade de estoque e uma conversão cadastrada e verificável. Alterações críticas exigem confirmação e preservam versão e autoria.</p></details><div class="form-grid"><label>Produto *<select name="productId" data-products required></select></label><label>Depósito *<select name="warehouseId" data-warehouses required></select></label><label>Estoque mínimo (un. estoque) *<input name="minimumStock" type="number" min="0" step=".000001" required></label><label>Estoque desejado (un. estoque) *<input name="targetStock" type="number" min="0" step=".000001" required></label><label>Prazo informado (dias)<input name="replenishmentDays" type="number" min="0"><small>Deixe vazio quando desconhecido.</small></label><label>Lote mínimo (un. compra)<input name="minimumPurchase" type="number" min="0" step=".000001"></label><label>Múltiplo de compra<input name="purchaseMultiple" type="number" min=".000001" step=".000001"></label><label>Unidade de compra *<input name="purchaseUnit" maxlength="16" required placeholder="ex.: CX"></label><label>Conversão para estoque *<input name="stockPerPurchaseUnit" type="number" min=".000001" step=".000001" required><small>Quantidade de unidade de estoque em 1 unidade de compra.</small></label><label>Responsável *<select name="responsibleId" data-responsibles required></select></label><label>Situação *<select name="status"><option>ACTIVE</option><option>INACTIVE</option></select></label></div><button class="proc-primary">Revisar e salvar</button><span class="form-message" role="alert"></span></form></dialog>
<dialog id="analysis-dialog"><form class="proc-form" id="analysis-form"><header><h2>Analisar necessidade</h2><button type="button" data-close>×</button></header><div class="form-grid"><label>Política ativa *<select name="policyId" data-policies required></select></label><label>Data necessária *<input name="neededOn" type="date" required></label><label>Horizonte da análise *<input name="horizonOn" type="date" required></label></div><button class="proc-primary">Calcular no servidor</button><span class="form-message"></span></form></dialog>
<dialog id="detail-dialog" class="proc-wide"><header><h2>Memória e alternativas</h2><button type="button" data-close>×</button></header><div id="need-detail"></div></dialog>
@section Scripts { <script src="~/js/replenishment.js" asp-append-version="true"></script> }
