@page "/saas"
@model Agro360.Web.Pages.Saas.IndexModel
@{ ViewData["Title"]="Administração SaaS"; }
<link rel="stylesheet" href="~/css/saas.css" asp-append-version="true" />
<section class="saas-page"><header><div><span class="eyebrow">Agro360 Enterprise · MNSOFT</span><h1>Plataforma SaaS</h1><p>Super administração e operação segura da sua organização.</p></div><div class="saas-toolbar"><label for="saas-culture">Idioma</label><select id="saas-culture"><option value="pt-BR">Português</option><option value="en-US">English</option><option value="es-ES">Español</option></select><button id="saas-refresh" class="primary-button">Atualizar</button></div></header>
<nav class="saas-tabs" aria-label="Módulos SaaS"><button class="active" data-view="dashboard">Dashboard</button><button data-view="tenants">Organizações</button><button data-view="plans">Planos</button><button data-view="usage">Uso e limites</button><button data-view="onboarding">Onboarding</button><button data-view="users">Usuários</button><button data-view="roles">Perfis e permissões</button><button data-view="invitations">Convites</button><button data-view="security">Sessões e dispositivos</button><button data-view="notifications">Notificações</button><button data-view="settings">Configurações</button><button data-view="account">Portal do cliente</button></nav>
<details class="contextual-help"><summary>Como usar esta tela</summary><p id="saas-help">Consulte os indicadores globais. Ações administrativas exigem permissão e ficam registradas na auditoria.</p></details>
<div id="saas-status" role="status">Carregando dados…</div><main id="saas-content" aria-live="polite" aria-busy="true"></main>
<dialog id="saas-dialog"><form id="saas-form" method="dialog"><h2 id="dialog-title">Cadastro</h2><div id="dialog-fields"></div><p class="form-message" role="alert"></p><footer><button value="cancel">Cancelar</button><button class="primary-button" value="default">Salvar</button></footer></form></dialog></section>
@section Scripts { <script src="~/js/saas.js" asp-append-version="true" defer></script> }
