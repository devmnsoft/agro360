@inject IConfiguration Configuration
@inject IWebHostEnvironment HostEnvironment
@{
    var apiBaseUrl = Configuration["ApiBaseUrl"] ?? "http://localhost:8081";
    var environmentName = HostEnvironment.IsDevelopment() ? "Desenvolvimento"
        : HostEnvironment.IsStaging() ? "Homologação" : "Produção";
    var breadcrumb = (ViewData["Breadcrumb"] as string) ?? (ViewData["Title"] as string) ?? "Agro 360";
}
<!doctype html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f7f5" />
    <meta name="api-base" content="@apiBaseUrl" />
    <meta name="description" content="MNSOFT Agro 360 — o sistema operacional do agronegócio." />
    <title>@ViewData["Title"] · Agro 360</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/icons/agro360.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/agro360.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shell-evolution.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main-content">Ir para o conteúdo</a>
    <svg class="icon-sprite" aria-hidden="true">
        <symbol id="i-grid" viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/></symbol>
        <symbol id="i-leaf" viewBox="0 0 24 24"><path d="M20 4C11 4 5 8.4 5 15c0 1.2.3 2.2.8 3.1M20 4c0 9-4.4 15-11 15-1.2 0-2.2-.3-3.1-.8M20 4 5 19"/></symbol>
        <symbol id="i-map" viewBox="0 0 24 24"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3zM9 3v15M15 6v15"/></symbol>
        <symbol id="i-animal" viewBox="0 0 24 24"><path d="M6 9 3 5v5l3 2m12-3 3-4v5l-3 2M7 8c2-2 8-2 10 0v7c0 4-10 4-10 0zM9 14h.01M15 14h.01M10 17h4"/></symbol>
        <symbol id="i-box" viewBox="0 0 24 24"><path d="m4 7 8-4 8 4-8 4zM4 7v10l8 4 8-4V7M12 11v10"/></symbol>
        <symbol id="i-coins" viewBox="0 0 24 24"><ellipse cx="9" cy="6" rx="6" ry="3"/><path d="M3 6v4c0 1.7 2.7 3 6 3 1.1 0 2.1-.1 3-.4M3 10v4c0 1.7 2.7 3 6 3h1M15 11c3.3 0 6 1.3 6 3s-2.7 3-6 3-6-1.3-6-3 2.7-3 6-3zM9 14v4c0 1.7 2.7 3 6 3s6-1.3 6-3v-4"/></symbol>
        <symbol id="i-truck" viewBox="0 0 24 24"><path d="M3 5h11v12H3zM14 9h4l3 4v4h-7zM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></symbol>
        <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></symbol>
        <symbol id="i-bell" viewBox="0 0 24 24"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4"/></symbol>
        <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></symbol>
        <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
        <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
        <symbol id="i-close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></symbol>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M14 7l5 5-5 5"/></symbol>
        <symbol id="i-users" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
        <symbol id="i-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20M12 2a14.5 14.5 0 0 1 0 20M2 12h20"/></symbol>
    </svg>

    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <a class="brand" href="/" aria-label="Agro 360, início">
                <span class="brand-mark"><svg><use href="#i-leaf" /></svg></span>
                <span><strong>AGRO</strong><b>360</b><small>by MNSOFT</small></span>
            </a>
            <div class="context-card">
                <span class="eyebrow" data-i18n="c.ctx">Contexto ativo</span>
                <strong id="active-farm">Todas as fazendas</strong>
                <button type="button" data-feature="context"><span data-i18n="c.switch">Alterar contexto</span><svg><use href="#i-arrow" /></svg></button>
            </div>
            <nav class="main-nav" aria-label="Navegação principal">
                <span class="nav-label" data-i18n="g.start">Início</span>
                <a class="active" href="/" data-permissions="dashboard.read"><svg><use href="#i-grid" /></svg><span data-i18n="l.home">Início / Dashboard</span></a>
                <a href="/Work" data-permissions="work.read"><svg><use href="#i-bell" /></svg><span data-i18n="l.tasks">Tarefas e Alertas</span></a>
                <a href="/Deployment" data-permissions="deployment.read"><svg><use href="#i-chart" /></svg><span data-i18n="l.deploy">Central de Implantação</span></a>

                <span class="nav-label" data-i18n="g.prod">Produção e Campo</span>
                <a href="/Properties" data-permissions="properties.read"><svg><use href="#i-map" /></svg><span data-i18n="l.props">Fazendas e Unidades</span></a>
                <a href="/Agriculture" data-permissions="agriculture.read"><svg><use href="#i-leaf" /></svg><span data-i18n="l.agri">Agricultura</span></a>
                <a href="/field" data-permissions="mobile.read,agriculture.read"><svg><use href="#i-leaf" /></svg><span data-i18n="l.field">Operação de Campo</span></a>
                <a href="/Maps" data-permissions="properties.read,agriculture.read,maps.read"><svg><use href="#i-map" /></svg><span data-i18n="l.maps">Mapa Operacional</span></a>
                <a href="/Harvest" data-permissions="agriculture.read"><svg><use href="#i-leaf" /></svg><span data-i18n="l.harv">Colheita e Recebimento</span></a>
                <a href="/Costs" data-permissions="finance.read,agriculture.read"><svg><use href="#i-chart" /></svg><span data-i18n="l.costs">Custos da Safra</span></a>
                <a href="/Production" data-permissions="production.read"><svg><use href="#i-chart" /></svg><span data-i18n="l.prod2">Produção Agroindustrial</span></a>

                <span class="nav-label" data-i18n="g.peq">Pecuária</span>
                <a href="/livestock" data-permissions="livestock.read"><svg><use href="#i-animal" /></svg><span data-i18n="l.live">Pecuária</span></a>

                <span class="nav-label" data-i18n="g.stock">Estoques e Compras</span>
                <a href="/Inventory" data-permissions="inventory.read,storage.read"><svg><use href="#i-box" /></svg><span data-i18n="l.inv">Estoque e Almoxarifado</span></a>
                <a href="/Replenishment" data-permissions="inventory.read,purchasing.read"><svg><use href="#i-box" /></svg><span data-i18n="l.repl">Reposição e Necessidades</span></a>
                <a href="/Procurement" data-permissions="purchasing.read"><svg><use href="#i-box" /></svg><span data-i18n="l.proc">Compras e Fornecedores</span></a>

                <span class="nav-label" data-i18n="g.com">Comercial</span>
                <a href="/Commercial" data-permissions="commercial.read"><svg><use href="#i-coins" /></svg><span data-i18n="l.comm">Comercial e Vendas</span></a>
                <a href="/crm" data-permissions="commercial.read,crm.read"><svg><use href="#i-coins" /></svg><span data-i18n="l.crm">CRM e Ciclo do Cliente</span></a>
                <a href="/after-sales" data-permissions="after-sales.read"><svg><use href="#i-box" /></svg><span data-i18n="l.after">Pós-venda</span></a>

                <span class="nav-label" data-i18n="g.log">Logística</span>
                <a href="/Logistics" data-permissions="logistics.read"><svg><use href="#i-truck" /></svg><span data-i18n="l.logi">Expedição e Entrega</span></a>

                <span class="nav-label" data-i18n="g.fin">Financeiro/Fiscal</span>
                <a href="/Finance" data-permissions="finance.read"><svg><use href="#i-coins" /></svg><span data-i18n="l.fin2">Financeiro e Custos</span></a>
                <a href="/Fiscal" data-permissions="fiscal.read"><svg><use href="#i-chart" /></svg><span data-i18n="l.fisc">Fiscal</span></a>
                <a href="/Documents" data-permissions="documents.read"><svg><use href="#i-box" /></svg><span data-i18n="l.docs">Documentos e Evidências</span></a>

                <span class="nav-label" data-i18n="g.qual">Qualidade e Rastreabilidade</span>
                <a href="/Compliance" data-permissions="compliance.read,esg.read"><svg><use href="#i-leaf" /></svg><span data-i18n="l.comp">Qualidade e Compliance</span></a>
                <a href="/Inspections" data-permissions="compliance.read,compliance.inspections.execute"><svg><use href="#i-leaf" /></svg><span data-i18n="l.insp">Modelos e Inspeções</span></a>

                <span class="nav-label" data-i18n="g.people">Pessoas e Recursos</span>
                <a href="/RuralHr" data-permissions="rural-hr.read"><svg><use href="#i-users" /></svg><span data-i18n="l.hr">RH Rural</span></a>
                <a href="/Sst" data-permissions="sst.read,compliance.read"><svg><use href="#i-users" /></svg><span data-i18n="l.sst">SST Rural</span></a>
                <a href="/Fleet" data-permissions="fleet.read"><svg><use href="#i-truck" /></svg><span data-i18n="l.fleet">Frota e Manutenção</span></a>

                <span class="nav-label" data-i18n="g.coop">Cooperativas</span>
                <a href="/Cooperatives" data-permissions="cooperative.read,commercial.read"><svg><use href="#i-globe" /></svg><span data-i18n="l.coop2">Cooperativas e Marketplace</span></a>

                <span class="nav-label" data-i18n="g.sus">Sustentabilidade/Exportação</span>
                <a href="/sustentabilidade" data-permissions="esg.read,compliance.read,sustainability.read"><svg><use href="#i-leaf" /></svg><span data-i18n="l.sus2">Sustentabilidade e ESG</span></a>
                <a href="/Export" data-permissions="export.read,commercial.read"><svg><use href="#i-globe" /></svg><span data-i18n="l.exp">Exportação e Trading</span></a>

                <span class="nav-label" data-i18n="g.rep">Relatórios</span>
                <a href="/Reports" data-permissions="intelligence.read,finance.export"><svg><use href="#i-chart" /></svg><span data-i18n="l.rep2">Relatórios e Analytics</span></a>
                <a href="/intelligence" data-permissions="intelligence.read"><svg><use href="#i-chart" /></svg><span data-i18n="l.int">Inteligência Agro360</span></a>
                <a href="/inteligencia-agro360" data-permissions="intelligence.read"><svg><use href="#i-chart" /></svg><span data-i18n="l.exe">Painel Executivo 360</span></a>

                <span class="nav-label" data-i18n="g.org">Minha organização</span>
                <a href="/Saas?view=account" data-permissions="account.users.read,account.subscription.manage,account.settings.manage"><svg><use href="#i-grid" /></svg><span data-i18n="l.org2">Minha Organização</span></a>
                <a href="/Saas?view=users" data-permissions="account.users.read"><svg><use href="#i-users" /></svg><span data-i18n="l.users">Usuários e Perfis</span></a>
                <a href="/Ecosystem" data-permissions="marketplace.read"><svg><use href="#i-grid" /></svg><span data-i18n="l.mods">Meus Módulos</span></a>
                <a href="/Governance" data-permissions="governance.read,integrations.read"><svg><use href="#i-grid" /></svg><span data-i18n="l.sett">Configurações</span></a>
                <a href="/Integrations" data-permissions="integrations.read,governance.read"><svg><use href="#i-grid" /></svg><span data-i18n="l.integ">Integrações</span></a>
                <a href="/Support" data-public-menu="true"><svg><use href="#i-bell" /></svg><span data-i18n="l.sup">Ajuda / Suporte</span></a>

                <span class="nav-label" data-i18n="g.glob">Administração global</span>
                <a href="/Platform" data-super-admin="true"><svg><use href="#i-grid" /></svg><span data-i18n="l.glob2">Administração Global MNSOFT</span><i>global</i></a>
            </nav>
            <div class="sidebar-footer">
                <div class="sync-state"><span></span><div><strong>Serviços online</strong><small id="sync-time">verificando agora</small></div></div>
                <button class="user-chip" type="button" id="logout-button">
                    <span id="user-initials">A3</span>
                    <div><strong id="user-name">Agro 360</strong><small id="user-email">Entrar na conta</small></div>
                </button>
            </div>
        </aside>

        <main class="main-content" id="main-content">
            <header class="topbar">
                <button class="icon-button menu-button" type="button" id="menu-button" aria-label="Abrir menu" data-i18n-aria="a.menu"><svg><use href="#i-menu" /></svg></button>
                <button class="search-trigger" type="button" id="search-trigger">
                    <svg><use href="#i-search" /></svg><span data-i18n="t.search">Buscar animal, fazenda, produto, safra...</span><kbd>Ctrl K</kbd>
                </button>
                <div class="top-actions">
                    <label class="culture-select" title="Idioma da interface" data-i18n-title="a.lang">
                        <svg><use href="#i-globe" /></svg>
                        <select id="top-culture" data-culture-select aria-label="Idioma da interface" data-i18n-aria="a.lang">
                            <option value="pt-BR">Português</option>
                            <option value="en-US">English</option>
                            <option value="es-ES">Español</option>
                            <option value="fr-FR">Français</option>
                        </select>
                    </label>
                    <button class="icon-button" type="button" id="theme-button" aria-label="Alternar tema" data-i18n-aria="a.theme"><svg><use href="#i-sun" /></svg></button>
                    <a class="icon-button notification-button" href="/Compliance" aria-label="Alertas de conformidade" data-i18n-aria="a.alerts"><svg><use href="#i-bell" /></svg><span></span></a>
                </div>
            </header>
            <div class="assisted-context-banner" id="assisted-context-banner" hidden data-visible="false" role="status">
                <div>
                    <strong id="assisted-context-title">Contexto de suporte assistido</strong>
                    <small id="assisted-context-subtitle">Você está operando como SuperAdmin no ambiente do cliente. Toda ação é auditada no ator real.</small>
                </div>
                <button type="button" class="secondary-button" id="end-assisted-session-btn" style="white-space:nowrap;padding:0.35rem 0.75rem;font-size:12px;margin-left:auto;" data-i18n="b.end">Encerrar contexto</button>
            </div>
            <nav class="page-breadcrumb" id="page-breadcrumb" aria-label="Você está em">
                <span aria-current="page">@breadcrumb</span>
            </nav>
            @if (IsSectionDefined("ScreenHelp"))
            {
                @await RenderSectionAsync("ScreenHelp")
            }
            else
            {
                <details class="screen-help global-screen-help">
                    <summary><span data-i18n="d.help">Como funciona esta tela</span><small data-i18n="d.hint">orientação rápida</small></summary>
                    <div>
                        <p><strong>Para que serve:</strong> esta área reúne os dados e ações de @ViewData["Title"] disponíveis para o seu cliente e perfil.</p>
                        <p><strong>Como trabalhar:</strong> confira o contexto ativo, preencha os campos marcados com * e use os seletores por nome — nunca informe IDs técnicos.</p>
                        <p><strong>Regras e resultado:</strong> plano, status, permissões e validações podem limitar ações. Ao salvar, o dado é persistido e auditado; ações críticas pedem confirmação e qualquer falha apresenta uma orientação ou código de suporte.</p>
                    </div>
                </details>
            }
            @RenderBody()
        </main>
    </div>

    <div class="modal-backdrop login-backdrop" id="login-modal" role="dialog" aria-modal="true" aria-labelledby="login-title" hidden>
        <section class="login-experience">
        <aside class="login-story" aria-hidden="true">
            <div class="login-brand"><span class="brand-mark"><svg><use href="#i-leaf" /></svg></span><span>AGRO <b>360</b><small>BY MNSOFT</small></span></div>
            <span class="eyebrow">Inteligência para o campo</span>
            <h2>Gestão conectada.<br />Decisões que cultivam futuro.</h2>
            <p>Dados, operação e governança em uma plataforma segura, desenhada para o agronegócio.</p>
            <div class="login-benefits">
                <span><strong>360°</strong> visão integrada</span>
                <span><strong>24/7</strong> operação conectada</span>
                <span><strong>1 tenant</strong> por ambiente</span>
            </div>
            <div class="login-signal"><i></i><span>Ambiente protegido e multitenant</span></div>
        </aside>
        <form class="login-card" id="login-form" novalidate>
            <div class="login-brand"><span class="brand-mark"><svg><use href="#i-leaf" /></svg></span><span>AGRO <b>360</b></span></div>
            <div class="login-heading"><span class="eyebrow" data-i18n="lg.secure">Acesso seguro</span><span class="environment-badge">@environmentName</span></div>
            <h2 id="login-title" data-i18n="lg.title">Bem-vindo ao Agro360</h2>
            <p data-i18n="lg.sub">Seu acesso é validado diretamente no banco e as permissões são carregadas conforme o seu perfil.</p>
            <details class="contextual-help"><summary data-i18n="d.help">Como funciona esta tela</summary><p>Informe a organização, seu e-mail, CPF ou CNPJ e a senha. Todos os campos são obrigatórios; documentos aceitam máscara. Ao entrar, o sistema valida usuário, tenant, perfil e módulos e abre somente as áreas autorizadas. Nunca compartilhe sua senha e confira a organização antes de continuar.</p></details>
            <label><span data-i18n="lg.tenant">Cliente / Organização</span><input name="tenantSlug" autocomplete="organization" placeholder="ex.: minha-fazenda" aria-describedby="tenantSlug-help tenantSlug-error" data-help="Informe o identificador do ambiente fornecido pelo administrador; não use CNPJ ou um ID técnico." required /><small class="login-field-help" id="tenantSlug-help" data-i18n="lg.tenantHelp">Identificador exclusivo do ambiente da sua empresa.</small><span class="login-field-error" id="tenantSlug-error"></span></label>
            <label><span data-i18n="lg.email">E-mail, CPF ou CNPJ</span><input name="email" type="text" inputmode="text" autocomplete="username" maxlength="254" placeholder="voce@empresa.com.br" aria-describedby="email-help email-error" data-help="Use o e-mail, CPF ou CNPJ habilitado pelo administrador do seu cliente." required /><small class="login-field-help" id="email-help" data-i18n="lg.emailHelp">Documentos podem ser informados com ou sem máscara.</small><span class="login-field-error" id="email-error"></span></label>
            <label><span data-i18n="lg.password">Senha</span><span class="password-input"><input id="login-password" name="password" type="password" autocomplete="current-password" minlength="12" placeholder="••••••••••••" aria-describedby="password-error" data-help="Digite sua senha de acesso. O Agro360 nunca exibe nem envia a senha em mensagens." required /><button type="button" class="password-toggle" aria-controls="login-password" aria-pressed="false" data-i18n="lg.show">Mostrar</button></span><span class="login-field-error" id="password-error"></span></label>
            <details class="contextual-help" id="login-additional-step"><summary data-i18n="lg.first">Primeiro acesso ou administração global</summary><label><span data-i18n="lg.mfa">Código MFA</span><input name="mfaCode" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code"><small data-i18n="lg.mfaHelp">Obrigatório para a administração global.</small></label><label><span data-i18n="lg.newpw">Nova senha</span><input name="newPassword" type="password" autocomplete="new-password" minlength="12"><small data-i18n="lg.pwHelp">Preencha quando o acesso inicial exigir troca de senha.</small></label><label><span data-i18n="lg.newpw2">Confirmar nova senha</span><input name="newPasswordConfirmation" type="password" autocomplete="new-password" minlength="12"></label></details>
            <button class="primary-button" type="submit"><span data-i18n="lg.enter">Entrar no Agro360</span><svg><use href="#i-arrow" /></svg></button>
            <button class="connection-button" id="test-api-connection" type="button"><i></i><span data-i18n="lg.test">Testar conexão com a API</span></button>
            @if (HostEnvironment.IsDevelopment())
            {
                <a class="swagger-link" href="@($"{apiBaseUrl.TrimEnd('/')}/swagger")" target="_blank" rel="noopener noreferrer">Abrir documentação Swagger ↗</a>
            }
            <div class="form-message" id="login-message" role="alert" aria-live="assertive"></div>
            <small data-i18n="lg.footer">Agro360 by MNSOFT · Sessão criptografada e isolada por cliente.</small>
        </form>
        </section>
    </div>

    <div class="modal-backdrop palette-backdrop" id="command-palette" role="dialog" aria-modal="true" aria-label="Busca global" data-i18n-aria="a.palette" hidden>
        <div class="command-palette">
            <div class="palette-input"><svg><use href="#i-search" /></svg><input id="global-search" autocomplete="off" placeholder="O que você procura?" data-i18n-placeholder="t.palette" /><kbd>ESC</kbd></div>
            <div class="palette-results" id="search-results"><p data-i18n="t.paletteHint">Digite pelo menos dois caracteres para buscar em toda a operação.</p></div>
            <footer><span>↑↓ navegar</span><span>↵ abrir</span><span data-i18n="t.perms">Resultados respeitam suas permissões</span></footer>
        </div>
    </div>

    <div class="toast-region" id="toast-region" aria-live="polite"></div>
    <dialog class="action-confirmation" id="context-switcher-dialog" aria-labelledby="context-switcher-title">
        <form method="dialog" id="context-switcher-form">
            <span class="eyebrow" data-i18n="d.csUnit">Filtro de Unidade</span>
            <h2 id="context-switcher-title" data-i18n="d.csTitle">Alternar contexto operacional</h2>
            <p data-i18n="d.csDesc">Selecione a fazenda ou unidade de trabalho. A seleção filtra o conjunto autorizado e atualiza consultas e lançamentos nesta sessão.</p>
            <div id="context-switcher-fields">
                <label for="context-farm-select"><span data-i18n="d.csSelect">Unidade / Fazenda ativa</span>
                    <select id="context-farm-select" name="farmId" style="width:100%;padding:0.5rem;margin-top:0.35rem">
                        <option value="" data-i18n="d.csAll">Todas as unidades autorizadas (união do escopo)</option>
                    </select>
                </label>
                <div id="context-switcher-preview" style="margin-top:0.5rem;font-size:0.85rem;color:var(--color-muted,#555)"></div>
            </div>
            <div class="form-actions" style="margin-top:1rem">
                <button type="submit" value="cancel" class="secondary-button" data-i18n="d.cancel">Cancelar</button>
                <button type="submit" value="apply" class="primary-button" id="context-switcher-apply" data-i18n="d.apply">Aplicar contexto</button>
            </div>
        </form>
    </dialog>
    <dialog class="action-confirmation" id="action-confirmation" aria-labelledby="confirmation-title" aria-describedby="confirmation-consequence">
        <form method="dialog" id="confirmation-form">
            <span class="eyebrow" data-confirmation-kind>Ação sensível</span>
            <h2 id="confirmation-title" data-i18n="d.confirmTitle">Confirme a operação</h2>
            <p id="confirmation-consequence"></p>
            <label id="confirmation-reason-field" hidden><span data-i18n="d.reason">Justificativa</span> <span aria-hidden="true">*</span>
                <textarea id="confirmation-reason" maxlength="1000"></textarea>
                <small data-i18n="d.reasonHint">Informe um motivo objetivo; ele será enviado ao endpoint e registrado na auditoria.</small>
                <span class="field-validation" id="confirmation-reason-error" role="alert"></span>
            </label>
            <div class="form-actions">
                <button type="submit" value="cancel" class="secondary-button" data-i18n="d.back">Voltar sem alterar</button>
                <button type="submit" value="confirm" class="danger-button" id="confirmation-submit" data-i18n="d.confirmBtn">Confirmar ação</button>
            </div>
        </form>
    </dialog>
    <script src="~/js/agro360.js" asp-append-version="true"></script>
    <script src="~/js/forms.js" asp-append-version="true"></script>
    <script src="~/js/shell-evolution.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
