@inject IConfiguration Configuration
@inject IWebHostEnvironment HostEnvironment
@{
    var apiBaseUrl = Configuration["ApiBaseUrl"] ?? "http://localhost:8081";
    var environmentName = HostEnvironment.IsDevelopment() ? "Desenvolvimento"
        : HostEnvironment.IsStaging() ? "Homologação" : "Produção";
}
<!doctype html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f7f5" />
    <meta name="api-base" content="@apiBaseUrl" />
    <meta name="description" content="MNSOFT Agro 360 — o sistema operacional do agronegócio." />
    <title>@ViewData["Title"] · Agro 360</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/icons/agro360.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/agro360.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <svg class="icon-sprite" aria-hidden="true">
        <symbol id="i-grid" viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/></symbol>
        <symbol id="i-leaf" viewBox="0 0 24 24"><path d="M20 4C11 4 5 8.4 5 15c0 1.2.3 2.2.8 3.1M20 4c0 9-4.4 15-11 15-1.2 0-2.2-.3-3.1-.8M20 4 5 19"/></symbol>
        <symbol id="i-map" viewBox="0 0 24 24"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3zM9 3v15M15 6v15"/></symbol>
        <symbol id="i-animal" viewBox="0 0 24 24"><path d="M6 9 3 5v5l3 2m12-3 3-4v5l-3 2M7 8c2-2 8-2 10 0v7c0 4-10 4-10 0zM9 14h.01M15 14h.01M10 17h4"/></symbol>
        <symbol id="i-box" viewBox="0 0 24 24"><path d="m4 7 8-4 8 4-8 4zM4 7v10l8 4 8-4V7M12 11v10"/></symbol>
        <symbol id="i-coins" viewBox="0 0 24 24"><ellipse cx="9" cy="6" rx="6" ry="3"/><path d="M3 6v4c0 1.7 2.7 3 6 3 1.1 0 2.1-.1 3-.4M3 10v4c0 1.7 2.7 3 6 3h1M15 11c3.3 0 6 1.3 6 3s-2.7 3-6 3-6-1.3-6-3 2.7-3 6-3zM9 14v4c0 1.7 2.7 3 6 3s6-1.3 6-3v-4"/></symbol>
        <symbol id="i-truck" viewBox="0 0 24 24"><path d="M3 5h11v12H3zM14 9h4l3 4v4h-7zM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></symbol>
        <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></symbol>
        <symbol id="i-bell" viewBox="0 0 24 24"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4"/></symbol>
        <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></symbol>
        <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
        <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
        <symbol id="i-close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></symbol>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M14 7l5 5-5 5"/></symbol>
    </svg>

    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <a class="brand" href="/" aria-label="Agro 360, início">
                <span class="brand-mark"><svg><use href="#i-leaf" /></svg></span>
                <span><strong>AGRO</strong><b>360</b><small>by MNSOFT</small></span>
            </a>
            <div class="context-card">
                <span class="eyebrow">Contexto ativo</span>
                <strong id="active-farm">Todas as fazendas</strong>
                <button type="button" data-feature="context">Alterar contexto <svg><use href="#i-arrow" /></svg></button>
            </div>
            <nav class="main-nav" aria-label="Navegação principal">
                <span class="nav-label">Visão geral</span>
                <a class="active" href="/" data-permissions="dashboard.read"><svg><use href="#i-grid" /></svg><span>Início / Dashboard</span></a>
                <a href="/Saas" data-super-admin="true"><svg><use href="#i-grid" /></svg><span>Administração SaaS MNSOFT</span><i>global</i></a>
                <a href="/Saas" data-super-admin="true"><svg><use href="#i-chart" /></svg><span>Clientes / Tenants</span></a>
                <a href="/Saas" data-permissions="governance.read,security.sessions"><svg><use href="#i-grid" /></svg><span>Usuários e Perfis</span></a>
                <a href="/Agriculture" data-permissions="properties.read"><svg><use href="#i-map" /></svg><span>Fazendas e Unidades</span></a>
                <span class="nav-label">Operação</span>
                <a href="/Agriculture" data-permissions="agriculture.read"><svg><use href="#i-leaf" /></svg><span>Agricultura</span></a>
                <a href="/#livestock" data-permissions="livestock.read"><svg><use href="#i-animal" /></svg><span>Pecuária</span></a>
                <a href="/#storage" data-permissions="inventory.read,storage.read"><svg><use href="#i-box" /></svg><span>Estoque e Almoxarifado</span></a>
                <a href="/Procurement" data-permissions="purchasing.read"><svg><use href="#i-box" /></svg><span>Compras e Fornecedores</span></a>
                <a href="/Production" data-permissions="production.read"><svg><use href="#i-chart" /></svg><span>Produção Agroindustrial</span></a>
                <a href="/Commercial" data-permissions="commercial.read"><svg><use href="#i-coins" /></svg><span>Comercial e Vendas</span></a>
                <a href="/Finance" data-permissions="finance.read"><svg><use href="#i-coins" /></svg><span>Financeiro e Custos</span></a>
                <a href="/Maps" data-permissions="logistics.read,regional-logistics.read"><svg><use href="#i-truck" /></svg><span>Logística</span></a>
                <a href="/Compliance" data-permissions="compliance.read,esg.read"><svg><use href="#i-leaf" /></svg><span>Qualidade e Compliance</span></a>
                <a href="/Documents" data-permissions="documents.read"><svg><use href="#i-box" /></svg><span>Documentos e Evidências</span></a>
                <a href="/Reports" data-permissions="intelligence.read,finance.export"><svg><use href="#i-chart" /></svg><span>Relatórios e Analytics</span></a>
                <span class="nav-label">Sistema</span>
                <a href="/Governance" data-permissions="governance.read,integrations.read"><svg><use href="#i-grid" /></svg><span>Configurações</span></a>
                <a href="/Support" data-public-menu="true"><svg><use href="#i-bell" /></svg><span>Ajuda / Manual do Sistema</span></a>
            </nav>
            <div class="sidebar-footer">
                <div class="sync-state"><span></span><div><strong>Serviços online</strong><small id="sync-time">verificando agora</small></div></div>
                <button class="user-chip" type="button" id="logout-button">
                    <span id="user-initials">A3</span>
                    <div><strong id="user-name">Agro 360</strong><small id="user-email">Entrar na conta</small></div>
                </button>
            </div>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <button class="icon-button menu-button" type="button" id="menu-button" aria-label="Abrir menu"><svg><use href="#i-menu" /></svg></button>
                <button class="search-trigger" type="button" id="search-trigger">
                    <svg><use href="#i-search" /></svg><span>Buscar animal, fazenda, produto, safra...</span><kbd>Ctrl K</kbd>
                </button>
                <div class="top-actions">
                    <span class="weather-pill"><small>Belém, PA</small><strong>29°</strong><i>tempo</i></span>
                    <button class="icon-button" type="button" id="theme-button" aria-label="Alternar tema"><svg><use href="#i-sun" /></svg></button>
                    <a class="icon-button notification-button" href="/Compliance" aria-label="Alertas de conformidade"><svg><use href="#i-bell" /></svg><span></span></a>
                </div>
            </header>
            <details class="screen-help global-screen-help">
                <summary><span>Como usar esta tela</span><small>orientação rápida</small></summary>
                <div>
                    <p><strong>Para que serve:</strong> esta área reúne os dados e ações de @ViewData["Title"] disponíveis para o seu cliente e perfil.</p>
                    <p><strong>Como trabalhar:</strong> confira o contexto ativo, preencha os campos marcados com * e use os seletores por nome — nunca informe IDs técnicos.</p>
                    <p><strong>Regras e resultado:</strong> plano, status, permissões e validações podem limitar ações. Ao salvar, o dado é persistido e auditado; ações críticas pedem confirmação e qualquer falha apresenta uma orientação ou código de suporte.</p>
                </div>
            </details>
            @RenderBody()
        </main>
    </div>

    <div class="modal-backdrop login-backdrop" id="login-modal" role="dialog" aria-modal="true" aria-labelledby="login-title" hidden>
        <section class="login-experience">
        <aside class="login-story" aria-hidden="true">
            <div class="login-brand"><span class="brand-mark"><svg><use href="#i-leaf" /></svg></span><span>AGRO <b>360</b><small>BY MNSOFT</small></span></div>
            <span class="eyebrow">Inteligência para o campo</span>
            <h2>Gestão conectada.<br />Decisões que cultivam futuro.</h2>
            <p>Dados, operação e governança em uma plataforma segura, desenhada para o agronegócio.</p>
            <div class="login-benefits">
                <span><strong>360°</strong> visão integrada</span>
                <span><strong>24/7</strong> operação conectada</span>
                <span><strong>1 tenant</strong> por ambiente</span>
            </div>
            <div class="login-signal"><i></i><span>Ambiente protegido e multitenant</span></div>
        </aside>
        <form class="login-card" id="login-form" novalidate>
            <div class="login-brand"><span class="brand-mark"><svg><use href="#i-leaf" /></svg></span><span>AGRO <b>360</b></span></div>
            <div class="login-heading"><span class="eyebrow">Acesso seguro</span><span class="environment-badge">@environmentName</span></div>
            <h2 id="login-title">Bem-vindo ao Agro360</h2>
            <p>Seu acesso é validado diretamente no banco e as permissões são carregadas conforme o seu perfil.</p>
            <label>Cliente / Organização<input name="tenantSlug" autocomplete="organization" placeholder="ex.: minha-fazenda" aria-describedby="tenantSlug-help tenantSlug-error" data-help="Informe o identificador do ambiente fornecido pelo administrador; não use CNPJ ou um ID técnico." required /><small class="login-field-help" id="tenantSlug-help">Identificador exclusivo do ambiente da sua empresa.</small><span class="login-field-error" id="tenantSlug-error"></span></label>
            <label>E-mail, CPF ou CNPJ<input name="email" type="text" inputmode="text" autocomplete="username" maxlength="254" placeholder="voce@empresa.com.br" aria-describedby="email-help email-error" data-help="Use o e-mail ou documento habilitado pelo administrador do seu cliente." required /><small class="login-field-help" id="email-help">CPF/CNPJ só funciona quando previamente configurado no seu cadastro.</small><span class="login-field-error" id="email-error"></span></label>
            <label>Senha<input name="password" type="password" autocomplete="current-password" minlength="12" placeholder="••••••••••••" aria-describedby="password-error" data-help="Digite sua senha de acesso. O Agro360 nunca exibe nem envia a senha em mensagens." required /><span class="login-field-error" id="password-error"></span></label>
            <button class="primary-button" type="submit"><span>Entrar no Agro360</span><svg><use href="#i-arrow" /></svg></button>
            <button class="connection-button" id="test-api-connection" type="button"><i></i><span>Testar conexão com a API</span></button>
            @if (HostEnvironment.IsDevelopment())
            {
                <a class="swagger-link" href="@($"{apiBaseUrl.TrimEnd('/')}/swagger")" target="_blank" rel="noopener noreferrer">Abrir documentação Swagger ↗</a>
            }
            <div class="form-message" id="login-message" role="alert" aria-live="assertive"></div>
            <small>Agro360 by MNSOFT · Sessão criptografada e isolada por cliente.</small>
        </form>
        </section>
    </div>

    <div class="modal-backdrop palette-backdrop" id="command-palette" role="dialog" aria-modal="true" aria-label="Busca global" hidden>
        <div class="command-palette">
            <div class="palette-input"><svg><use href="#i-search" /></svg><input id="global-search" autocomplete="off" placeholder="O que você procura?" /><kbd>ESC</kbd></div>
            <div class="palette-results" id="search-results"><p>Digite pelo menos dois caracteres para buscar em toda a operação.</p></div>
            <footer><span>↑↓ navegar</span><span>↵ abrir</span><span>Resultados respeitam suas permissões</span></footer>
        </div>
    </div>

    <div class="toast-region" id="toast-region" aria-live="polite"></div>
    <dialog class="action-confirmation" id="action-confirmation" aria-labelledby="confirmation-title" aria-describedby="confirmation-consequence">
        <form method="dialog" id="confirmation-form">
            <span class="eyebrow" data-confirmation-kind>Ação sensível</span>
            <h2 id="confirmation-title">Confirme a operação</h2>
            <p id="confirmation-consequence"></p>
            <label id="confirmation-reason-field" hidden>Justificativa <span aria-hidden="true">*</span>
                <textarea id="confirmation-reason" maxlength="1000"></textarea>
                <small>Informe um motivo objetivo; ele será enviado ao endpoint e registrado na auditoria.</small>
                <span class="field-validation" id="confirmation-reason-error" role="alert"></span>
            </label>
            <div class="form-actions">
                <button type="submit" value="cancel" class="secondary-button">Voltar sem alterar</button>
                <button type="submit" value="confirm" class="danger-button" id="confirmation-submit">Confirmar ação</button>
            </div>
        </form>
    </dialog>
    <script src="~/js/agro360.js" asp-append-version="true" defer></script>
    <script src="~/js/forms.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
