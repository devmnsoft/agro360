@page
@model Agro360.Web.Pages.Sst.IndexModel
@{ ViewData["Title"]="SST Rural"; }
@section Head { <link rel="stylesheet" href="~/css/sst.css" asp-append-version="true" /> }
<section class="sst-shell" id="sst-app" aria-busy="true">
<header class="sst-hero"><div><span class="eyebrow">Segurança operacional · Sprint 34</span><h1>SST Rural</h1><p>Riscos, pessoas, proteção e conformidade em uma visão auditável.</p></div><a class="sst-export" href="#" id="sst-export">Exportar riscos CSV</a></header>
<nav class="sst-tabs" aria-label="Áreas SST"><button data-view="dashboard" class="active">Dashboard</button><button data-view="workers">Trabalhadores</button><button data-view="risks">Riscos</button><button data-view="epi">EPIs</button><button data-view="training">Treinamentos</button><button data-view="exams">Exames</button><button data-view="incidents">Incidentes</button><button data-view="actions">Ações</button><button data-view="checklists">Checklists</button></nav>
<div id="sst-message" class="sst-message" role="status"></div>
<section data-panel="dashboard"><div id="sst-metrics" class="sst-metrics"><div class="sst-loading">Consolidando indicadores reais…</div></div><div class="sst-panel"><h2>Painel de pendências</h2><p>Os indicadores consideram apenas o tenant ativo e permanecem estáveis quando ainda não há registros.</p></div></section>
<section data-panel="workers" hidden><div class="sst-toolbar"><input id="worker-search" placeholder="Buscar por nome ou matrícula" /><button data-open="worker-form">Novo trabalhador</button></div><form id="worker-form" class="sst-form" hidden><h2>Novo trabalhador</h2><label>Nome<input name="name" maxlength="160" required /></label><label>Documento (opcional)<input name="document" maxlength="40" /></label><label>Matrícula<input name="internalCode" maxlength="40" /></label><label>Função<select name="jobRoleId" data-lookup="roles" required></select></label><label>Área<select name="workAreaId" data-lookup="areas" required></select></label><label>Status<select name="status" required><option value="ACTIVE">Ativo</option><option value="INACTIVE">Inativo</option><option value="ON_LEAVE">Afastado</option><option value="OUTSOURCED">Terceirizado</option><option value="PENDING">Pendente de cadastro</option></select></label><label>Vínculo<input name="employmentType" required maxlength="40" /></label><label>Admissão<input name="admissionDate" type="date" /></label><button>Salvar trabalhador</button></form><div id="workers-list" class="sst-table"></div></section>
<section data-panel="risks" hidden><div class="sst-toolbar"><input id="risk-search" placeholder="Buscar risco" /><button data-open="risk-form">Novo risco</button></div><form id="risk-form" class="sst-form" hidden><h2>Novo risco</h2><label>Nome<input name="name" required maxlength="160" /></label><label>Descrição<textarea name="description" required maxlength="2000"></textarea></label><label>Tipo<select name="type" required><option value="PHYSICAL">Físico</option><option value="CHEMICAL">Químico</option><option value="BIOLOGICAL">Biológico</option><option value="ERGONOMIC">Ergonômico</option><option value="ACCIDENT">Acidente</option><option value="OPERATIONAL">Operacional</option><option value="MACHINERY">Máquinas/equipamentos</option><option value="OTHER">Outro</option></select></label><label>Área<select name="workAreaId" data-lookup="areas" required></select></label><label>Severidade<input name="severity" type="number" min="1" max="5" required /></label><label>Probabilidade<input name="probability" type="number" min="1" max="5" required /></label><label>Medida preventiva<textarea name="preventiveMeasure" maxlength="2000"></textarea></label><input name="status" type="hidden" value="ACTIVE" /><button>Salvar risco</button></form><div id="risks-list" class="sst-table"></div></section>
<section data-panel="epi" hidden><div class="sst-panel"><h2>Nova entrega de EPI</h2><form id="epi-form" class="sst-form"><label>Trabalhador ativo<select name="workerId" data-lookup="workers" required></select></label><label>EPI ativo<select name="epiId" data-lookup="epis" required></select></label><label>Quantidade<input name="quantity" type="number" min="0.01" step="0.01" required /></label><label>Entrega<input name="deliveredOn" type="date" required /></label><label>Troca prevista<input name="replaceOn" type="date" /></label><label>Motivo<input name="reason" required maxlength="500" /></label><label>Aceite textual<input name="acceptance" maxlength="300" /></label><button>Registrar entrega</button></form></div></section>
<section data-panel="incidents" hidden><div class="sst-toolbar"><input id="incident-search" placeholder="Buscar código ou descrição" /><button data-open="incident-form">Novo incidente</button></div><form id="incident-form" class="sst-form" hidden><h2>Registrar incidente</h2><label>Tipo<select name="type"><option value="NEAR_MISS">Quase acidente</option><option value="ACCIDENT_WITH_LEAVE">Acidente com afastamento</option><option value="UNSAFE_CONDITION">Condição insegura</option><option value="OTHER">Outro</option></select></label><label>Data e hora<input name="occurredAt" type="datetime-local" required /></label><label>Local<input name="location" required maxlength="300" /></label><label>Área<select name="workAreaId" data-lookup="areas" required></select></label><label>Descrição<textarea name="description" required maxlength="4000"></textarea></label><label>Severidade<input name="severity" type="number" min="1" max="5" required /></label><label>Ação imediata<textarea name="immediateAction" required maxlength="2000"></textarea></label><label>Responsável<select name="responsibleId" data-lookup="workers" required></select></label><label class="check"><input name="investigationRequired" type="checkbox" /> Necessita investigação</label><label class="check"><input name="correctiveActionRequired" type="checkbox" /> Necessita ação corretiva</label><button>Registrar ocorrência</button></form><div id="incidents-list" class="sst-table"></div></section>
<section data-panel="training" hidden><div class="sst-empty"><b>Treinamentos e participantes</b><p>Catálogo, requisitos, sessões e validades são controlados pela API SST. Cadastre os registros autorizados para iniciar.</p></div></section><section data-panel="exams" hidden><div class="sst-empty"><b>Controle ocupacional administrativo</b><p>Somente tipo, agenda, validade, resultado administrativo e evidência autorizada. Nenhum laudo clínico detalhado é coletado.</p></div></section><section data-panel="actions" hidden><div class="sst-empty"><b>Planos corretivos e preventivos</b><p>Ações vencidas entram automaticamente no indicador e toda conclusão exige evidência ou justificativa.</p></div></section><section data-panel="checklists" hidden><div class="sst-empty"><b>Execução segura no campo</b><p>Selecione um template publicado; itens obrigatórios e evidências configuradas são validados no servidor.</p></div></section>
</section>
@section Scripts { <script src="~/js/sst.js" asp-append-version="true"></script> }
