@page "/support"
@model Agro360.Web.Pages.Support.IndexModel
@{ ViewData["Title"] = "Atendimento e Suporte"; }
<link rel="stylesheet" href="~/css/support.css" asp-append-version="true" />
<section class="support-page" data-api="support">
 <header class="support-hero"><div><span class="eyebrow">Customer Success · SLA rastreável</span><h1>Atendimento e Suporte</h1><p>Uma central humana para chamados, implantação, conhecimento, adoção e evolução do produto.</p></div><button class="primary-button" data-open="ticket-form">Abrir chamado</button></header>
 <div id="support-status" class="support-status" role="status">Carregando dados reais do atendimento…</div>
 <div id="support-kpis" class="support-kpis" aria-label="Indicadores de atendimento"></div>
 <nav class="support-tabs" aria-label="Áreas de atendimento"><button class="active" data-panel="tickets">Chamados</button><button data-panel="sla">SLA</button><button data-panel="articles">Central de Ajuda</button><button data-panel="implementations">Implantação</button><button data-panel="trainings">Treinamentos</button><button data-panel="feedback">Feedback</button><button data-panel="backlog">Melhorias</button><button data-panel="releases">Release notes</button></nav>
 <section id="tickets" class="support-panel active"><div class="panel-head"><div><h2>Chamados</h2><p>Triagem, respostas e histórico isolados por tenant.</p></div><a class="secondary-button" href="#" id="tickets-csv">Exportar CSV</a></div><form class="filters" id="ticket-filters"><input name="search" maxlength="120" placeholder="Código, título ou assunto" /><select name="status"><option value="">Todos os status</option><option value="OPEN">Aberto</option><option value="TRIAGE">Em triagem</option><option value="IN_PROGRESS">Em atendimento</option><option value="WAITING_CUSTOMER">Aguardando cliente</option><option value="RESOLVED">Resolvido</option><option value="CLOSED">Fechado</option></select><select name="priority"><option value="">Todas as prioridades</option><option>CRITICAL</option><option>HIGH</option><option>NORMAL</option><option>LOW</option></select><button>Filtrar</button></form><div id="ticket-list" class="support-list"></div></section>
 <section id="sla" class="support-panel"><div class="panel-head"><h2>Políticas de SLA</h2><button data-open="sla-form">Nova política</button></div><div id="sla-list" class="support-list"></div></section>
 <section id="articles" class="support-panel"><div class="panel-head"><div><h2>Central de Ajuda</h2><p>Somente artigos publicados aparecem ao usuário final.</p></div><button data-open="article-form">Novo artigo</button></div><form class="filters" id="article-filters"><input name="search" maxlength="120" placeholder="Pesquisar na base de conhecimento"/><input name="module" maxlength="80" placeholder="Módulo"/><button>Pesquisar</button></form><div id="article-list" class="card-grid"></div></section>
 <section id="implementations" class="support-panel"><div class="panel-head"><h2>Implantação assistida</h2><button data-open="implementation-form">Novo projeto</button></div><div id="implementation-list" class="support-list"></div></section>
 <section id="trainings" class="support-panel"><div class="panel-head"><h2>Trilhas e adoção</h2><button data-open="training-form">Nova trilha</button></div><div id="training-list" class="card-grid"></div></section>
 <section id="feedback" class="support-panel"><div class="panel-head"><h2>Satisfação do cliente</h2><button data-open="feedback-form">Enviar feedback</button></div><div id="feedback-list" class="support-list"></div></section>
 <section id="backlog" class="support-panel"><div class="panel-head"><h2>Backlog interno</h2><button data-open="backlog-form">Nova melhoria</button></div><p class="privacy-note">Área interna: indisponível para perfis externos.</p><div id="backlog-list" class="support-list"></div></section>
 <section id="releases" class="support-panel"><div class="panel-head"><h2>Comunicados e releases</h2><button data-open="release-form">Nova release note</button></div><div id="release-list" class="card-grid"></div></section>
</section>
<div class="support-modal" id="support-modal" hidden><form id="dynamic-form"><button type="button" class="modal-close" aria-label="Fechar">×</button><h2 id="form-title"></h2><div id="form-fields"></div><button class="primary-button" type="submit">Salvar</button><span class="form-message" role="alert"></span></form></div>
@section Scripts { <script src="~/js/support.js" asp-append-version="true" defer></script> }
