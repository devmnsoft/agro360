@page "/sustentabilidade"
@model Agro360.Web.Pages.Sustainability.IndexModel
@{ ViewData["Title"]="Sustentabilidade e ESG"; }
<link rel="stylesheet" href="~/css/sustainability.css" asp-append-version="true" />
<section class="sus-shell">
<header class="sus-hero"><div><span class="sus-kicker">Governança ambiental · dados auditáveis</span><h1>Sustentabilidade e ESG</h1><p>Conformidade da origem, indicadores, recursos, emissões e ações em uma visão executiva real.</p></div><button id="sus-refresh" type="button">Atualizar dados</button></header>
<nav class="sus-nav" aria-label="Módulos ESG"><button class="active" data-panel="dashboard">Dashboard</button><button data-panel="compliance">Conformidade ambiental</button><button data-panel="documents">Documentos</button><button data-panel="indicators">Indicadores e medições</button><button data-panel="emissions">Emissões</button><button data-panel="resources">Água, energia e resíduos</button><button data-panel="suppliers">Fornecedores</button><button data-panel="lots">Rastreabilidade</button><button data-panel="carbon">Projetos de carbono</button><button data-panel="audits">Auditorias</button><button data-panel="actions">Planos de ação</button><button data-panel="reports">Relatórios</button></nav>
<div class="sus-toolbar"><label>Busca <input id="sus-search" type="search" placeholder="Propriedade, produtor ou status" autocomplete="off" /></label><label>Status <select id="sus-status"><option value="">Todos</option><option value="REGULAR">Regular</option><option value="PENDING">Com pendência</option><option value="BLOCKED">Bloqueado</option><option value="EXPIRED">Vencido</option></select></label><button id="sus-new" type="button">Nova conformidade</button></div>
<p id="sus-state" role="status">Carregando dados ambientais…</p><main id="sus-content" aria-live="polite"></main>
</section>
<dialog id="sus-dialog"><form id="sus-form"><header><h2>Nova conformidade ambiental</h2><button type="button" data-close aria-label="Fechar">×</button></header><p class="sus-help">Selecione uma propriedade cadastrada. Nenhum ID técnico é solicitado.</p><label>Propriedade<select name="farmId" id="sus-farm" required><option value="">Selecione…</option></select></label><label>Produtor<input name="producerName" maxlength="200" required /></label><div class="sus-grid"><label>Área total (ha)<input name="totalArea" type="number" min="0.000001" step="0.000001" required /></label><label>Área produtiva (ha)<input name="productiveArea" type="number" min="0" step="0.000001" required /></label><label>Preservação (ha)<input name="preservationArea" type="number" min="0" step="0.000001" value="0" required /></label><label>APP (ha)<input name="appArea" type="number" min="0" step="0.000001" value="0" required /></label><label>Reserva legal (ha)<input name="legalReserveArea" type="number" min="0" step="0.000001" value="0" required /></label></div><label>CAR<input name="carNumber" maxlength="80" /></label><label>Situação<select name="status"><option value="UNDER_REVIEW">Em análise</option><option value="REGULAR">Regular</option><option value="PENDING">Com pendência</option><option value="BLOCKED">Bloqueado</option></select></label><label>Risco<select name="risk"><option value="NOT_ASSESSED">Não avaliado</option><option value="LOW">Baixo</option><option value="MEDIUM">Médio</option><option value="HIGH">Alto</option><option value="CRITICAL">Crítico</option></select></label><p id="sus-form-error" role="alert"></p><footer><button type="button" data-close>Cancelar</button><button type="submit">Salvar registro</button></footer></form></dialog>
@section Scripts { <script src="~/js/sustainability.js" asp-append-version="true" defer></script> }
