@page
@model Agro360.Web.Pages.Work.IndexModel
@{ ViewData["Title"]="Central de Operações"; }
<link rel="stylesheet" href="~/css/work.css" />
<main class="work-shell" data-api="@Model.ApiBaseUrl">
 <header class="work-hero"><div><span class="eyebrow">INÍCIO · CENTRAL DE OPERAÇÕES</span><h1>O que precisa da sua atenção</h1><p>Pendências derivadas das operações reais, filtradas pelo seu acesso e organizadas por prioridade e prazo.</p></div><button id="refresh" class="primary">Atualizar central</button></header>
 <details class="screen-help"><summary>Como usar</summary><div><p><strong>Para que serve:</strong> reunir aprovações, compras, inspeções, expedições, manutenções e obrigações que ainda exigem ação.</p><p><strong>Antes de começar:</strong> sua organização deve ter módulos contratados, cadastros básicos e permissões de leitura. Use os filtros, abra o registro original e execute somente a ação indicada. Visualizar ou atribuir não resolve a causa; a pendência sai da central apenas quando a operação de origem for regularizada.</p><p><strong>Correção e permissões:</strong> corrija no módulo de origem. Ações de gravação exigem <code>work.write</code> e a permissão específica do módulo; decisões permanecem no histórico persistido.</p></div></details>
 <section id="metrics" class="metrics" aria-live="polite"><span class="loading">Carregando indicadores…</span></section>
 <nav class="tabs" aria-label="Centrais"><button data-tab="center" class="active">Pendências operacionais</button><button data-tab="tasks">Minhas tarefas</button><button data-tab="alerts">SLA e alertas</button><button data-tab="workflows">Aprovações</button><button data-tab="notifications">Notificações</button><button data-tab="calendar">Agenda</button><button data-tab="rules">Automações</button><button data-tab="outbox">Outbox</button></nav>
 <section class="toolbar" aria-label="Filtros"><label><span>Buscar</span><input id="search" type="search" placeholder="Título ou motivo"/></label><label><span>Módulo</span><select id="module"><option value="">Todos</option><option>PURCHASING</option><option>INVENTORY</option><option>LOGISTICS</option><option>MAINTENANCE</option><option>FINANCE</option></select></label><label><span>Interação</span><select id="status"><option value="">Todas</option><option value="NEW">Nova</option><option value="VIEWED">Visualizada</option><option value="ASSIGNED">Atribuída</option></select></label><button id="newTask" class="primary">Nova tarefa</button><button id="evaluate">Avaliar regras</button></section>
 <section id="content" class="panel"><span class="loading">Carregando dados reais…</span></section>
 <dialog id="taskDialog"><form id="taskForm"><header><h2>Nova tarefa</h2><button type="button" data-close aria-label="Fechar">×</button></header><label>Título<input name="title" maxlength="180" required /></label><label>Descrição<textarea name="description" required></textarea></label><label>Responsável<select name="responsibleId" required><option value="">Selecione uma pessoa ativa</option></select></label><div class="grid"><label>Prioridade<select name="priority" required><option>LOW</option><option selected>MEDIUM</option><option>HIGH</option><option>CRITICAL</option></select></label><label>Prazo<input name="dueAt" type="datetime-local" required/></label></div><label>Módulo<select name="module" required><option>TASKS</option><option>INVENTORY</option><option>FINANCE</option><option>COMMERCIAL</option><option>LOGISTICS</option><option>COMPLIANCE</option><option>AGRICULTURE</option><option>LIVESTOCK</option></select></label><p class="form-error" role="alert"></p><footer><button type="button" data-close>Cancelar</button><button class="primary">Criar tarefa</button></footer></form></dialog>
 <div id="toast" role="status"></div>
</main><script src="~/js/work.js"></script>
