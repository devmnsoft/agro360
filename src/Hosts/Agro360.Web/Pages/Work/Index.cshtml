@page
@model Agro360.Web.Pages.Work.IndexModel
@{ ViewData["Title"]="Central de Operações"; }
<link rel="stylesheet" href="~/css/work.css" />
<main class="work-shell" data-api="@Model.ApiBaseUrl">
 <header class="work-hero"><div><span class="eyebrow" data-i18n-ag="wk.heroEyebrow">INÍCIO · CENTRAL DE OPERAÇÕES</span><h1 data-i18n-ag="wk.heroTitle">O que precisa da sua atenção</h1><p data-i18n-ag="wk.heroSubtitle">Pendências derivadas das operações reais, filtradas pelo seu acesso e organizadas por prioridade e prazo.</p></div><button id="refresh" class="primary" data-i18n-ag="wk.refresh">Atualizar central</button></header>
 <details class="screen-help"><summary data-i18n-ag="wk.helpTitle">Como funciona esta tela</summary><div><p><strong data-i18n-ag="wk.help.purposeLbl">Para que serve:</strong><span data-i18n-ag="wk.help.purpose"> reunir aprovações, compras, divergências, inspeções, custos, fechamentos disponíveis, tarefas e demais obrigações que ainda exigem ação.</span></p><p><strong data-i18n-ag="wk.help.beforeLbl">Antes de começar:</strong><span data-i18n-ag="wk.help.before"> sua organização deve ter módulos contratados, cadastros básicos e permissões de leitura. Use os filtros, abra o registro original e execute somente a ação indicada. Visualizar ou atribuir não resolve a causa; a pendência sai da central apenas quando a operação de origem for regularizada.</span></p><p><strong data-i18n-ag="wk.help.fixLbl">Correção e permissões:</strong><span data-i18n-ag="wk.help.fix"> corrija no módulo de origem. Ações de gravação exigem <code>work.write</code> e a permissão específica do módulo; decisões permanecem no histórico persistido.</span></p></div></details>
 <section id="metrics" class="metrics" aria-live="polite"><span class="loading" data-i18n-ag="wk.metricsLoading">Carregando indicadores…</span></section>
 <nav class="tabs" aria-label="Centrais"><button data-tab="center" class="active" data-i18n-ag="wk.tab.center">Pendências operacionais</button><button data-tab="my-day" data-i18n-ag="wk.tab.myDay">Meu Dia</button><button data-tab="tasks" data-i18n-ag="wk.tab.tasks">Minhas tarefas</button><button data-tab="alerts" data-i18n-ag="wk.tab.sla">SLA e alertas</button><button data-tab="workflows" data-i18n-ag="wk.tab.approvals">Aprovações</button><button data-tab="notifications" data-i18n-ag="wk.tab.notifications">Notificações</button><button data-tab="calendar" data-i18n-ag="wk.tab.calendar">Agenda</button><button data-tab="rules" data-i18n-ag="wk.tab.automations">Automações</button><button data-tab="outbox" data-i18n-ag="wk.tab.outbox">Outbox</button></nav>
 <section class="toolbar" aria-label="Filtros"><label><span data-i18n-ag="wk.filterSearch">Buscar</span><input id="search" type="search" data-i18n-ag-ph="wk.phSearch" placeholder="Título ou motivo"/></label><label><span data-i18n-ag="wk.filterModule">Módulo</span><select id="module"><option value="" data-i18n-ag="wk.allModules">Todos</option><option>PURCHASING</option><option>INVENTORY</option><option>COMPLIANCE</option><option>LOGISTICS</option><option>MAINTENANCE</option><option>FINANCE</option><option>AGRICULTURE</option><option>TASKS</option></select></label><label><span data-i18n-ag="wk.filterPriority">Prioridade</span><select id="priority"><option value="" data-i18n-ag="wk.int.all">Todas</option><option value="CRITICAL" data-i18n-ag="wk.priority.critical">Crítica</option><option value="HIGH" data-i18n-ag="wk.priority.high">Alta</option><option value="MEDIUM" data-i18n-ag="wk.priority.medium">Média</option><option value="LOW" data-i18n-ag="wk.priority.low">Baixa</option></select></label><label><span data-i18n-ag="wk.fromDate">Período inicial</span><input id="startDate" type="date" /></label><label><span data-i18n-ag="wk.toDate">Período final</span><input id="endDate" type="date" /></label><label class="check-filter"><input id="overdue" type="checkbox" /><span data-i18n-ag="wk.onlyOverdue"> Somente vencidas</span></label><label class="check-filter"><input id="unassigned" type="checkbox" /><span data-i18n-ag="wk.onlyUnassigned"> Sem responsável</span></label><label><span data-i18n-ag="wk.view">Visão</span><select id="scope"><option value="ALL" data-i18n-ag="wk.view.all">Todas as permitidas</option><option value="MINE" data-i18n-ag="wk.view.mine">Minhas pendências</option><option value="TEAM" data-i18n-ag="wk.view.team">Equipe</option></select></label><label><span data-i18n-ag="wk.interaction">Interação</span><select id="status"><option value="" data-i18n-ag="wk.int.all">Todas</option><option value="NEW" data-i18n-ag="wk.int.new">Nova</option><option value="VIEWED" data-i18n-ag="wk.int.viewed">Visualizada</option><option value="ASSIGNED" data-i18n-ag="wk.int.assigned">Atribuída</option></select></label><button id="clearFilters" type="button"><span data-i18n-ag="wk.clearFilters">Limpar filtros </span><span id="filterCount">0</span></button><button id="newTask" class="primary" data-i18n-ag="wk.newTask">Nova tarefa</button><button id="evaluate" data-i18n-ag="wk.evaluateRules">Avaliar regras</button></section>
 <section id="content" class="panel"><span class="loading" data-i18n-ag="wk.contentLoading">Carregando dados reais…</span></section>
 <dialog id="taskDialog" aria-labelledby="taskDialogTitle"><form id="taskForm"><header><h2 id="taskDialogTitle" data-i18n-ag="wk.newTask">Nova tarefa</h2><button type="button" data-close data-i18n-ag-aria="wk.closeAria" aria-label="Fechar">×</button></header><label><span data-i18n-ag="wk.task.nameLabel">Título</span><input name="title" maxlength="180" required /></label><label><span data-i18n-ag="wk.description">Descrição</span><textarea name="description" required></textarea></label><label><span data-i18n-ag="wk.task.responsible">Responsável</span><select name="responsibleId" required><option value="" data-i18n-ag="wk.pickActivePerson">Selecione uma pessoa ativa</option></select></label><div class="grid"><label><span data-i18n-ag="wk.filterPriority">Prioridade</span><select name="priority" required><option>LOW</option><option selected>MEDIUM</option><option>HIGH</option><option>CRITICAL</option></select></label><label><span data-i18n-ag="wk.dueDate">Prazo</span><input name="dueAt" type="datetime-local" required/></label></div><label><span data-i18n-ag="wk.module">Módulo</span><select name="module" required><option>TASKS</option><option>INVENTORY</option><option>FINANCE</option><option>COMMERCIAL</option><option>LOGISTICS</option><option>COMPLIANCE</option><option>AGRICULTURE</option><option>LIVESTOCK</option></select></label><p class="form-error" role="alert"></p><footer><button type="button" data-close data-i18n-ag="ag.cancel">Cancelar</button><button class="primary" data-i18n-ag="wk.task.create">Criar tarefa</button></footer></form></dialog>
 <dialog id="assignmentDialog" aria-labelledby="assignmentTitle"><form id="assignmentForm"><header><div><span class="eyebrow" data-i18n-ag="wk.assignment.eyebrow">ACOMPANHAMENTO</span><h2 id="assignmentTitle" data-i18n-ag="wk.assignment.title">Atribuir pendência</h2></div><button type="button" data-assignment-close data-i18n-ag-aria="wk.closeAria" aria-label="Fechar">×</button></header><p id="assignmentSummary"></p><p><strong data-i18n-ag="wk.currentResponsible">Responsável atual:</strong> <span id="currentResponsible"></span></p><label><span data-i18n-ag="wk.assigneeSearch">Pesquisar pessoa elegível</span><input id="assigneeSearch" type="search" autocomplete="off" data-i18n-ag-ph="wk.phAssignee" placeholder="Nome ou e-mail funcional" /></label><label><span data-i18n-ag="wk.assigneeLabel">Responsável pelo acompanhamento</span><select name="responsibleId" id="assignee" size="5" aria-describedby="assigneeHelp"></select><small id="assigneeHelp" data-i18n-ag="wk.assigneeHelp">A atribuição não concede permissões nem altera o aprovador formal.</small></label><label><span data-i18n-ag="wk.assignmentReason">Motivo da atribuição ou transferência</span><textarea name="reason" maxlength="1000" data-i18n-ag-ph="wk.phAssignmentReason" placeholder="Ex.: redistribuição da equipe"></textarea></label><input name="expectedVersion" type="hidden"/><p class="form-error" role="alert"></p><footer><button type="button" id="unassign" data-i18n-ag="wk.unassign">Retirar atribuição</button><button type="button" data-assignment-close data-i18n-ag="ag.cancel">Cancelar</button><button class="primary" data-i18n-ag="wk.confirmAssignment">Confirmar acompanhamento</button></footer></form></dialog>
 <div id="toast" role="status" aria-live="polite"></div>
</main><script src="~/js/work.js"></script>
